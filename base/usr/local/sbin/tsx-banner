#!/bin/sh
# tsx-banner: write the login banner of the console profile: /etc/issue (shown
# above the login prompt on the panel screen and on the serial console) and
# /etc/motd (shown after a login). Both have the Tux and "TSX - LINUX" art of
# /etc/tsx/banner.art, then the model, the IP address and "SSH is on".
#
#   tsx-banner        write both files. When /etc/issue changed, end the idle
#                     getty processes. init starts them again, so the login
#                     prompt shows the new address.
#
#   tsx-banner watch  run "check" when the root password or the authorized
#                     keys change, without end. inotifyd watches the folders
#                     of the two files (passwd replaces /etc/shadow by a
#                     rename), so the banner follows a passwd or a new key at
#                     once. A slow timer (every 5 min) also runs "check": it
#                     covers a change that the watch cannot see, for example
#                     with no inotifyd. The watch starts no process while
#                     nothing changes.
#   tsx-banner check  write both files only when the root password or the
#                     authorized keys changed since the last run.
#
# /etc/local.d/tsx-banner.start runs it at boot, starts "watch", and runs it
# again when the DHCP lease gives an address. /etc/udhcpc/post-bound/tsx-banner
# runs it at each new lease.
# The model comes from /run/tsx/model, which /etc/init.d/tsx-hostname writes.
# Test hooks: TSX_BANNER_ART TSX_ISSUE_FILE TSX_MOTD_FILE TSX_RUN TSX_IP
# (an empty value means: no address) TSX_ROOTPW_BIN TSX_PKILL TSX_NO_RESPAWN=1
# TSX_SHADOW_FILE TSX_AUTH_KEYS_FILE TSX_WATCH_SEC (the slow timer, 300)
# TSX_INOTIFYD (the inotifyd command).
set -u
SHADOW=${TSX_SHADOW_FILE:-/etc/shadow}
KEYS=${TSX_AUTH_KEYS_FILE:-/root/.ssh/authorized_keys}
ART=${TSX_BANNER_ART:-/etc/tsx/banner.art}
ISSUE=${TSX_ISSUE_FILE:-/etc/issue}
MOTD=${TSX_MOTD_FILE:-/etc/motd}
RUN=${TSX_RUN:-/run/tsx}

# the files that decide which root password case the banner shows
stamp() { stat -c '%Y:%s' "$SHADOW" "$KEYS" 2>/dev/null | tr '\n' ' '; }

# The folders that "watch" gives to inotifyd. The folder of the keys can be
# missing (no key yet): then its parent, and the event of the new folder
# starts the watch again with the folder itself.
watch_args() {
	set -- "${SHADOW%/*}:wymnde"
	if [ -d "${KEYS%/*}" ]; then set -- "$@" "${KEYS%/*}:wymndex"
	else set -- "$@" "${KEYS%/*/*}:ymn"; fi
	echo "$@"
}

mode=${1:-}
if [ "${TSX_BANNER_EVENT:-}" = 1 ]; then
	# inotifyd runs this script for each event in a watched folder:
	# $1 the events, $2 the folder, $3 the file in it. Most events are of
	# other files: they end here, with no other process.
	unset TSX_BANNER_EVENT
	case "$2/${3:-}" in
	"$SHADOW"|"$KEYS") mode=check;;
	"${KEYS%/*}")
		# The folder of the keys is new: end this inotifyd (the parent of
		# this script). "watch" starts it again with the folder.
		kill "$PPID" 2>/dev/null; mode=check;;
	*)
		# The folder of the keys is gone ("x"): start the watch again.
		case "$1" in *x*) kill "$PPID" 2>/dev/null;; esac
		exit 0;;
	esac
fi

case "$mode" in
watch)
	period=${TSX_WATCH_SEC:-300}
	"$0" check
	# The slow timer, in a child shell: one sleep and one check in each
	# period. The waits run in the background with "wait", so a TERM ends
	# them at once (a shell runs a trap only after a foreground command).
	(
		s=; trap 'kill $s 2>/dev/null; exit 0' TERM
		while :; do sleep "$period" & s=$!; wait "$s"; "$0" check; done
	) &
	timer=$! ipid= s=
	trap 'kill $timer $ipid $s 2>/dev/null; exit 0' TERM INT HUP
	# shellcheck disable=SC2086 # the command can have arguments
	set -- ${TSX_INOTIFYD:-inotifyd}
	if ! command -v "$1" >/dev/null 2>&1; then
		wait "$timer"; exit 0
	fi
	while :; do
		# inotifyd runs "$0 EVENTS FOLDER FILE" for each event. It ends when
		# the event of a new or a removed key folder ends it, or when it
		# cannot start (no inotify). Then start it again after a pause and
		# check once for a change in that time.
		# shellcheck disable=SC2046 # the folder list is split on purpose
		TSX_BANNER_EVENT=1 "$@" "$0" $(watch_args) </dev/null >/dev/null 2>&1 &
		ipid=$!
		wait "$ipid"
		ipid=
		sleep 10 & s=$!
		wait "$s"
		s=
		"$0" check
	done;;
check)
	old=; IFS= read -r old 2>/dev/null < "$RUN/banner.stamp"
	[ "$(stamp)" != "$old" ] || exit 0;;
esac
mkdir -p "$RUN" 2>/dev/null; stamp > "$RUN/banner.stamp" 2>/dev/null

model=$(head -n 1 "$RUN/model" 2>/dev/null) || model=
[ -n "$model" ] || model="TSX panel"
if [ -n "${TSX_IP+x}" ]; then ip=$TSX_IP
else ip=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{ print $4; exit }' | cut -d/ -f1); fi

facts() {
	echo "   model:    $model"
	if [ -n "$ip" ]; then
		echo "   address:  $ip"
		echo "   SSH is on: ssh root@$ip"
	else
		echo "   address:  none yet (waiting for DHCP)"
		echo "   SSH is on (port 22)"
	fi
	# which root password case applies (tsx-rootpw note)
	"${TSX_ROOTPW_BIN:-/usr/local/bin/tsx-rootpw}" note 2>/dev/null
}

tmp=$ISSUE.tmp.$$
{
	echo
	# getty reads a backslash and a percent sign in /etc/issue as an escape.
	# Double them, so the art prints as it is.
	sed 's/\\/\\\\/g; s/%/%%/g' "$ART" 2>/dev/null
	echo
	facts | sed 's/\\/\\\\/g; s/%/%%/g'
	echo
} > "$tmp" && chmod 644 "$tmp" || { rm -f "$tmp"; exit 1; }
changed=1; cmp -s "$tmp" "$ISSUE" 2>/dev/null && changed=0
mv "$tmp" "$ISSUE"

tmp=$MOTD.tmp.$$
{
	echo
	cat "$ART" 2>/dev/null
	echo
	facts
	echo
	echo "   config:      tsx-config show        logs: /var/log/messages"
	echo "   screen:      tsx-blank on|off       update: tsx-autoupdate status"
	echo "   env/boot:    /usr/local/sbin/tsx-boot-ok --status"
} > "$tmp" && chmod 644 "$tmp" && mv "$tmp" "$MOTD" || rm -f "$tmp"

# A getty that waits at the prompt shows the old /etc/issue. Ending it makes
# init start a fresh one. A getty that has turned into a login is not touched.
if [ "$changed" = 1 ] && [ "${TSX_NO_RESPAWN:-}" != 1 ]; then "${TSX_PKILL:-pkill}" -x getty 2>/dev/null; fi
exit 0
