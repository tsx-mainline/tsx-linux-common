#!/bin/sh
# tsx-panelctl: the hardware interface of the panel for the layers above the
# base system, first of all the Home Assistant layer (tsx-ha: tsx-esphome,
# tsx-mqtt, the voice satellite). Those programs reach the buttons, the light
# sensor, the LED bar, the volume and the display power only through this
# program. This is the seam between the base and the Home Assistant layer
# (see the "Profiles" docs of the board repository). It has five faces:
#
#   tsx-panelctl                      the daemon: it reads whitelisted commands
#                                     from a FIFO (below)
#   tsx-panelctl send CMD [ARG...]    write one command to the FIFO and return.
#                                     It fails when no daemon reads the FIFO.
#   tsx-panelctl get NAME             print one value: volume (percent), mute
#                                     (on or off, only while the Sendspin
#                                     player owns the volume), lux,
#                                     als-auto (on or off), screen, ledbar
#                                     (R G B, 0 to 100), ledbar-fx (the effect
#                                     of the LED bar, or none), keypad-led,
#                                     last-key, presence, distance (mm),
#                                     usb-power, poe-class, backlight-pct
#                                     (the backlight level in percent, 1 to
#                                     100, see "Backlight in percent"),
#                                     blank-timeout, dim-timeout and
#                                     dim-level (seconds, percent), lights
#                                     (the lights of the panel app: on or
#                                     off, the brightness 1 to 100 and R G B
#                                     0 to 255), update-mode (auto or manual),
#                                     auto-restart (on or off),
#                                     restart-required (yes or no), see
#                                     "Updates" below, and dark-mode (on or
#                                     off, see "Dark mode" below).
#                                     It prints nothing and fails when the panel
#                                     has no value (no sound card, no sensor).
#   tsx-panelctl has NAME             exit 0 when the panel has that hardware:
#                                     ledbar (a LED bar with its application
#                                     is attached now: the tool tsx-ledbar is
#                                     installed, hw.conf does not say
#                                     LEDBAR=no and /run/tsx/ledbar.usb says
#                                     "app". See "LED bar attached" below),
#                                     ledbar-fx (the LED bar firmware
#                                     TSX-LEDBAR, with effects), ledbar-leds
#                                     (TSX-LEDBAR 0.1.3 and later, with the
#                                     16 LEDs and the zone effects), keypad (the
#                                     panel has front keys: a `button` line in
#                                     /etc/tsx/buttons-board.conf or in
#                                     /etc/tsx/buttons.conf), keyleds (the keys
#                                     have LEDs: "leds yes" in buttons.state),
#                                     als, sound, presence, usbpower, poe,
#                                     nfc, panel-app (the panel app owns the
#                                     screen, see "Panel app" below),
#                                     lights (the panel app has lights of
#                                     the panel) or dark-mode (the panel
#                                     runs the kiosk browser). It needs no
#                                     root (see "LED bar firmware" below).
#   tsx-panelctl state                print the controls that the panel has,
#                                     one "NAME VALUE" line each (the setup
#                                     page reads it): owner (kiosk,
#                                     panel-app or none), screen,
#                                     backlight-pct, blank-timeout, and
#                                     where the panel has the part:
#                                     dim-timeout, dim-level, als-auto,
#                                     volume, mute, update-mode, auto-restart,
#                                     dark-mode, ledbar, keypad-led, lights.
#   tsx-panelctl events               print a line when a value changes, until it
#                                     is stopped: "button NAME short|long|hold",
#                                     "lux N", "als-auto on|off", "screen ...",
#                                     "ledbar R G B", "keypad-led N", "presence
#                                     ...", "distance N", "usb-power ...",
#                                     "poe-class N". It first prints the
#                                     present values (not a button).
#
# Volume: ONE volume for the panel. While the Sendspin player runs (its
# volume file $TSX_SENDSPIN_VOLUME_FILE exists, see docs/sendspin.md), the
# volume of the panel IS the player volume of Music Assistant. "get volume"
# and "get mute" read the file (the player writes it at each change, also a
# change from Music Assistant). The commands "volume N" and "mute on|off"
# run "sendspin-cli player-vol N" and "player-mute on|off" on the control
# socket of the player (root may open it). The player applies the value and
# tells Music Assistant. The mixer volume (Master) then stays at the fixed
# level of the board and nothing here changes it. Without the file, "volume
# N" sets the mixer: TSX_VOLUME_CMD of the board file, else Master. That
# panel has no mute. The service tsx-sendspin removes the file when it
# stops, so the mixer is the volume again.
#
# Backlight in percent: the Home Assistant number "Backlight" and the setup
# page give the level in percent of the slider (1 to 100), on every family.
# The percent maps to the level of tsx-idled with the scale of tsx-level.h
# (a square for a range wider than 64 steps): level = min + (max - min) *
# p * p, p = percent / 100. "brightness-pct P" sets that level as the
# absolute override, like "brightness N". "get backlight-pct" maps the level
# of brightness.state back.
#
# Panel app: a panel with the panel app (docs/panel-app.md) has no
# tsx-idled. The app owns the screen and the backlight. "has panel-app" is
# true while the app runs: $TSX_RUN_DIR/panel-app.state names a process that
# exists. Then the daemon sends "blank", "brightness-pct" and "lights" to the
# app: one file per command in $TSX_RUN_DIR/panel-app/control.d. The app reads
# the folder, runs the commands in the order of the file names and removes
# the files. The app writes its values to $TSX_RUN_DIR/panel-app/screen.state
# ("key value" lines, world-readable), and get reads them from there.
# The app can run as the user tsx-panel-app (docs/security.md). Then that user
# owns control.d, and root owns the folder above it. The daemon writes each
# command to a temporary file in $TSX_RUN_DIR (root only) and renames it into
# control.d. A rename never follows a link that the app put there, and the
# app cannot replace control.d itself.
# The app asks for root actions with the commands of the FIFO: reboot,
# setup, blank-timeout, dim-timeout, dim-level, update-install, update-mode,
# auto-restart and layout-install. The
# command "layout-install ID" runs tsx-layout-check --install on the fixed
# file $TSX_RUN_DIR/panel-app/app/layout.ha (the app wrote it) with the
# target /var/lib/tsx/panel-layout.json. The result goes to
# $TSX_RUN_DIR/panel-app/layout.result (root owns it, mode 644): "id ID",
# "rc N" and the first lines of the output of the check.
#
# Updates: tsx-autoupdate (docs/autoupdate.md) owns the update state. "get
# update-mode" and "get auto-restart" print the values that it uses (it reads
# /etc/tsx/autoupdate.conf and the override /run/tsx/autoupdate.conf that
# tsx-config apply writes). "get restart-required" reads $TSX_RUN_DIR/update.state.
# The commands "update-mode auto|manual" and "auto-restart on|off" save
# UPDATE_MODE and UPDATE_AUTO_RESTART in panel.conf (tsx-config set and apply).
# "update-install" runs "tsx-autoupdate now": it installs at once, in both
# modes, and restarts the panel when the install needs it and auto-restart is
# on. With nothing to install and a restart required, it restarts the panel.
#
# Dark mode: the browser kiosk shows pages in the dark color scheme (panel.conf
# KIOSK_DARK, see tsx-config). "get dark-mode" prints on or off: the value
# of $R/kiosk.conf (tsx-config apply), else KIOSK_DARK of /etc/kiosk.conf, else
# off. It fails on a panel with no kiosk (no /etc/kiosk.conf) and while the
# panel app owns the screen. The command "dark-mode on|off" saves KIOSK_DARK
# in panel.conf (tsx-config set and apply). It restarts the kiosk when the
# value changes, because the browser reads the flags at its start.
#
# LED bar attached: tsx-ledbard (root) writes /run/tsx/ledbar.usb. It holds
# one word: "app" (the bar runs its application) or "bootloader" (the bar is
# in recovery and has no light). The file does not exist while no bar is
# attached, while the service is stopped and for a bar that has been gone for
# a few seconds. It is the one place that tells whether a bar is attached.
# "has ledbar" is true only with "app". Programs that show the LED bar to
# Home Assistant (tsx-esphome, the voice satellite, tsx-mqtt) read this file
# and ask "has ledbar" when it changes. LEDBAR=no in hw.conf is the hard off.
#
# LED bar firmware: "has ledbar-fx" and "has ledbar-leds" read
# /run/tsx/ledbar.fw. The service tsx-ledbar (tsx-ledbard, root) writes it
# after each plug-in of the bar, with the lines of "tsx-ledbar fw" (firmware,
# effects, leds) and "caps WORDS". Only root can open the USB device of the
# bar, and the CAPS query of "tsx-ledbar fw" needs it. So the voice satellite
# (user kiosk) cannot ask the bar itself. Without the file (the first check of
# the bar is not done yet, the service is stopped), the script asks
# "tsx-ledbar fw". That works fully only for root.
#
# The files that hold these values are /run/tsx/*.state and
# /run/tsx-idled.state (written by tsx-buttons, tsx-idled and the daemons of
# the board: the light sensor, the LED bar, the distance sensor). A program
# that only needs to read may read them directly. Which hardware exists is
# the business of the board. The commands of a part that the panel lacks fail
# in the CLI of the board, or the has command says no.
#
# The daemon is the ONLY privileged surface of the panel for the
# unprivileged Home Assistant ESPHome plugin (docs/esphome.md). It runs
# as root and reads fixed, whitelisted commands from a FIFO that the group
# "kiosk" can write. It runs them with the existing root-only CLIs
# (tsx-ledbar, tsx-keypad, tsx-kiosk-page, tsx-blank, tsx-config, reboot), or it writes the
# runtime override files that they use. Its second client is the
# quick-settings overlay (tsx-overlay, also user kiosk): brightness-offset,
# brightness-learn-reset (forget the points that the automatic brightness
# learned from manual changes), als, blank, reload-page, setup (the "Setup"
# button, see the "Setup page" docs of the board repository).
#
# WHY THIS EXISTS: the voice satellite (tsx-voice / linux-voice-assistant)
# runs as user kiosk (group kiosk, + audio), not as root. It is an always-on
# process that talks to the network (the ESPHome API port, 6053) and to the
# audio hardware, so it must not also run as root. But every one of these
# actions already needs root on this panel:
# - tsx-blank signals tsx-idled with pkill. Only root or the same UID may
#   signal the process of another user.
# - /run/tsx/brightness and /run/tsx/buttons.ctl are root:root 0600/0755
#   (see rootfs/src/tsx-idled.c, tsx-buttons.c).
# - tsx-config apply refuses to run as non-root.
# So when the own plugin of the voice satellite (rootfs/voice/shim/tsx_lva)
# must act on one of the Home Assistant entities of the panel, it writes one
# line here. It does not run the command itself. tsx-esphome (the standalone
# ESPHome server that runs when VOICE=off) already runs as root, like
# tsx-mqtt, and never needs this. See the module docstring of
# rootfs/voice/shim/tsx_panel/backend.py for the euid check that picks one
# path or the other.
#
# THREAT MODEL: the writer of the FIFO is the "kiosk" group. "kiosk" is also
# the user that Chromium (unsandboxed on this hardware) runs as. So treat
# every line as hostile, not only as malformed. A panel with no group kiosk
# gives the FIFO to the group tsx-panel-app (the panel app as a user that is
# not root), if it exists. TSX_PANELCTL_GROUPS lists the groups in that order. The script matches every
# command below against the EXACT form that tsx_panel/backend.py sends: a
# fixed argument count, numeric args range-checked, enum args compared with
# `=`. It never hands a glob or a string that the caller chose to a root CLI
# as a positional or option argument. It logs anything else (truncated, with
# control characters stripped) and drops it. It never runs it. `read`
# splits the line into fixed fields itself (no unquoted `$line` or `$*`
# that splits the input of the caller again). `set -f` also disables
# pathname expansion as a second layer.
#
# Env overrides for tests: TSX_RUN_DIR, TSX_PANELCTL, TSX_LEDBAR, TSX_KEYPAD,
# TSX_BLANK, TSX_ALS_BIN, TSX_CONFIG_BIN, TSX_REBOOT_BIN, TSX_AMIXER,
# TSX_SOUND_CARD, TSX_UPDATE_BIN, TSX_IDLED_STATE, TSX_BUTTONS_CONF,
# TSX_BUTTONS_BOARD_CONF, TSX_KIOSK_PAGE, TSX_ALS_CONF, TSX_ASOUND_DIR, TSX_BACKLIGHT_DIR,
# TSX_USBPOWER_BIN, TSX_HW_CONF, TSX_NFC_SYS_DIR,
# TSX_VOLUME_CMD, TSX_SENDSPIN_VOLUME_FILE (/run/sendspin-cli/volume),
# TSX_SENDSPIN_SOCKET (/run/sendspin-cli/control.sock), TSX_SENDSPIN_BIN
# (sendspin-cli), TSX_EVENTS_POLL (seconds
# between two reads of `events`), TSX_EVENTS_MAX (stop `events` after that many
# lines), TSX_PANELCTL_ONESHOT=1 (handle exactly one line, then exit. Tests only),
# TSX_LEDBAR_FW (the firmware file of the LED bar, $TSX_RUN_DIR/ledbar.fw),
# TSX_LEDBAR_USB (the attached file of the LED bar, $TSX_RUN_DIR/ledbar.usb),
# TSX_KIOSK_CONF (/etc/kiosk.conf), TSX_PANEL_APP_STATE
# ($TSX_RUN_DIR/panel-app.state), TSX_PANEL_APP_RUN ($TSX_RUN_DIR/panel-app),
# TSX_PROC_DIR (/proc), TSX_PANELCTL_GROUPS ("kiosk tsx-panel-app"),
# TSX_LAYOUT_CHECK_BIN, TSX_PANEL_LAYOUT_FILE.
set -u -f
R=${TSX_RUN_DIR:-/run/tsx}
FIFO=${TSX_PANELCTL:-$R/panelctl}
LEDBAR_FW=${TSX_LEDBAR_FW:-$R/ledbar.fw}
LEDBAR_USB=${TSX_LEDBAR_USB:-$R/ledbar.usb}
LEDBAR=${TSX_LEDBAR:-tsx-ledbar}
KEYPAD=${TSX_KEYPAD:-tsx-keypad}
KIOSK_PAGE=${TSX_KIOSK_PAGE:-tsx-kiosk-page}
BLANK=${TSX_BLANK:-tsx-blank}
ALS=${TSX_ALS_BIN:-tsx-als}
CONFIG=${TSX_CONFIG_BIN:-tsx-config}
REBOOT_BIN=${TSX_REBOOT_BIN:-reboot}
AMIXER=${TSX_AMIXER:-amixer}
USBPOWER_BIN=${TSX_USBPOWER_BIN:-tsx-usbpower}
HW_CONF=${TSX_HW_CONF:-$R/hw.conf}
NFCSYS=${TSX_NFC_SYS_DIR:-/sys/class/nfc}
. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
CARD=$TSX_SOUND_CARD
# TSX_VOLUME_CMD of the board file: a command that prints the volume in
# percent, and sets it with one argument (for example "tsx-audio volume").
# Without it, the volume is the Master control of the sound card.
VOLUME_CMD=${TSX_VOLUME_CMD:-}
# The Sendspin player (see "Volume" at the top).
SS_VOLFILE=${TSX_SENDSPIN_VOLUME_FILE:-/run/sendspin-cli/volume}
SS_SOCK=${TSX_SENDSPIN_SOCKET:-/run/sendspin-cli/control.sock}
SS_BIN=${TSX_SENDSPIN_BIN:-}
if [ -z "$SS_BIN" ]; then
	SS_BIN=/usr/bin/sendspin-cli
	[ -x "$SS_BIN" ] || SS_BIN=/usr/local/bin/sendspin-cli
fi
UPDATE_BIN=${TSX_UPDATE_BIN:-tsx-autoupdate}
RC_SERVICE=${TSX_RC_SERVICE:-rc-service}
ONESHOT=${TSX_PANELCTL_ONESHOT:-0}
IDLED_STATE=${TSX_IDLED_STATE:-/run/tsx-idled.state}
BUTTONS_CONF=${TSX_BUTTONS_CONF:-/etc/tsx/buttons.conf}
BUTTONS_BOARD_CONF=${TSX_BUTTONS_BOARD_CONF:-/etc/tsx/buttons-board.conf}
ALS_CONF=${TSX_ALS_CONF:-/etc/tsx/als.conf}
ASOUND=${TSX_ASOUND_DIR:-/proc/asound}
BL_DIR=${TSX_BACKLIGHT_DIR:-/sys/class/backlight}
KIOSK_CONF=${TSX_KIOSK_CONF:-/etc/kiosk.conf}
PA_STATE=${TSX_PANEL_APP_STATE:-$R/panel-app.state}
PA_RUN=${TSX_PANEL_APP_RUN:-$R/panel-app}
PROC=${TSX_PROC_DIR:-/proc}
LAYOUT_CHECK=${TSX_LAYOUT_CHECK_BIN:-tsx-layout-check}
LAYOUT_FILE=${TSX_PANEL_LAYOUT_FILE:-/var/lib/tsx/panel-layout.json}
PA_SEQ=0
# PA_START: the seconds at the first pa_send of this process (file names of
# control.d sort by it). Only the daemon sends, so a client (get, has, state)
# starts no date process.
PA_START=

log() { echo "$(date '+%F %T') tsx-panelctl: $*"; }

# Strip control characters and cap the length before a hostile or malformed
# line reaches a log line. The script never runs such a line, it only prints it.
safe() { printf '%s' "$1" | tr -d '\000-\010\013-\037\177' | cut -c1-120; }

# Digits only (no sign, no leading '-'). The length cap comes BEFORE the
# numeric compare below, so a very long digit string cannot upset `[ -ge/-le ]`.
is_uint() {
	case "$1" in ''|*[!0-9]*) return 1;; esac
	[ "${#1}" -le 6 ]
}
in_range() { is_uint "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }

# The top level of the backlight. tsx-idled reports it ("max M" in
# brightness.state: BACKLIGHT_MAX cut to the max_brightness of the device).
# Before tsx-idled has written it, the max_brightness of the first backlight
# device. 31 is the last resort.
bl_max() {
	m=$(sed -n 's/^max //p' "$R/brightness.state" 2>/dev/null | head -n 1)
	is_uint "$m" && [ "$m" -gt 0 ] && { echo "$m"; return; }
	set +f
	for d in "$BL_DIR"/*; do
		m=$(cat "$d/max_brightness" 2>/dev/null)
		break
	done
	set -f
	is_uint "$m" && [ "$m" -gt 0 ] && { echo "$m"; return; }
	echo 31
}

# The floor of a lit level ("min M" in brightness.state, from tsx-idled).
# Before tsx-idled has written it, 1.
bl_min() {
	m=$(sed -n 's/^min //p' "$R/brightness.state" 2>/dev/null | head -n 1)
	is_uint "$m" && [ "$m" -gt 0 ] && { echo "$m"; return; }
	echo 1
}

# pct_to_level P: the backlight level of the slider percent P (1 to 100), with
# the scale of tsx-level.h (see "Backlight in percent" at the top)
pct_to_level() {
	awk -v p="$1" -v lo="$(bl_min)" -v hi="$(bl_max)" 'BEGIN {
		if (hi <= lo) { print hi; exit }
		f = p / 100
		if (f <= 0) { print lo; exit }
		if (f >= 1) { print hi; exit }
		if (hi - lo > 64) f = f * f
		printf "%d\n", lo + int(f * (hi - lo) + 0.5) }'
}
# level_to_pct LEVEL: the slider percent (1 to 100) of a backlight level
level_to_pct() {
	awk -v l="$1" -v lo="$(bl_min)" -v hi="$(bl_max)" 'BEGIN {
		if (hi <= lo || l >= hi) { print 100; exit }
		if (l <= lo) { print 1; exit }
		f = (l - lo) / (hi - lo)
		if (hi - lo > 64) f = sqrt(f)
		p = int(f * 100 + 0.5); if (p < 1) p = 1
		print p }'
}

# panel_app_up: the panel app runs (its state file names a process that exists)
panel_app_up() {
	pa_pid=$(sed -n 's/^pid //p' "$PA_STATE" 2>/dev/null | head -n 1)
	case "$pa_pid" in ''|*[!0-9]*) return 1;; esac
	[ "${#pa_pid}" -le 9 ] && [ -d "$PROC/$pa_pid" ]
}

# pa_send LINE: one command for the panel app (see "Panel app" at the top).
# The temporary file is in $R (root only). Only the rename goes into
# control.d, which the app can own.
pa_send() {
	[ -d "$PA_RUN/control.d" ] || mkdir -p "$PA_RUN/control.d" || return 1
	if [ -z "$PA_START" ]; then
		PA_START=$(date +%s 2>/dev/null)
		case "$PA_START" in ''|*[!0-9]*) PA_START=0;; esac
	fi
	PA_SEQ=$((PA_SEQ + 1))
	pa_name=$(printf '%010d.%06d' "$PA_START" "$PA_SEQ")
	pa_tmp="$R/.panel-app-cmd.$$"
	rm -f "$pa_tmp"
	(umask 022; printf '%s\n' "$1" > "$pa_tmp") && mv -f "$pa_tmp" "$PA_RUN/control.d/$pa_name"
}

# layout_install ID: install the layout that the app wrote (see "Panel app"
# at the top). tsx-layout-check opens the file with O_NOFOLLOW, so a link
# there fails. The result file is written in $R and renamed.
layout_install() {
	li_tmp="$R/.panel-app-layout.$$"
	mkdir -p "$PA_RUN"
	li_out=$("$LAYOUT_CHECK" --install "$PA_RUN/app/layout.ha" "$LAYOUT_FILE" 2>&1)
	li_rc=$?
	rm -f "$li_tmp"
	(umask 022
	 { printf 'id %s\nrc %s\n' "$1" "$li_rc"
	   printf '%s\n' "$li_out" | head -n 20 | cut -c1-200; } > "$li_tmp") && mv -f "$li_tmp" "$PA_RUN/layout.result"
	log "layout-install $1: rc $li_rc"
}

# kiosk_conf_get KEY [FILE]: the last value of KEY in kiosk.conf (or FILE),
# without quotes
kiosk_conf_get() {
	sed -n "s/^$1=//p" "${2:-$KIOSK_CONF}" 2>/dev/null | tail -n 1 | sed "s/[[:space:]]*#.*//; s/^[\"']//; s/[\"']\$//"
}

# kiosk_dark_get: on or off. The override of tsx-config apply wins over
# /etc/kiosk.conf. Any other word counts as off, as in kiosk-session.
kiosk_dark_get() {
	kd=$(kiosk_conf_get KIOSK_DARK "$R/kiosk.conf")
	[ -n "$kd" ] || kd=$(kiosk_conf_get KIOSK_DARK)
	if [ "$kd" = on ]; then echo on; else echo off; fi
}

# kiosk_restart: restart the kiosk service when it runs, in the background
# (the restart takes seconds, and this loop must go on). The new browser
# reads KIOSK_DARK again.
kiosk_restart() {
	run_detached sh -c '"$1" kiosk status >/dev/null 2>&1 && "$1" kiosk restart >/dev/null 2>&1' sh "$RC_SERVICE"
}

reject() { log "rejected: $(safe "$*")"; }

# fx_ok NAME VALUE...: an effect of the LED bar firmware TSX-LEDBAR with
# the right count of plain numbers. tsx-ledbar checks the exact ranges.
# Spectrum may end with the word ring or rows (the layout of the hue circle).
fx_ok() {
	fx_name=$1; shift
	fx_word=
	if [ "$fx_name" = spectrum ] && [ $# -ge 2 ]; then
		eval "fx_word=\${$#}"
		case "$fx_word" in ring|rows) ;; *) fx_word=;; esac
	fi
	fx_num=$#; [ -n "$fx_word" ] && fx_num=$(($# - 1))
	case "$fx_name" in
	off) fx_n=0;;
	fade|breathe) fx_n=4;;
	blink) fx_n=5;;
	rainbow|spectrum) fx_n=1; [ "$fx_num" = 2 ] && fx_n=2;;
	smooth|cap) fx_n=1;;
	chase|fill) fx_n=4;;
	split) fx_n=6;;
	*) return 1;;
	esac
	[ "$fx_num" = "$fx_n" ] || return 1
	fx_i=0
	for fx_v in "$@"; do
		fx_i=$((fx_i + 1))
		[ "$fx_i" -gt "$fx_num" ] && break
		in_range "$fx_v" 0 600000 || return 1
	done
}

# leds_ok SEL: a LED selection of the LED bar firmware, in the exact form
# that tsx_panel/backend.py sends: R1 to R8, L1 to L8, 0 to 15, a range of
# two of them (R1-R4), R, L or ALL. Upper case only.
led_one() {
	case "$1" in [RL][1-8]|[0-9]|1[0-5]) return 0;; esac
	return 1
}
leds_ok() {
	case "$1" in
	ALL|R|L) return 0;;
	*-*) led_one "${1%%-*}" && led_one "${1#*-}";;
	*) led_one "$1";;
	esac
}

# ---- the client side: send, get, has, events -------------------------------
field() {  # field FILE KEY: the rest of the first line "KEY ..."
	[ -r "$1" ] && sed -n "s/^$2 //p" "$1" | head -n 1
}

# hw_get KEY: the value of KEY in hw.conf (the facts of the panel that the
# tsx-hw of the board writes), or nothing when the file or the key is missing
hw_get() { sed -n "s/^$1=//p" "$HW_CONF" 2>/dev/null | tail -n 1; }

# player_volume: the Sendspin player owns the volume (see "Volume" at the top)
player_volume() { [ -r "$SS_VOLFILE" ]; }

# player_field KEY: the value of "KEY = VALUE" in the volume file of the player
player_field() {
	sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$SS_VOLFILE" 2>/dev/null | head -n 1
}

# player_send SUBCOMMAND ARG: one command on the control socket of the player.
# A drag of a slider sends several, so a failure is a log line, not an exit.
player_send() {
	"$SS_BIN" "$1" "$2" --control-socket "$SS_SOCK" >/dev/null 2>&1 ||
		log "$1 $2: sendspin-cli failed (exit $?)"
}

# update_get NAME: a setting of tsx-autoupdate (mode or auto-restart). Nothing
# when the panel has no tsx-autoupdate.
update_get() {
	command -v "$UPDATE_BIN" >/dev/null 2>&1 || return 0
	"$UPDATE_BIN" get "$1" 2>/dev/null | head -n 1
}

# get_value NAME: print the value. Fail with nothing printed when the panel has none.
get_value() {
	v=
	case "$1" in
	volume)
		if player_volume; then
			v=$(player_field volume)
			in_range "$v" 0 100 || v=
		else
			has_hw sound || return 1
			if [ -n "$VOLUME_CMD" ]; then v=$($VOLUME_CMD 2>/dev/null | head -n 1)
			else v=$("$AMIXER" -c "$CARD" sget Master 2>/dev/null | sed -n 's/.*\[\([0-9]\{1,3\}\)%\].*/\1/p' | head -n 1); fi
		fi;;
	mute)
		player_volume || return 1
		case "$(player_field muted)" in true) v=on;; false) v=off;; esac;;
	lux) v=$(field "$R/als.state" report);;
	als-auto) v=$(field "$R/als.state" auto);;
	screen) v=$(head -n 1 "$IDLED_STATE" 2>/dev/null);;
	ledbar) v=$(field "$R/ledbar.state" want);;
	ledbar-fx) v=$(field "$R/ledbar.state" fx);;
	keypad-led) v=$(field "$R/buttons.state" led);;
	last-key) v=$(field "$R/buttons.state" last);;
	presence) v=$(field "$R/presence.state" present);;
	distance) v=$(field "$R/presence.state" distance);;
	usb-power) v=$(field "$R/usb-power.state" power);;
	poe-class) v=$(field "$R/poe.state" class);;
	backlight-pct)
		if panel_app_up; then v=$(field "$PA_RUN/screen.state" backlight)
		else
			# While the screen is blank, a new override (brightness,
			# brightness-pct) waits for the wake: report it. Else the level of
			# tsx-idled, else the level of the lit screen.
			l=
			case "$(head -n 1 "$IDLED_STATE" 2>/dev/null)" in blank*) l=$(head -n 1 "$R/brightness" 2>/dev/null);; esac
			is_uint "$l" || l=$(field "$R/brightness.state" level)
			is_uint "$l" || { l=$(head -n 1 "$IDLED_STATE" 2>/dev/null); case "$l" in "on "*) l=${l#on };; *) l=;; esac; }
			is_uint "$l" && v=$(level_to_pct "$l")
		fi;;
	blank-timeout)
		if panel_app_up; then v=$(field "$PA_RUN/screen.state" blank-timeout); fi
		[ -n "$v" ] || v=$(head -n 1 "$R/blank-timeout" 2>/dev/null)
		[ -n "$v" ] || v=$(kiosk_conf_get BLANK_TIMEOUT)
		is_uint "$v" || v=300;;
	dim-timeout|dim-level)
		panel_app_up && v=$(field "$PA_RUN/screen.state" "$1");;
	lights)
		panel_app_up && v=$(field "$PA_RUN/screen.state" lights);;
	update-mode) v=$(update_get mode);;
	auto-restart) v=$(update_get auto-restart);;
	restart-required) v=$(field "$R/update.state" restart-required);;
	dark-mode) has_hw dark-mode && v=$(kiosk_dark_get);;
	*) echo "tsx-panelctl: unknown value '$1'" >&2; return 2;;
	esac
	[ -n "$v" ] || return 1
	printf '%s\n' "$v"
}

# ledbar_fw: the firmware of the LED bar as "tsx-ledbar fw" prints it. The
# file of the LED bar service first, else the tool itself (see "LED bar
# firmware" at the top).
ledbar_fw() {
	if [ -r "$LEDBAR_FW" ]; then cat "$LEDBAR_FW"; else "$LEDBAR" fw 2>/dev/null; fi
}

has_hw() {
	case "$1" in
	# the tool is installed, hw.conf does not say LEDBAR=no (the tsx-hw of the
	# board writes it, a missing file or key is not "no") and tsx-ledbard says
	# that a bar with its application is attached now (the file ledbar.usb
	# says "app"). A bar in the bootloader has no light: "bootloader" is no.
	# busybox ash returns 127 from "command -v" when the name is missing
	ledbar) command -v "$LEDBAR" >/dev/null 2>&1 || return 1
		[ "$(hw_get LEDBAR)" != no ] || return 1
		[ "$(head -n 1 "$LEDBAR_USB" 2>/dev/null)" = app ];;
	# the LED bar runs the firmware TSX-LEDBAR, which has effects
	ledbar-fx) ledbar_fw | grep -qx 'effects yes';;
	# the LED bar firmware has the 16 LEDs (TSX-LEDBAR 0.1.3 and later)
	ledbar-leds) ledbar_fw | grep -qx 'leds yes';;
	# a `button` line in the board layer or in buttons.conf (the template has none)
	# (grep gives 2 for a missing file. The answer of has is 0 or 1.)
	keypad) grep -qsE '^[[:space:]]*button[[:space:]]' "$BUTTONS_BOARD_CONF" "$BUTTONS_CONF" && return 0 || return 1;;
	# tsx-buttons writes "leds yes" when the keys have LEDs
	keyleds) [ "$(field "$R/buttons.state" leds)" = yes ];;
	als) [ -r "$ALS_CONF" ] || [ -r "$R/als.state" ];;
	sound) [ -n "$CARD" ] && [ -e "$ASOUND/$CARD" ];;
	presence) [ -r "$R/presence.state" ];;
	usbpower) [ -r "$R/usb-power.state" ];;
	poe) [ -r "$R/poe.state" ];;
	nfc) [ -r "$R/nfc.state" ] || [ -d "$NFCSYS/nfc0" ];;
	panel-app) panel_app_up;;
	lights) panel_app_up && [ -n "$(field "$PA_RUN/screen.state" lights)" ];;
	# the kiosk browser: the file of tsx-kiosk exists, and the panel app has not taken the screen
	dark-mode) [ -r "$KIOSK_CONF" ] && ! panel_app_up;;
	*) echo "tsx-panelctl: unknown hardware '$1'" >&2; return 2;;
	esac
}

# send_line CMD...: one line for the FIFO. A writer waits for the daemon, so a
# missing daemon ends the wait after 3 s.
send_line() {
	[ $# -gt 0 ] || { echo "usage: tsx-panelctl send CMD [ARG...]" >&2; return 2; }
	line="$*"
	case "$line" in
	*[![:print:]]*) echo "tsx-panelctl: control characters in the command" >&2; return 2;;
	esac
	[ "${#line}" -le 200 ] || { echo "tsx-panelctl: command too long" >&2; return 2; }
	[ -p "$FIFO" ] || { echo "tsx-panelctl: no daemon ($FIFO)" >&2; return 1; }
	timeout 3 sh -c 'printf "%s\n" "$1" > "$2"' sh "$line" "$FIFO" || { echo "tsx-panelctl: the daemon does not answer" >&2; return 1; }
}

# cmd_state: the controls that the panel has, one "NAME VALUE" line each
cmd_state() {
	if panel_app_up; then echo "owner panel-app"
	elif [ -r "$IDLED_STATE" ]; then echo "owner kiosk"
	else echo "owner none"; fi
	s=$(head -n 1 "$IDLED_STATE" 2>/dev/null)
	case "$s" in blank*) echo "screen off";; on*) echo "screen on";; esac
	for n in backlight-pct blank-timeout dim-timeout dim-level; do
		v=$(get_value "$n" 2>/dev/null) && echo "$n $v"
	done
	if has_hw als; then v=$(get_value als-auto 2>/dev/null) && echo "als-auto $v"; fi
	if player_volume || has_hw sound; then v=$(get_value volume 2>/dev/null) && echo "volume $v"; fi
	v=$(get_value mute 2>/dev/null) && echo "mute $v"
	if has_hw ledbar; then v=$(get_value ledbar 2>/dev/null) || v="0 0 0"; echo "ledbar $v"; fi
	if has_hw keyleds; then v=$(get_value keypad-led 2>/dev/null) || v=0; echo "keypad-led $v"; fi
	v=$(get_value lights 2>/dev/null) && echo "lights $v"
	for n in update-mode auto-restart dark-mode; do
		v=$(get_value "$n" 2>/dev/null) && echo "$n $v"
	done
	return 0
}

cmd_events() {
	poll=${TSX_EVENTS_POLL:-1}; max=${TSX_EVENTS_MAX:-0}; count=0
	p_key=; first=1
	names="lux als-auto screen presence distance usb-power poe-class ledbar keypad-led"
	for n in $names; do eval "p_$(echo "$n" | tr - _)="; done
	emit() { printf '%s\n' "$*"; count=$((count + 1)); if [ "$max" -gt 0 ] && [ "$count" -ge "$max" ]; then exit 0; fi; }
	while :; do
		for n in $names; do
			v=$(get_value "$n" 2>/dev/null) || v=
			k="p_$(echo "$n" | tr - _)"; eval "o=\$$k"
			[ "$v" = "$o" ] || { eval "$k=\$v"; [ -z "$v" ] || emit "$n $v"; }
		done
		# a key press is an event only after the first read
		v=$(get_value last-key 2>/dev/null) || v=
		if [ "$v" != "$p_key" ]; then
			p_key=$v
			if [ "$first" = 0 ] && [ -n "$v" ]; then
				set -- $v
				case "${1:-}" in ''|none) ;; *) [ $# -ge 2 ] && emit "button $1 $2";; esac
			fi
		fi
		first=0
		sleep "$poll"
	done
}

case "${1:-}" in
send) shift; send_line "$@"; exit $?;;
get) [ $# = 2 ] || { echo "usage: tsx-panelctl get NAME" >&2; exit 2; }; get_value "$2"; exit $?;;
has) [ $# = 2 ] || { echo "usage: tsx-panelctl has NAME" >&2; exit 2; }; has_hw "$2"; exit $?;;
events) cmd_events; exit $?;;
state) [ $# = 1 ] || { echo "usage: tsx-panelctl state" >&2; exit 2; }; cmd_state; exit $?;;
'') ;;
*) sed -n '2,64p' "$0" >&2; exit 2;;
esac

mkdir -p "$R"
if [ ! -p "$FIFO" ]; then rm -f "$FIFO"; mkfifo "$FIFO" || { log "mkfifo $FIFO failed"; exit 1; }; fi
# The writers of the FIFO: the group kiosk, else the group tsx-panel-app (see
# THREAT MODEL at the top). With neither, only root can write.
for g in ${TSX_PANELCTL_GROUPS:-kiosk tsx-panel-app}; do
	chown "root:$g" "$FIFO" 2>/dev/null && break
done
chmod 660 "$FIFO"

# handle CMD A1 A2 A3 A4 REST -- the script always calls it with exactly six
# fields (some empty). REST is anything past the 5th field (extra tokens on
# the line). Every branch below that does not use REST itself requires it to
# be empty. So a caller cannot smuggle extra arguments onto a command that
# looks valid.
# run_detached CMD ARG...: start a command that runs on its own and may take
# long (tsx-autoupdate now). The job runs in the background of a subshell
# that the script waits for and that ends at once. Init adopts the job and
# reaps it. A plain "cmd &" in this loop leaves a zombie, because this
# script never calls wait. setsid (busybox) puts the job in its own session,
# and the job gets no FIFO (fd 3), no input and no terminal output.
run_detached() {
	( setsid "$@" </dev/null >/dev/null 2>&1 3<&- & )
}

handle() {
	cmd=$1 a1=$2 a2=$3 a3=$4 a4=$5 rest=$6
	case "$cmd" in
	ledbar)
		if [ "$a1" = off ] && [ -z "$a2$a3$a4$rest" ]; then
			log "ledbar off"; "$LEDBAR" off
		elif [ "$a1" = on ] && [ -z "$a2$a3$a4$rest" ]; then
			log "ledbar on"; "$LEDBAR" on
		elif [ "$a1" = set ] && in_range "$a2" 0 100 && in_range "$a3" 0 100 && in_range "$a4" 0 100 && [ -z "$rest" ]; then
			log "ledbar set $a2 $a3 $a4"; "$LEDBAR" set "$a2" "$a3" "$a4"
		elif [ "$a1" = fx ] && fx_ok "$a2" $a3 $a4 $rest; then
			# set -f is on: the split of the numbers cannot expand a glob
			log "ledbar fx $a2 $a3 $a4 $rest"; "$LEDBAR" fx "$a2" $a3 $a4 $rest
		elif [ "$a1" = led ] && leds_ok "$a2" && in_range "$a3" 0 100 && in_range "$a4" 0 100 && in_range "$rest" 0 100; then
			log "ledbar led $a2 $a3 $a4 $rest"; "$LEDBAR" led "$a2" "$a3" "$a4" "$rest"
		elif [ "$a1" = side ] && { [ "$a2" = R ] || [ "$a2" = L ]; } && in_range "$a3" 0 100 && in_range "$a4" 0 100 && in_range "$rest" 0 100; then
			log "ledbar side $a2 $a3 $a4 $rest"; "$LEDBAR" side "$a2" "$a3" "$a4" "$rest"
		elif [ "$a1" = clear ] && [ -z "$a2$a3$a4$rest" ]; then
			log "ledbar clear"; "$LEDBAR" clear
		else reject "ledbar $a1 $a2 $a3 $a4 $rest"; fi;;
	usbpower)
		if { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			log "usbpower $a1"; "$USBPOWER_BIN" "$a1"
		else reject "usbpower $a1 $a2 $a3 $a4 $rest"; fi;;
	keypad)
		if [ "$a1" = led ] && [ "$a2" = off ] && [ -z "$a3$a4$rest" ]; then
			log "keypad led off"; "$KEYPAD" led off
		elif [ "$a1" = led ] && [ "$a2" = auto ] && [ -z "$a3$a4$rest" ]; then
			log "keypad led auto"; "$KEYPAD" led auto
		elif [ "$a1" = led ] && in_range "$a2" 1 255 && [ -z "$a3$a4$rest" ]; then
			log "keypad led $a2"; "$KEYPAD" led "$a2"
		elif [ "$a1" = led-blank ] && in_range "$a2" 0 255 && [ -z "$a3$a4$rest" ]; then
			# The screen-off level of the key LEDs. panel.conf stores it
			# (KEY_LED_BLANK), and tsx-config apply hands it to tsx-buttons.
			log "keypad led-blank $a2"; "$CONFIG" set KEY_LED_BLANK "$a2" && "$CONFIG" apply
		else reject "keypad $a1 $a2 $a3 $a4 $rest"; fi;;
	blank)
		# blank on = the screen goes off. With the panel app, the app owns the screen.
		if { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			if panel_app_up; then
				log "blank $a1 (panel app)"; s=on; [ "$a1" = on ] && s=off; pa_send "screen $s"
			else log "blank $a1"; "$BLANK" "$a1"; fi
		else reject "blank $a1 $a2 $a3 $a4 $rest"; fi;;
	brightness-pct)
		# The backlight in percent of the slider (see "Backlight in percent").
		if in_range "$a1" 1 100 && [ -z "$a2$a3$a4$rest" ]; then
			if panel_app_up; then log "brightness-pct $a1 (panel app)"; pa_send "backlight $a1"
			else l=$(pct_to_level "$a1"); log "brightness-pct $a1 (level $l)"; echo "$l" > "$R/brightness"; fi
		else reject "brightness-pct $a1 $a2 $a3 $a4 $rest"; fi;;
	lights)
		# The lights of the panel app: on, off, or "set BRIGHTNESS R G B"
		# (1 to 100, 0 to 255 each).
		if ! panel_app_up; then reject "lights $a1 $a2 $a3 $a4 $rest (no panel app)"
		elif { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			log "lights $a1"; pa_send "lights $a1"
		elif [ "$a1" = set ] && in_range "$a2" 1 100 && in_range "$a3" 0 255 && in_range "$a4" 0 255 && in_range "$rest" 0 255; then
			log "lights set $a2 $a3 $a4 $rest"; pa_send "lights $a2 $a3 $a4 $rest"
		else reject "lights $a1 $a2 $a3 $a4 $rest"; fi;;
	dim-timeout)
		# Seconds before the screen of the panel app dims (0 = never).
		# panel.conf stores it (the config.d plugin of the panel app).
		if in_range "$a1" 0 86400 && [ -z "$a2$a3$a4$rest" ]; then
			log "dim-timeout $a1"; "$CONFIG" set DIM_TIMEOUT "$a1" && "$CONFIG" apply
		else reject "dim-timeout $a1 $a2 $a3 $a4 $rest"; fi;;
	dim-level)
		if in_range "$a1" 1 100 && [ -z "$a2$a3$a4$rest" ]; then
			log "dim-level $a1"; "$CONFIG" set DIM_LEVEL "$a1" && "$CONFIG" apply
		else reject "dim-level $a1 $a2 $a3 $a4 $rest"; fi;;
	als)
		if [ "$a1" = auto ] && { [ "$a2" = on ] || [ "$a2" = off ]; } && [ -z "$a3$a4$rest" ]; then
			log "als auto $a2"; "$ALS" auto "$a2"
		else reject "als $a1 $a2 $a3 $a4 $rest"; fi;;
	brightness)
		if in_range "$a1" "$(bl_min)" "$(bl_max)" && [ -z "$a2$a3$a4$rest" ]; then
			log "brightness $a1"; echo "$a1" > "$R/brightness"
		else reject "brightness $a1 $a2 $a3 $a4 $rest"; fi;;
	backlight)
		# A level for the backlight at once, as the up and down keys give it:
		# the override file for tsx-idled, and the backlight device itself
		# while the screen is lit.
		if in_range "$a1" "$(bl_min)" "$(bl_max)" && [ -z "$a2$a3$a4$rest" ]; then
			log "backlight $a1"; echo "$a1" > "$R/brightness"
			s=; [ -r "$IDLED_STATE" ] && read -r s _ < "$IDLED_STATE"
			if [ "$s" != blank ]; then
				set +f
				for d in "$BL_DIR"/*; do
					[ -w "$d/brightness" ] && echo "$a1" > "$d/brightness"
					break
				done
				set -f
			fi
		else reject "backlight $a1 $a2 $a3 $a4 $rest"; fi;;
	brightness-offset)
		# The local manual setting (the slider of tsx-overlay): signed steps
		# on top of ALS or the schedule. It replaces an absolute override
		# (the offset comes first, so tsx-idled never shows the level without
		# either). The script does not log it, because a slider drag sends
		# one line per step.
		n=${a1#-}
		if [ -z "$a2$a3$a4$rest" ] && in_range "$n" 0 "$(bl_max)" && { [ "$n" = "$a1" ] || [ "-$n" = "$a1" ]; }; then
			# The result must not go below the floor: base + offset >= min.
			b=$(sed -n 's/^base //p' "$R/brightness.state" 2>/dev/null | head -n 1)
			if is_uint "$b" && [ "$((b + a1))" -lt "$(bl_min)" ]; then a1=$(( $(bl_min) - b )); fi
			if [ "$((a1))" = 0 ]; then rm -f "$R/brightness-offset"; else echo "$a1" > "$R/brightness-offset"; fi
			rm -f "$R/brightness"
		else reject "brightness-offset $a1 $a2 $a3 $a4 $rest"; fi;;
	brightness-learn-reset)
		# Forget the learned points: remove the file, and tell the daemon
		# of the light curve (the light service of the board) with a flag file.
		if [ -z "$a1$a2$a3$a4$rest" ]; then
			log "brightness-learn-reset"
			rm -f "${TSX_LEARN_FILE:-/data/tsx/brightness-learn.json}"
			: > "$R/brightness-learn.reset"
		else reject "brightness-learn-reset $a1 $a2 $a3 $a4 $rest"; fi;;
	blank-timeout)
		# Seconds (0 = never). panel.conf stores it, and tsx-idled gets it
		# through /run/tsx/blank-timeout (it watches that file).
		if in_range "$a1" 0 86400 && [ -z "$a2$a3$a4$rest" ]; then
			log "blank-timeout $a1"; "$CONFIG" set BLANK_TIMEOUT "$a1" && "$CONFIG" apply
		else reject "blank-timeout $a1 $a2 $a3 $a4 $rest"; fi;;
	orientation)
		# Screen orientation (panel.conf ORIENTATION). Apply turns the
		# running kiosk (tsx-orientation apply). Fixed names only.
		case "$a1" in
		landscape|portrait|landscape-flipped|portrait-flipped)
			if [ -z "$a2$a3$a4$rest" ]; then
				log "orientation $a1"; "$CONFIG" set ORIENTATION "$a1" && "$CONFIG" apply
			else reject "orientation $a1 (extra args)"; fi;;
		*) reject "orientation $a1 $a2 $a3 $a4 $rest";;
		esac;;
	reload-page)
		if [ -z "$a1$a2$a3$a4$rest" ]; then
			log "reload-page"; "$KIOSK_PAGE" reload
		else reject "reload-page $a1 $a2 $a3 $a4 $rest"; fi;;
	volume)
		# The volume of the panel (see "Volume" at the top).
		if in_range "$a1" 0 100 && [ -z "$a2$a3$a4$rest" ]; then
			if player_volume; then
				log "volume $a1 (Sendspin player)"; player_send player-vol "$a1"
			else
				log "volume $a1"
				if [ -n "$VOLUME_CMD" ]; then $VOLUME_CMD "$a1" >/dev/null; else "$AMIXER" -q -c "$CARD" sset Master "$a1%"; fi
			fi
		else reject "volume $a1 $a2 $a3 $a4 $rest"; fi;;
	mute)
		# Only the Sendspin player has a mute (see "Volume" at the top).
		if { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			if player_volume; then log "mute $a1 (Sendspin player)"; player_send player-mute "$a1"
			else reject "mute $a1 (the Sendspin player does not run: no mute)"; fi
		else reject "mute $a1 $a2 $a3 $a4 $rest"; fi;;
	config-url)
		case "$a1" in
		http://*|https://*)
			if [ -z "$a2$a3$a4$rest" ]; then
				log "config-url $a1"; "$CONFIG" set KIOSK_URL "$a1" && "$CONFIG" apply
			else reject "config-url $a1 (extra args)"; fi;;
		*) reject "config-url $a1 $a2 $a3 $a4 $rest";;
		esac;;
	verbose-boot)
		# BOOT_VERBOSE: kernel and boot text on the LCD from the next boot on
		# (panel.conf stores it, and tsx-config apply applies it). Callers
		# read the state back from the /etc/tsx/boot-verbose flag file that it
		# leaves, the same way as for blank-timeout and config-url above.
		if { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			v=0; [ "$a1" = on ] && v=1
			log "verbose-boot $a1"; "$CONFIG" set BOOT_VERBOSE "$v" && "$CONFIG" apply
		else reject "verbose-boot $a1 $a2 $a3 $a4 $rest"; fi;;
	reboot)
		if [ -z "$a1$a2$a3$a4$rest" ]; then
			log "reboot requested"; "$REBOOT_BIN"
		else reject "reboot $a1 $a2 $a3 $a4 $rest"; fi;;
	layout-install)
		# The panel app installs a layout from Home Assistant (set_layout).
		# ID: digits that the app chose, so it finds its own result.
		if in_range "$a1" 0 999999 && [ -z "$a2$a3$a4$rest" ]; then
			layout_install "$a1"
		else reject "layout-install $a1 $a2 $a3 $a4 $rest"; fi;;
	update-mode)
		# When tsx-autoupdate installs (see "Updates" at the top). panel.conf
		# stores it, and tsx-config apply hands it to tsx-autoupdate.
		if { [ "$a1" = auto ] || [ "$a1" = manual ]; } && [ -z "$a2$a3$a4$rest" ]; then
			log "update-mode $a1"; "$CONFIG" set UPDATE_MODE "$a1" && "$CONFIG" apply
		else reject "update-mode $a1 $a2 $a3 $a4 $rest"; fi;;
	auto-restart)
		if { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			log "auto-restart $a1"; "$CONFIG" set UPDATE_AUTO_RESTART "$a1" && "$CONFIG" apply
		else reject "auto-restart $a1 $a2 $a3 $a4 $rest"; fi;;
	dark-mode)
		# KIOSK_DARK (see "Dark mode" at the top). The browser reads it at
		# its start, so a change restarts the kiosk.
		if { [ "$a1" = on ] || [ "$a1" = off ]; } && [ -z "$a2$a3$a4$rest" ]; then
			has_hw dark-mode || { log "dark-mode $a1: this panel has no kiosk browser"; return 0; }
			old=$(kiosk_dark_get)
			log "dark-mode $a1"; "$CONFIG" set KIOSK_DARK "$a1" && "$CONFIG" apply
			[ "$(kiosk_dark_get)" = "$old" ] || { log "dark-mode: restarting the kiosk"; kiosk_restart; }
		else reject "dark-mode $a1 $a2 $a3 $a4 $rest"; fi;;
	update-install)
		if [ -z "$a1$a2$a3$a4$rest" ]; then
			log "update-install requested"; run_detached "$UPDATE_BIN" now
		else reject "update-install $a1 $a2 $a3 $a4 $rest"; fi;;
	setup)
		# The "Setup" button of the quick-settings overlay (tsx-overlay.c).
		# It reopens the on-panel setup page for one ~15 min window, even on
		# an already-configured panel, like `tsx-config setup` over ssh
		# (see the "Setup page" docs of the board repository).
		if [ -z "$a1$a2$a3$a4$rest" ]; then
			log "setup requested"; "$CONFIG" setup
		else reject "setup $a1 $a2 $a3 $a4 $rest"; fi;;
	'') ;;
	*) reject "$cmd $a1 $a2 $a3 $a4 $rest";;
	esac
}

# Opening with <> (read+write) keeps a permanent reference on the FIFO. A
# short-lived writer (each caller opens, writes one line, closes) then never
# makes the read see EOF. See docs/esphome.md: a plain
# read-only open would make this loop exit after the very first command.
exec 3<>"$FIFO"
log "listening on $FIFO"
while IFS=' ' read -r cmd a1 a2 a3 a4 rest <&3; do
	handle "$cmd" "$a1" "$a2" "$a3" "$a4" "$rest"
	[ "$ONESHOT" = 1 ] && break
done
log "FIFO closed, exiting"
