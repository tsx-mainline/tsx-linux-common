#!/sbin/openrc-run
description="Privileged command FIFO for the unprivileged Home Assistant plugin (voice satellite)"
supervisor=supervise-daemon
command=/usr/local/sbin/tsx-panelctl
respawn_delay=2
respawn_max=0
output_log=/var/log/tsx-panelctl.log
error_log=/var/log/tsx-panelctl.log
# A board can add services that must start first in /etc/conf.d/tsx-panelctl
# (rc_after="..."), for example its light daemon.
depend() { need net; after tsx-idled tsx-buttons tsx-ledbar tsx-config; before tsx-voice tsx-esphome; }
start_pre() { checkpath -d -m 0755 /run/tsx; }
