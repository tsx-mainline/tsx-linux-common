#!/sbin/openrc-run
# tsx-hostname: name the panel like the factory firmware does,
# <model>-<MAC uppercase, no colons> (for example MODEL-100-XXXXXXXXXXXX),
# before anything on the network needs the name. The order of the sources:
#   1. lan_hostname from the board data (tsx_board_hostname_hint of board.sh).
#      The board file only READS its data. A board can keep this name in the
#      bootloader environment, which it reads with a tool of the board. The
#      factory firmware used this exact string.
#   2. <model>-<MAC>. The board file gives the model (tsx_board_model). A board
#      can cut the model from a longer product string, or it can give the device
#      tree model without the vendor name. The MAC is the one of eth0. tsx-setup
#      sets it and must run first, because the kernel MAC can be random.
#   3. tsx-kiosk.
# PANEL_NAME in the panel config (see the header of tsx-config) overrides all
# of the above. If it is set, tsx-config apply
# writes it to /run/tsx/panel-name before this service runs (it already
# validated the name against the same charset). It wins outright. It also
# names the sendspin player and the voice satellite, so the panel has one
# name everywhere.
# The script checks every candidate against ^[A-Za-z0-9-]{1,63}$ before it
# uses it. The script only READS the board data. It never writes it.
#
# It must run before "networking". The dhcp executor of ifupdown-ng defaults
# to use_hostname_for_dhcp=1. It reads the live hostname itself, so the
# interfaces file needs no change. udhcpc sends the hostname that this script
# sets as soon as it starts. It must also run before "syslog". The busybox
# syslogd stamps every line with the hostname that it saw at its start. A
# syslogd that starts first would log the default name of the image
# (tsx-kiosk, from /etc/hostname) for the whole first boot.
description="TSX hostname: PANEL_NAME from panel.conf, else the host name that the board suggests, else <model>-<MAC>, else tsx-kiosk"
depend() { need localmount; after tsx-setup tsx-config; before networking syslog; }

start() {
	ebegin "TSX hostname"
	valid() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9-]{1,63}$'; }

	name=
	if [ -r /run/tsx/panel-name ]; then
		pname=$(head -n1 /run/tsx/panel-name)
		valid "$pname" && name=$pname
	fi

	. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
	# The board file reads the env with a time limit. This service runs before
	# networking and syslog in the main boot sequence (see "depend" above), so
	# a hang here would stall the WHOLE boot. A failure falls through to
	# <model>-<MAC>, or tsx-kiosk.
	tsx_board_load 2>/dev/null || ewarn "board data not read (the reader failed or timed out): falling back to <model>-<MAC>/tsx-kiosk"
	lh=$(tsx_board_hostname_hint)
	model=$(tsx_board_model)
	# The login banner of the console profile (tsx-banner) shows the model.
	if [ -n "$model" ]; then mkdir -p /run/tsx && echo "$model" > /run/tsx/model; fi

	if [ -z "$name" ]; then
		valid "$lh" && name=$lh
	fi

	if [ -z "$name" ]; then
		mac=$(cat /sys/class/net/eth0/address 2>/dev/null || true)
		mac=$(printf '%s' "$mac" | tr -d ':' | tr 'a-z' 'A-Z')
		if [ -n "$model" ] && printf '%s' "$mac" | grep -qE '^[0-9A-F]{12}$'; then
			valid "$model-$mac" && name="$model-$mac"
		fi
	fi

	name=${name:-tsx-kiosk}
	echo "$name" > /etc/hostname
	hostname "$name" 2>/dev/null
	sed -i "s/^127\.0\.0\.1.*/127.0.0.1\tlocalhost $name/" /etc/hosts 2>/dev/null || true
	einfo "hostname: $name (panel_name='${pname:-}' lan_hostname='$lh' model='$model')"
	eend 0
}
