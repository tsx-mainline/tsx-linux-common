#!/sbin/openrc-run
description="TSX early setup: time zone, eth0 MAC, zram swap, CPU governor"
depend() { need localmount; before networking kiosk; }

# select_eth0_mac: print the MAC that eth0 must use on stdout, and keep
# TSX_ETH0_MAC_FILE in step with it. It is separate from start(), so a host
# test (tests/test-tsx-setup-mac.sh) can call only this function. The
# rest of start() has zram, cpufreq and timezone side effects on a real host.
#
# Mainline has no MAC source on these boards. The kernel picks a random MAC
# at each boot, so the DHCP address changed at every boot. The board file
# (board.sh) reads the unit MAC from the place that the board keeps it. This
# MAC ALWAYS wins when
# the board gives a valid one. The rescue system uses the same MAC, so a
# panel keeps one DHCP address in both. TSX_ETH0_MAC_FILE (/etc/tsx/eth0.mac)
# is only the fallback for a unit with no MAC in the board data. The script
# keeps it in step with a valid board MAC whenever it sees one (see the docs of
# the board repository, "Random MAC in the rescue, and the fix").
#
# The board file gives the MAC (tsx_board_mac_early, board.sh). TSX_BOARD_CONF
# and TSX_ETH0_MAC_FILE are hooks for host tests only (tests/). The hooks of
# the board file work the same way. They work like TSX_APPLY_PREFIX in
# tsx-config. If they are empty or unset, the script uses the real paths of
# the panel.
select_eth0_mac() {
	. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
	macf=${TSX_ETH0_MAC_FILE:-/etc/tsx/eth0.mac}
	mac=$(tsx_board_mac_early)
	if [ -n "$mac" ]; then
		cur=
		[ -s "$macf" ] && cur=$(head -1 "$macf")
		if [ "$cur" != "$mac" ]; then
			mkdir -p "$(dirname "$macf")" && echo "$mac" > "$macf"
			# Use stderr, because stdout is the answer of this function. einfo
			# of OpenRC prints to stdout. On a fresh install, this line made
			# mac= two lines, and `ip link set` failed. The random MAC stayed.
			einfo "eth0 MAC $mac (from the board, ${TSX_MAC_SOURCE:-board data}; $macf was '${cur:-unset}', now back in sync)" >&2
		fi
	else
		[ -s "$macf" ] && mac=$(head -1 "$macf")
		echo "$mac" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || mac=
		if [ -z "$mac" ]; then
			mac=$(od -An -N5 -tx1 /dev/urandom | tr -s ' ' ':' | sed 's/^:/02:/; s/:$//')
			mkdir -p "$(dirname "$macf")" && echo "$mac" > "$macf"
		fi
	fi
	printf '%s\n' "$mac"
}

# default_tz: the time zone that the card tool of a family wrote to the data
# partition (TSX_TZ_DEFAULT_FILE, /data/tsx/timezone: one zone name in the first
# line). The panel uses it only while panel.conf has no TZ_NAME. The file is not
# a setting of panel.conf on purpose: a panel with no kiosk counts as
# configured when panel.conf has any key, and the setup page must stay open
# until the first save. A name with a character outside the set of
# tsx-config, or one that starts with a slash, gives nothing.
default_tz() {
	tzf=${TSX_TZ_DEFAULT_FILE:-/data/tsx/timezone}
	[ -r "$tzf" ] || return 0
	z=$(head -n 1 "$tzf" 2>/dev/null | tr -d ' \r')
	case "$z" in ''|*[!A-Za-z0-9_+/-]*|/*) return 0;; esac
	printf '%s\n' "$z"
}

# apply_tz: set /etc/localtime and /etc/timezone from TZ_NAME (panel.conf,
# through /run/tsx/kiosk.conf), else from default_tz. A zone with no file in the
# zoneinfo folder changes nothing. Test hooks: TSX_ZONEINFO_DIR, TSX_LOCALTIME
# and TSX_TIMEZONE_FILE.
apply_tz() {
	[ -n "${TZ_NAME:-}" ] || TZ_NAME=$(default_tz)
	zi=${TSX_ZONEINFO_DIR:-/usr/share/zoneinfo}
	if [ -n "${TZ_NAME:-}" ] && [ -f "$zi/$TZ_NAME" ]; then
		ln -sf "$zi/$TZ_NAME" "${TSX_LOCALTIME:-/etc/localtime}"
		echo "$TZ_NAME" > "${TSX_TIMEZONE_FILE:-/etc/timezone}"
	fi
}

start() {
	ebegin "TSX setup"
	# Boot splash status line (does nothing when the text console has the screen)
	/usr/local/bin/tsx-splash -s "starting services" -p 30 status 2>/dev/null
	[ -r /etc/kiosk.conf ] && . /etc/kiosk.conf   # kiosk and ha profiles only
	[ -r /run/tsx/kiosk.conf ] && . /run/tsx/kiosk.conf   # panel.conf overrides (tsx-config apply)
	apply_tz
	mac=$(select_eth0_mac)
	# On some boards eth0 sits behind a USB hub and can appear a moment after boot.
	i=0; while [ ! -e /sys/class/net/eth0 ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	if ip link set dev eth0 address "$mac" 2>/dev/null; then einfo "eth0 MAC $mac"
	else ewarn "eth0 MAC '$mac' could not be set: eth0 keeps $(cat /sys/class/net/eth0/address 2>/dev/null)"; fi
	# Compressed swap in RAM. It needs CONFIG_ZRAM, and the panel kernel lacks it today.
	if [ ! -e /sys/block/zram0 ]; then modprobe zram num_devices=1 2>/dev/null || true; fi
	if [ -e /sys/block/zram0/disksize ] && ! grep -q zram0 /proc/swaps; then
		mem=$(awk '/MemTotal/{print $2}' /proc/meminfo)
		for a in zstd lz4 lzo-rle lzo; do grep -qw "$a" /sys/block/zram0/comp_algorithm && { echo $a > /sys/block/zram0/comp_algorithm; break; }; done
		echo $((mem / 2))K > /sys/block/zram0/disksize && mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
	fi
	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -w "$g" ] && { grep -qw schedutil "${g%/*}/scaling_available_governors" && echo schedutil > "$g" || echo ondemand > "$g"; } 2>/dev/null
	done
	eend 0
}
