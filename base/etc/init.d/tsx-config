#!/sbin/openrc-run
# Apply /data/tsx/panel.conf (see the header of tsx-config). This service does
# three things.
# 1. It writes the small /run/tsx/*.conf overrides. kiosk-session, kiosk,
#    tsx-setup, tsx-hostname, tsx-sendspin, tsx-voice and tsx-mqtt read them
#    after their own /etc defaults.
# 2. It applies the settings that are not only a file: the root password
#    hash, an authorized_keys entry, and voice enable or disable.
# 3. It adds the serial console of the board (TSX_SERIAL_CONSOLE of board.sh)
#    to /etc/securetty, so root can log in there.
# It must run before any service that reads those defaults. A board can add
# services that it must wait for in /etc/conf.d/tsx-config (rc_after="...").
# First it writes /run/tsx/hw.conf (tsx-hw detect): the parts that this
# panel has. apply and the services after it read that file. It also
# writes /run/tsx/emmc.state (tsx-emmc-state, a tool of the board), so that tsx-mqtt and the
# ESPHome device see the eMMC wear when they start. cron keeps it current.
description="TSX panel configuration (panel.conf -> /run/tsx overrides)"
depend() {
	need localmount
	after tsx-data
	before tsx-setup tsx-hostname networking kiosk tsx-sendspin tsx-mqtt tsx-voice
}
start() {
	checkpath -d -m 0755 /run/tsx
	/usr/local/sbin/tsx-hw detect || ewarn "tsx-hw detect failed. The services act as on a panel with all parts"
	# Root can log in on the serial console of the board only when
	# /etc/securetty lists it. The package ships the list with no board
	# console, so add the one that board.sh names (once, no duplicate).
	( . "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}" && . /usr/local/lib/tsx/serial.sh && tsx_serial_allow_root ) \
		|| ewarn "Could not add the serial console to /etc/securetty. Root cannot log in there"
	# Only a board that has this tool writes the eMMC state. The tool is board glue.
	if [ -x /usr/local/sbin/tsx-emmc-state ]; then
		/usr/local/sbin/tsx-emmc-state || ewarn "tsx-emmc-state failed. The eMMC health entities stay off"
	fi
	ebegin "Applying panel configuration"
	/usr/local/sbin/tsx-config apply || ewarn "tsx-config apply failed (see above). Continuing with defaults"
	eend 0   # never fails boot
}
# At shutdown, keep a root password that a person set with passwd. A
# reinstall that keeps /data reads it from panel.conf.
stop() {
	/usr/local/sbin/tsx-config sync-root >/dev/null 2>&1
	return 0
}
