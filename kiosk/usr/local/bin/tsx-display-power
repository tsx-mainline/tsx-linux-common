#!/bin/sh
# tsx-display-power on|off|status: turn the display output of the kiosk on or
# off. Run it as root or as the kiosk user.
#
# tsx-idled runs "off" after it turns the backlight off, and "on" before it
# turns the backlight on (DISPLAY_POWER_CMD in /etc/kiosk.conf). With only the
# backlight off, the LCD keeps the last frame, and the frame shows in room
# light. With the output off, the scanout stops and the kernel turns the LCD
# power off (panel-lvds). The glass then shows nothing.
#
#   sway (KIOSK_OSK not off): "output * power off|on" on every sway IPC
#       socket of the kiosk user. On some displays, the Alpine build of
#       wlroots 0.20 refuses the first "power on" after a "power off"
#       ("Backend commit failed"), and the second request works.
#       A patched wlroots build fixes this. The script still reads the power
#       state back after each request and sends the request again,
#       TSX_DISPLAY_TRIES times at most (default 3).
#   no sway: the framebuffer console (/sys/class/graphics/fb*/blank). The
#       kernel ignores it while a compositor (cage) owns the display. Under
#       cage, the blank stays backlight only.
#
# Exit status: 0 = the outputs are in the requested state (or the framebuffer
# took the request), 1 = no output took the request, 2 = usage error.
# tsx-idled runs "off" every 30 s while the screen is blank. So the script
# starts as few processes as it can: it reads the user ID from the passwd file,
# reads the power state from the answer of one swaymsg, and "off" asks first
# and sends nothing when the output is off already. "on" sends first (the wake
# must not wait).
# Env for tests: TSX_SWAYMSG (swaymsg), TSX_RUN_USER_DIR (/run/user),
# TSX_KIOSK_USER (kiosk), TSX_FB_DIR (/sys/class/graphics),
# TSX_DISPLAY_TRIES (3), TSX_PASSWD_FILE (/etc/passwd).
set -u
cmd=${1:-status}
case "$cmd" in
on|off|status) ;;
*) echo "usage: tsx-display-power on|off|status" >&2; exit 2;;
esac
SWAYMSG=${TSX_SWAYMSG:-swaymsg}
tries=${TSX_DISPLAY_TRIES:-3}

# power SOCKET: sets POWER to "on", "off" or "mixed" for the outputs of one
# sway, or "none" (no answer). The answer of swaymsg is JSON. The shell splits
# it into words: "power": is followed by true or false (or "power":true in
# one word).
POWER=none
power() {
	pw_out=$(SWAYSOCK=$1 "$SWAYMSG" -t get_outputs -r 2>/dev/null)
	pw_seen= pw_t= pw_f= pw_next=
	set -f
	for pw_w in $pw_out; do
		if [ -n "$pw_next" ]; then
			pw_next=
			case $pw_w in true*) pw_t=1;; false*) pw_f=1;; esac
			continue
		fi
		case $pw_w in
		'"power":') pw_seen=1 pw_next=1;;
		'"power":true'*) pw_seen=1 pw_t=1;;
		'"power":false'*) pw_seen=1 pw_f=1;;
		'"power":'*) pw_seen=1;;
		esac
	done
	set +f
	if [ -z "$pw_seen" ]; then POWER=none
	elif [ -n "$pw_f" ]; then if [ -n "$pw_t" ]; then POWER=mixed; else POWER=off; fi
	else POWER=on; fi
}

socks=
u=${TSX_KIOSK_USER:-kiosk}
# the user ID: the passwd file first (no process), else id
uid=
while IFS=: read -r pw_n _ pw_u _; do
	[ "$pw_n" = "$u" ] && { uid=$pw_u; break; }
done 2>/dev/null < "${TSX_PASSWD_FILE:-/etc/passwd}"
case $uid in ''|*[!0-9]*) uid=$(id -u "$u" 2>/dev/null) || uid=;; esac
if [ -n "$uid" ]; then
	for s in "${TSX_RUN_USER_DIR:-/run/user}/$uid"/sway-ipc.*.sock; do
		[ -S "$s" ] && socks="$socks $s"
	done
fi

if [ -n "$socks" ]; then
	rc=1
	for s in $socks; do
		if [ "$cmd" = status ]; then
			power "$s"
			echo "sway $POWER"
			rc=0
			continue
		fi
		# off: ask first, and send nothing when the output is off already
		if [ "$cmd" = off ]; then
			power "$s"
			if [ "$POWER" = off ]; then rc=0; continue; fi
		fi
		i=0 ok=0
		while [ $i -lt "$tries" ]; do
			i=$((i + 1))
			# swaymsg exits 2 when sway refuses the command, and 1 when it
			# cannot connect (a stale socket of a crashed session: skip it).
			SWAYSOCK=$s "$SWAYMSG" "output * power $cmd" >/dev/null 2>&1
			[ $? = 1 ] && { i=0; break; }
			power "$s"
			if [ "$POWER" = "$cmd" ]; then
				ok=1
				break
			fi
		done
		if [ $ok = 1 ]; then
			rc=0
			[ $i -gt 1 ] && echo "tsx-display-power: output $cmd after $i requests" >&2
		elif [ $i -gt 0 ]; then
			echo "tsx-display-power: output not $cmd after $i requests" >&2
		fi
	done
	exit $rc
fi

# No sway: the framebuffer console (4 = FB_BLANK_POWERDOWN, 0 = FB_BLANK_UNBLANK)
rc=1
for b in "${TSX_FB_DIR:-/sys/class/graphics}"/fb*/blank; do
	[ -e "$b" ] || continue
	case "$cmd" in
	status) echo "framebuffer ${b%/blank}"; rc=0;;
	on) echo 0 > "$b" 2>/dev/null && rc=0;;
	off) echo 4 > "$b" 2>/dev/null && rc=0;;
	esac
done
[ $rc = 0 ] || [ "$cmd" != status ] || echo "no display output"
exit $rc
