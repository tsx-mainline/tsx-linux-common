#!/bin/sh
# tsx-orientation: the screen orientation of the panel (panel.conf ORIENTATION,
# docs/rootfs.md "Orientation"). It is the one table that all consumers take
# their numbers from, and the live switch for the running kiosk.
#
# The names describe how the panel hangs on the wall, seen from the front:
#   landscape          the native mode: the front keys right of the screen
#   portrait           the panel turned 90 degrees clockwise: keys below
#   landscape-flipped  turned 180 degrees: keys left of the screen
#   portrait-flipped   turned 90 degrees counter-clockwise: keys above
# ROTATE is the same thing seen from the glass: the number of quarter turns
# CLOCKWISE that the picture is drawn on the native (landscape) LCD, so that
# it is upright for the viewer (portrait: the panel turns clockwise, so the
# picture turns counter-clockwise on the glass = 3 quarter turns clockwise).
#
#   tsx-orientation [-f FILE] get          the configured name (landscape when
#                                          FILE is missing, empty or invalid)
#   tsx-orientation check NAME             exit 0 if NAME is one of the four
#   tsx-orientation [-f FILE] info [NAME]  KEY=VALUE lines (sourceable):
#       ORIENTATION     the name
#       ROTATE          0..3, quarter turns clockwise of the picture on the LCD
#                       (with the mounting of the LCD added)
#       MOUNT           0..3, the mounting of the LCD (fbcon=rotate:N of the
#                       kernel command line). 0 when the LCD sits upright.
#       SWAY_TRANSFORM  sway "output * transform" (sway rotates clockwise)
#       TOUCH_MATRIX    libinput calibration matrix (6 values, sway
#                       "input type:touch calibration_matrix"): the identity
#                       in every orientation when the LCD sits upright (a
#                       mounting turns it, KIOSK_TOUCH_MATRIX of kiosk.conf
#                       replaces it). sway maps the touchscreen to
#                       the built-in output, and wlroots then turns every
#                       touch by the transform of that output (measured: a
#                       turned matrix on top of that turned the touches
#                       twice). The script still sends it, so a live
#                       change resets a matrix set by hand or by an older build.
#       FBCON_ROTATE    /sys/class/graphics/fbcon/rotate_all (1 = clockwise,
#                       3 = counter-clockwise, the same number as ROTATE)
#       SLIDE_INVERT    1 = tsx-buttons turns the slide along the front keys around, so
#                       sliding up or right is brighter in every orientation
#   tsx-orientation [-f FILE] sway [NAME]  the sway config lines (kiosk-session).
#                                          Nothing when the screen needs no turn
#   tsx-orientation [-f FILE] apply        (root or the kiosk user) turn the
#                                          running kiosk (sway) to the configured
#                                          orientation now: output transform and
#                                          touch mapping. Chromium, the keyboard
#                                          and the overlay follow the new size
#
# FILE (default /etc/tsx/orientation, env TSX_ORIENTATION_FILE) comes from
# panel.conf. `tsx-config apply` keeps it on the root file system, so the
# initramfs (which cannot read /data) finds it too. Absent = landscape.
# Env for tests: TSX_SWAYMSG (swaymsg), TSX_RUN_USER_DIR (/run/user),
# TSX_KIOSK_USER (kiosk), TSX_PANEL_ROTATE, TSX_CMDLINE, TSX_KIOSK_CONF.
set -u
FILE=${TSX_ORIENTATION_FILE:-/etc/tsx/orientation}
if [ "${1:-}" = -f ]; then
	[ $# -ge 2 ] || { echo "tsx-orientation: -f needs a file" >&2; exit 2; }
	FILE=$2; shift 2
fi

valid() {
	case "$1" in landscape|portrait|landscape-flipped|portrait-flipped) return 0;; esac
	return 1
}

# The configured name. Anything unexpected in the file reads as landscape.
configured() {
	o=
	[ -r "$FILE" ] && read -r o < "$FILE" 2>/dev/null
	valid "${o:-}" && echo "$o" || echo landscape
}

# The mounting of the LCD: fbcon=rotate:N on the kernel command line (0 when
# the LCD sits upright in the housing). Test hooks: TSX_PANEL_ROTATE and
# TSX_CMDLINE.
mount_rot() {
	if [ -n "${TSX_PANEL_ROTATE:-}" ]; then echo $((TSX_PANEL_ROTATE & 3)); return; fi
	n=$(tr ' ' '\n' < "${TSX_CMDLINE:-/proc/cmdline}" 2>/dev/null | sed -n 's/^fbcon=rotate:\([0-3]\)$/\1/p' | tail -n 1)
	echo "${n:-0}"
}

# KIOSK_TOUCH_MATRIX from kiosk.conf (six numbers), else nothing
touch_override() {
	v=$(sed -n 's/^KIOSK_TOUCH_MATRIX=//p' "${TSX_KIOSK_CONF:-/etc/kiosk.conf}" 2>/dev/null | tail -n 1 | tr -d '"'"'"'')
	set -- $v
	[ $# = 6 ] && echo "$*"
}

# info NAME: the table. Only ROTATE is chosen per name. Everything else
# follows from it. Checked on a panel (raw scanout dumps): sway
# transform 270 and fbcon rotate 3 put the top of the picture at the left
# edge of the native LCD. That is upright on a panel turned clockwise
# (portrait).
info() {
	case "$1" in
	landscape) r=0;;
	portrait) r=3;;
	landscape-flipped) r=2;;
	portrait-flipped) r=1;;
	*) return 1;;
	esac
	case $r in 1|2) inv=1;; *) inv=0;; esac
	# The LCD can sit turned in the housing (the mounting). The picture turns
	# by the mounting too.
	mt=$(mount_rot)
	r=$(( (r + mt) % 4 ))
	# The picture turns r quarter turns clockwise on the LCD.
	case $r in
	0) t=normal;;
	1) t=90;;
	2) t=180;;
	3) t=270;;
	esac
	# A touch controller that reports in the mounted frame needs a matrix that
	# turns the touches back by the mounting. wlroots then turns them by the
	# output transform, like the picture. Sway's "transform 90" turns a touch
	# (x, y) into (y, 1-x) (measured on a panel). These matrices undo the
	# quarter turns of the mounting before that. Mounting 0 gives the identity.
	case $mt in
	0) m="1 0 0 0 1 0";;
	1) m="0 -1 1 1 0 0";;
	2) m="-1 0 1 0 -1 1";;
	3) m="0 1 0 -1 0 1";;
	esac
	o=$(touch_override) && m=$o
	echo "ORIENTATION=$1"
	echo "ROTATE=$r"
	echo "MOUNT=$mt"
	echo "SWAY_TRANSFORM=$t"
	echo "TOUCH_MATRIX=\"$m\""
	echo "FBCON_ROTATE=$r"
	echo "SLIDE_INVERT=$inv"
}

name_arg() {  # name_arg [NAME]: the argument (checked) or the configured name
	if [ -n "${1:-}" ]; then
		valid "$1" || { echo "tsx-orientation: unknown orientation '$1' (landscape|portrait|landscape-flipped|portrait-flipped)" >&2; exit 2; }
		echo "$1"
	else
		configured
	fi
}

# apply: use every sway IPC socket of the kiosk user (normally one). A stale
# socket from a crashed session just fails.
apply_live() {
	eval "$(info "$(configured)")"
	u=${TSX_KIOSK_USER:-kiosk}
	uid=$(id -u "$u" 2>/dev/null) || { echo "tsx-orientation: no user $u" >&2; return 0; }
	n=0
	for s in "${TSX_RUN_USER_DIR:-/run/user}/$uid"/sway-ipc.*.sock; do
		[ -S "$s" ] || continue
		if SWAYSOCK=$s "${TSX_SWAYMSG:-swaymsg}" "output * transform $SWAY_TRANSFORM" >/dev/null 2>&1; then
			SWAYSOCK=$s "${TSX_SWAYMSG:-swaymsg}" "input type:touch calibration_matrix $TOUCH_MATRIX" >/dev/null 2>&1
			n=$((n + 1))
		fi
	done
	if [ $n -gt 0 ]; then
		echo "tsx-orientation: kiosk turned to $ORIENTATION (sway transform $SWAY_TRANSFORM)" >&2
	else
		echo "tsx-orientation: no running sway kiosk; $ORIENTATION applies at the next kiosk start" >&2
	fi
	return 0
}

cmd=${1:-get}
[ $# -ge 1 ] && shift
case "$cmd" in
get) configured;;
check) [ $# = 1 ] && valid "$1";;
info) n=$(name_arg "${1:-}") || exit 2; info "$n";;
sway)
	n=$(name_arg "${1:-}") || exit 2
	eval "$(info "$n")"
	# Nothing to turn: no lines (the sway default is the same).
	[ "$SWAY_TRANSFORM" = normal ] && [ "$TOUCH_MATRIX" = "1 0 0 0 1 0" ] && exit 0
	echo "output * transform $SWAY_TRANSFORM"
	echo "input type:touch calibration_matrix $TOUCH_MATRIX";;
apply) apply_live;;
*) sed -n '2,52p' "$0" >&2; exit 2;;
esac
