#!/bin/sh
# Runs as the kiosk user under supervise-daemon (/etc/init.d/kiosk).
# It picks the renderer, then starts the compositor with the browser:
#   KIOSK_OSK=off          cage + Chromium --kiosk (no on-screen keyboard).
#                          A board without cage gets the sway session below,
#                          with no keyboard.
#   KIOSK_OSK=squeekboard  sway (kiosk config) + squeekboard + Chromium --app.
#                          The keyboard shows by itself when a text field gets
#                          focus (text-input-v3 -> input-method-v2)
#   KIOSK_OSK=wvkbd        sway + wvkbd (starts hidden. A three-finger tap or
#                          "tsx-osk toggle" shows or hides it)
# Under sway it also runs the quick-settings overlay tsx-overlay (brightness,
# auto brightness, screen off, reload. KIOSK_OVERLAY=on). tsx-buttons shows
# it on a slide along the front-key strip or a long hold of the top key.
# Cage has no layer-shell, so there is no overlay there. The key-strip slide
# still sets the brightness. The long hold runs OVERLAY_FALLBACK of
# buttons.conf.
# Under sway, this script runs a second time as "kiosk-session --browser"
# (from the generated sway config) to start Chromium. Sway exits when
# Chromium exits.
set -u
# The board values: the DRM driver names and the sound card. Test hook: TSX_BOARD_CONF.
. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
. /etc/kiosk.conf
[ -r /etc/tsx/panel-board.conf ] && . /etc/tsx/panel-board.conf   # the values of the board
# panel.conf overrides (KIOSK_URL, TZ_NAME). tsx-config apply generates them
# at boot. See docs/rootfs.md "Panel configuration".
[ -r /run/tsx/kiosk.conf ] && . /run/tsx/kiosk.conf
# URL chosen with a front-panel key when DevTools is off (tsx-buttons, NAV_FALLBACK=restart)
[ -s /run/tsx/kiosk-url ] && KIOSK_URL=$(cat /run/tsx/kiosk-url)
# The on-panel setup page shows when nothing is configured yet, or for ~15
# min after `tsx-config setup` or the overlay "Setup" entry (docs/rootfs.md
# "Setup page"). tsx-kiosk-url is a pure function of its argument and
# /run/tsx/setup-open. It is not inline in this script, so a test can run it
# standalone (tests/test-setup.sh).
KIOSK_URL=$(/usr/local/bin/tsx-kiosk-url "${KIOSK_URL:-}")
: "${KIOSK_URL:=https://ha.example.org}" "${KIOSK_GPU:=auto}" "${KIOSK_SCALE:=1.0}"
: "${KIOSK_PROFILE:=/var/lib/kiosk/chromium}" "${KIOSK_EXTRA_FLAGS:=}" "${KIOSK_DEVTOOLS:=0}"
: "${KIOSK_OSK:=squeekboard}" "${KIOSK_OSK_HEIGHT:=300}"
ROLE=${1:-session}
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export HOME=/var/lib/kiosk
log() { [ "$ROLE" = session ] && echo "kiosk-session: $*" >&2; }
case "$KIOSK_OSK" in squeekboard|wvkbd|off) ;; *) log "unknown KIOSK_OSK=$KIOSK_OSK, using off"; KIOSK_OSK=off;; esac

# Boot race: tsx-kiosk-url picked the local setup page, but tsx-setupd (its
# own OpenRC service) may not have bound its port yet this early in boot.
# Wait at most about 10s, with a heartbeat log line. Then a slow setup
# service does not cause a browser connection-refused error page. The own
# chrome-error retry of tsx-kiosk-reveal (docs/boot.md) covers only the
# sway+DevTools path, not KIOSK_OSK=off or KIOSK_DEVTOOLS=0.
case "$KIOSK_URL" in
http://127.0.0.1:*/setup)
	port=${KIOSK_URL#http://127.0.0.1:}; port=${port%%/*}
	i=0
	while [ $i -lt 50 ]; do
		curl -s -o /dev/null -m 1 "http://127.0.0.1:$port/setup" 2>/dev/null && break
		[ $((i % 10)) = 0 ] && log "waiting for the setup page on 127.0.0.1:$port..."
		i=$((i + 1)); sleep 0.2
	done
	[ $i -lt 50 ] || log "setup page still not reachable on 127.0.0.1:$port after ~10s, loading it anyway"
	;;
esac

# --- renderer selection -------------------------------------------------
# Primary path: the display driver of the board (TSX_DISPLAY_DRM, meson on the
# xx60) for KMS, and its GPU (TSX_RENDER_DRM, lima) for the render node. GLES2
# in cage and GPU compositing in Chromium. Fallback: simpledrm on the U-Boot
# framebuffer with pixman + software rendering. The script picks cards by
# driver name, never by number (on the xx60 lima is card0, meson card2).
# drv_in NAME LIST: succeed if NAME matches one of the patterns in LIST
drv_in() {
	for _p in $2; do
		case "$1" in $_p) return 0;; esac
	done
	return 1
}
DRM=${TSX_DRM_SYS:-/sys/class/drm}
disp= dispdrv= render= renderdrv=
for c in "$DRM"/card[0-9]*; do
	case "${c##*/}" in *-*) continue;; esac     # skip connectors (card2-LVDS-1)
	[ -e "$c/device/driver" ] || continue
	ls -d "$c/${c##*/}"-* >/dev/null 2>&1 || continue   # no connector: a GPU with no display
	drv=$(basename "$(readlink -f "$c/device/driver")")
	if drv_in "$drv" "$TSX_DISPLAY_DRM"; then disp=/dev/dri/${c##*/}; dispdrv=$drv; break
	elif drv_in "$drv" "$TSX_RENDER_DRM"; then :     # render-only GPU, no display
	else
		case "$drv" in
		*simple*) [ -z "$disp" ] && { disp=/dev/dri/${c##*/}; dispdrv=$drv; };;   # the firmware framebuffer is the last choice
		*) disp=/dev/dri/${c##*/}; dispdrv=$drv; break;;   # any other display driver
		esac
	fi
done
for r in "$DRM"/renderD*; do
	[ -e "$r/device/driver" ] || continue
	_rd=$(basename "$(readlink -f "$r/device/driver")")
	# TSX_RENDER_DRM names the GPUs that have no display. Empty: any render node.
	if [ -n "$TSX_RENDER_DRM" ]; then
		drv_in "$_rd" "$TSX_RENDER_DRM" || continue
	fi
	render=/dev/dri/${r##*/} renderdrv=$_rd; break
done

# KIOSK_GPU: auto | on (GLES compositor + GPU browser, stock flags) |
# compositor (GLES compositor, software browser) | off (pixman + software
# browser). A board hook in kiosk.d (below) can add a mode. Any other value
# counts as auto.
comp_gl=0 browser_gl=0 pixman_note=0
case "$KIOSK_GPU" in
on) comp_gl=1 browser_gl=1;;
compositor) comp_gl=1;;
off) ;;
*) if drv_in "$dispdrv" "$TSX_DISPLAY_DRM"; then [ -n "$render" ] && comp_gl=1 browser_gl=1; fi
   [ $comp_gl = 0 ] && [ -n "$render" ] && pixman_note=1;;
esac

# --- board hooks (kiosk.d) --------------------------------------------------
# A board package can ship shell files in /usr/local/lib/tsx/kiosk.d (name
# order, *.sh). Each file changes the choice above. Use a hook for a GPU or a
# browser that needs its own rules. The file is sourced by this script, as the
# kiosk user, in the session and in the browser role. The board and the
# renderer are known at this point. The contract is in docs/kiosk-hooks.md.
# A hook may read: KIOSK_GPU, disp, dispdrv, render, renderdrv (the driver of
# the render node), the board values and the function log. A hook may change
# four names, and only these:
#   KIOSK_GL_COMPOSITOR     1 = GLES in the compositor, 0 = pixman
#   KIOSK_GL_BROWSER        1 = GPU compositing in the browser, 0 = software
#   KIOSK_BROWSER_GL_FLAGS  the flags for a browser that uses the GPU
#   KIOSK_DISABLE_FEATURES  the Chromium features to turn off (comma list)
# The first three start with the choice above. The script reads all four
# after the hooks.
# The script sources a file only when root owns the folder and the file and
# group and others cannot write them. Else it logs one line and skips the file.
# Test hooks: TSX_KIOSK_HOOK_DIR, TSX_KIOSK_HOOK_UID (the owner that counts as
# root).
KIOSK_GL_COMPOSITOR=$comp_gl KIOSK_GL_BROWSER=$browser_gl KIOSK_BROWSER_GL_FLAGS=${TSX_BROWSER_GL_FLAGS:-}
# hook_safe PATH: succeed if PATH is no symbolic link, root owns it, and group
# and others cannot write it
hook_safe() {
	[ -L "$1" ] && return 1
	_l=$(ls -dn "$1" 2>/dev/null) || return 1
	set -- $_l
	[ "${3:-}" = "${TSX_KIOSK_HOOK_UID:-0}" ] || return 1
	case "$1" in ?????w*|????????w*) return 1;; esac
	return 0
}
hookdir=${TSX_KIOSK_HOOK_DIR:-/usr/local/lib/tsx/kiosk.d}
if [ -d "$hookdir" ]; then
	if hook_safe "$hookdir"; then
		for _h in "$hookdir"/*.sh; do
			[ -f "$_h" ] || continue
			if ! hook_safe "$_h"; then
				log "hook $_h skipped: root must own the file and group and others must not write it"
			elif ! sh -n "$_h" 2>/dev/null; then
				log "hook $_h skipped: syntax error"
			else
				. "$_h"
			fi
		done
	else
		log "hooks in $hookdir skipped: root must own the folder and group and others must not write it"
	fi
fi
case "${KIOSK_GL_COMPOSITOR:-}" in 1) comp_gl=1;; *) comp_gl=0;; esac
case "${KIOSK_GL_BROWSER:-}" in 1) browser_gl=1;; *) browser_gl=0;; esac
[ $pixman_note = 1 ] && [ $comp_gl = 0 ] && log "GPU $render present but display is ${dispdrv:-none}: using pixman"
if [ $comp_gl = 1 ]; then
	export WLR_RENDERER=gles2
else
	export WLR_RENDERER=pixman
fi
[ -n "$disp" ] && export WLR_DRM_DEVICES=$disp
if drv_in "$dispdrv" "$TSX_DISPLAY_DRM" && [ -n "$TSX_DISPLAY_ENV" ]; then
	# The board names the variables of its display. On the xx60 (Meson8 OSD
	# planes: ARGB8888 only, no modifiers), the patched cage picks ARGB8888
	# when XRGB8888 is missing. The variables force it regardless.
	export $TSX_DISPLAY_ENV
fi
# The board can name variables for its GPU in TSX_RENDER_ENV (NAME=value
# words, for example a flag of the GPU driver). KIOSK_RENDER_ENV: auto (with a
# render node) | 1 (always) | 0 (never).
case "${KIOSK_RENDER_ENV:-auto}" in
0) ;;
1) [ -n "${TSX_RENDER_ENV:-}" ] && export $TSX_RENDER_ENV;;
*) [ -n "$render" ] && [ -n "${TSX_RENDER_ENV:-}" ] && export $TSX_RENDER_ENV;;
esac
export WLR_BACKENDS=drm,libinput
export WLR_LIBINPUT_NO_DEVICES=1          # start even before touch is probed
export WLR_NO_HARDWARE_CURSORS=1
# Invisible cursor theme for the compositor and the browser (touch-only panel)
export XCURSOR_PATH=/usr/share/tsx/cursors XCURSOR_THEME=blank XCURSOR_SIZE=24
log "display=${disp:-none} (${dispdrv:-?}) render=${render:-none} renderer=$WLR_RENDERER browser_gpu=$browser_gl osk=$KIOSK_OSK url=$KIOSK_URL"

# --- the compositor: sway, or cage without a keyboard -----------------------
# cage 0.3.1 has no wlr-layer-shell, so no keyboard surface can show under it
# (wayland-info on the panel, 2026-09-26). sway 1.12 has layer-shell,
# input-method-v2, text-input-v3 and virtual-keyboard, and it turns the output
# with the touch mapping that goes with it. It falls back to ARGB8888 by
# itself when the Meson plane has no XRGB8888 (no patch needed). A board
# without cage always gets sway.
sway=1
[ "$KIOSK_OSK" = off ] && [ -x "${TSX_CAGE:-/usr/bin/cage}" ] && sway=0
if [ $sway = 1 ] && [ "$ROLE" = session ]; then
	export NO_AT_BRIDGE=1 GTK_A11Y=none      # no AT-SPI bus for squeekboard/GTK
	# Session D-Bus at a fixed path (the sm.puri.OSK0 API of squeekboard,
	# tsx-osk). Do not use dbus-run-session: the TERM of supervise-daemon must
	# reach sway itself.
	me=$(id -u)
	# Leftovers of a previous session (supervise-daemon only stops sway)
	pkill -u "$me" -f kiosk-osk.sh 2>/dev/null
	pkill -u "$me" -x dbus-daemon 2>/dev/null
	pkill -u "$me" -x squeekboard 2>/dev/null
	pkill -u "$me" -f '^wvkbd' 2>/dev/null
	pkill -u "$me" -f kiosk-overlay.sh 2>/dev/null
	pkill -u "$me" -x tsx-overlay 2>/dev/null
	pkill -u "$me" -f '^/usr/libexec/(feedbackd|at-spi)' 2>/dev/null
	rm -f "$XDG_RUNTIME_DIR/bus"
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
	dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile >/dev/null ||
		log "dbus-daemon failed"
	# Keyboard: the loop restarts it if it dies. The loop ends with its own
	# sway (the IPC socket name has the pid of sway). The next sway reuses the
	# wayland-N name, and a second squeekboard would fight the first one.
	osk= osk_exec=
	case "$KIOSK_OSK" in
	squeekboard) osk="squeekboard";;
	wvkbd) osk="wvkbd-mobintl --hidden -L $KIOSK_OSK_HEIGHT -H $KIOSK_OSK_HEIGHT --fn 'DejaVu Sans 20'";;
	esac
	if [ -n "$osk" ]; then
		cat > "$XDG_RUNTIME_DIR/kiosk-osk.sh" <<EOF
#!/bin/sh
while sleep 1; [ -S "\$SWAYSOCK" ]; do
	$osk >/dev/null 2>&1
done
EOF
		osk_exec="exec sh $XDG_RUNTIME_DIR/kiosk-osk.sh"
	fi
	# Quick-settings overlay. A loop restarts it like the keyboard. Its stderr
	# (errors only) goes to the kiosk log, together with the stderr of sway.
	overlay_exec=
	if [ "${KIOSK_OVERLAY:-on}" != off ] && [ -x /usr/local/bin/tsx-overlay ]; then
		cat > "$XDG_RUNTIME_DIR/kiosk-overlay.sh" <<EOF
#!/bin/sh
while sleep 1; [ -S "\$SWAYSOCK" ]; do
	/usr/local/bin/tsx-overlay
done
EOF
		overlay_exec="exec sh $XDG_RUNTIME_DIR/kiosk-overlay.sh"
	fi
	# Boot splash handoff (docs/boot.md "Boot splash"). The background of sway
	# is the frame that the framebuffer splash showed (tsx-splash png, status
	# line included). The browser window stays fully transparent until
	# tsx-kiosk-reveal sees the page painted. So there is no black gap, no
	# white window and no half-drawn page. KIOSK_SPLASH=off: plain black,
	# window shown at once.
	splash_cfg="swaybg_command -"
	if [ "${KIOSK_SPLASH:-on}" != off ] && [ -x /usr/local/bin/tsx-splash ]; then
		host=${KIOSK_URL#*://}; host=${host%%/*}; host=${host##*@}
		if /usr/local/bin/tsx-splash -s "loading $host" -p 90 png "$XDG_RUNTIME_DIR/splash.png" 2>/dev/null; then
			splash_cfg="output * bg $XDG_RUNTIME_DIR/splash.png center #000000
for_window [app_id=\"^chrome-\"] opacity 0"
			export KIOSK_REVEAL=1
		else
			log "tsx-splash png failed: no splash background, browser shown at once"
		fi
	fi
	# Screen orientation (panel.conf ORIENTATION, docs/rootfs.md
	# "Orientation") and the mounting of the LCD: the output transform and the
	# touch mapping that goes with it. tsx-orientation prints nothing when the
	# screen needs no turn. `tsx-config apply` turns a running session live
	# with the same numbers (tsx-orientation apply).
	orient_cfg=
	if [ -x /usr/local/bin/tsx-orientation ]; then
		orient_cfg=$(/usr/local/bin/tsx-orientation sway)
		[ -n "$orient_cfg" ] && log "orientation $(/usr/local/bin/tsx-orientation get): $(echo "$orient_cfg" | tr '\n' ';')"
	fi
	cfg=$XDG_RUNTIME_DIR/kiosk-sway.conf
	cat > "$cfg" <<EOF
# generated by kiosk-session (KIOSK_OSK=$KIOSK_OSK). Edit the script, not this
xwayland disable
$splash_cfg
default_border none
default_floating_border none
hide_edge_borders both
focus_follows_mouse no
seat * hide_cursor 100
seat * xcursor_theme $XCURSOR_THEME $XCURSOR_SIZE
$orient_cfg
# One browser window only: links that leave the app (target=_blank, other
# sites) open a normal Chromium window (app_id "chromium"). Close it.
for_window [app_id="^chromium(-browser)?\$"] kill
$osk_exec
$overlay_exec
exec /usr/local/bin/kiosk-session --browser
EOF
	exec sway -c "$cfg"
fi

# --- browser --------------------------------------------------------------
mkdir -p "$KIOSK_PROFILE/Default"
# Clear the "restore pages?" state after an unclean stop
P="$KIOSK_PROFILE/Default/Preferences"
[ -f "$P" ] && sed -i 's/"exit_type":"[A-Za-z]*"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' "$P"
rm -f "$KIOSK_PROFILE"/Singleton*

set -- --ozone-platform=wayland \
	--user-data-dir="$KIOSK_PROFILE" \
	--no-first-run --no-default-browser-check --noerrdialogs --disable-infobars \
	--disable-session-crashed-bubble --hide-crash-restore-bubble \
	--password-store=basic --disable-sync --disable-component-update \
	--check-for-update-interval=31536000 \
	--disable-features=Translate,TranslateUI,MediaRouter,OptimizationHints,AutofillServerCommunication,CalculateNativeWinOcclusion,PasswordManagerOnboarding${KIOSK_DISABLE_FEATURES:+,$KIOSK_DISABLE_FEATURES} \
	--touch-events=enabled --disable-pinch --overscroll-history-navigation=0 \
	--pull-to-refresh=0 --autoplay-policy=no-user-gesture-required \
	--force-device-scale-factor="$KIOSK_SCALE" \
	--renderer-process-limit=2 --disk-cache-size=67108864 --log-level=2
# Keep the cache off the data partition (see KIOSK_CACHE_DIR in kiosk.conf).
# Drop the old copy inside the profile once. It would only take space on the card.
if [ -n "${KIOSK_CACHE_DIR:-}" ] && [ -d "$KIOSK_CACHE_DIR" ] && [ -w "$KIOSK_CACHE_DIR" ]; then
	[ -z "$(ls -A "$KIOSK_CACHE_DIR")" ] && rm -rf "$KIOSK_PROFILE/Default/Cache" "$KIOSK_PROFILE/Default/Code Cache"
	set -- "$@" --disk-cache-dir="$KIOSK_CACHE_DIR"
fi
# Chromium sandbox: user namespaces, or the setuid chrome-sandbox helper (it
# needs PID + net namespaces). Without them, Chromium runs with --no-sandbox.
if [ "${KIOSK_NO_SANDBOX:-0}" = 1 ] || ! { [ -e /proc/self/ns/user ] || { [ -e /proc/self/ns/pid ] && [ -e /proc/self/ns/net ] && [ -u /usr/lib/chromium/chrome-sandbox ]; }; }; then
	log "running Chromium without sandbox (kernel lacks namespaces, or KIOSK_NO_SANDBOX=1)"
	set -- "$@" --no-sandbox
else
	# With namespaces, the renderers run sandboxed. The GPU-process seccomp
	# policy of Chromium 152 on armv7/musl kills the GPU process on pwritev2
	# (syscall 393): "GPU process isn't usable. Goodbye." and a respawn loop
	# (xx60, 2026-09-26). On aarch64 the GPU sandbox works. KIOSK_GPU_SANDBOX:
	# auto = off on armv7, on elsewhere | 0 = off | 1 = on. Only the GPU
	# process runs unsandboxed. The renderers stay sandboxed.
	gs=${KIOSK_GPU_SANDBOX:-auto}
	[ "$gs" = auto ] && { [ "$(uname -m)" = armv7l ] && gs=0 || gs=1; }
	if [ "$gs" = 0 ]; then
		log "sandbox on for renderers/utilities. GPU process unsandboxed (KIOSK_GPU_SANDBOX=${KIOSK_GPU_SANDBOX:-auto})"
		set -- "$@" --disable-gpu-sandbox
	fi
fi
if [ $browser_gl = 1 ]; then
	# A small GPU can be on the blocklist of Chromium. Chromium falls back to
	# software compositing by itself if the GL init fails (see chrome://gpu
	# through KIOSK_DEVTOOLS). The board can add flags in TSX_BROWSER_GL_FLAGS
	# (for example the ANGLE backend), and a hook in kiosk.d can replace them
	# (KIOSK_BROWSER_GL_FLAGS). Variants to try with KIOSK_EXTRA_FLAGS:
	# --use-angle=gles | --use-angle=gl | --enable-gpu-rasterization
	# shellcheck disable=SC2086
	set -- "$@" --ignore-gpu-blocklist ${KIOSK_BROWSER_GL_FLAGS:-}
else
	set -- "$@" --disable-gpu --disable-gpu-compositing --disable-software-rasterizer
fi
mem=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
[ "$mem" -lt 1400 ] && set -- "$@" --enable-low-end-device-mode
# Without GPU compositing on this SoC, animations (for example the HA login
# background) cost ~50 % CPU in software. prefers-reduced-motion makes HA
# drop them (measured: 47 % -> 3 % CPU on the login page).
[ "${KIOSK_REDUCED_MOTION:-1}" = 1 ] && set -- "$@" --force-prefers-reduced-motion
[ "$KIOSK_DEVTOOLS" = 1 ] && set -- "$@" --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 '--remote-allow-origins=*'
if [ "$KIOSK_OSK" = squeekboard ]; then
	# text-input-v3: Chromium tells the compositor when an editable field has
	# focus. Sway passes that to squeekboard (input-method-v2), and squeekboard shows.
	set -- "$@" --enable-wayland-ime --wayland-text-input-version=3
fi
# shellcheck disable=SC2086
set -- "$@" $KIOSK_EXTRA_FLAGS

if [ $sway = 0 ]; then
	# cage has no input configuration. The touch mapping cannot follow a
	# turned output, so the cage session stays landscape.
	[ -x /usr/local/bin/tsx-orientation ] && [ "$(/usr/local/bin/tsx-orientation get)" != landscape ] &&
		log "ORIENTATION $(/usr/local/bin/tsx-orientation get) needs the sway session (KIOSK_OSK not off): cage shows landscape"
	exec cage -d -- chromium-browser --kiosk "$@" "$KIOSK_URL"
fi
# The splash stays until the page has painted. tsx-kiosk-reveal then sets the
# window opaque (sway session with KIOSK_SPLASH on, see above).
if [ "${KIOSK_REVEAL:-0}" = 1 ] && [ -n "${SWAYSOCK:-}" ]; then
	/usr/local/bin/tsx-kiosk-reveal "$KIOSK_URL" --devtools "$KIOSK_DEVTOOLS" \
		--timeout "${KIOSK_REVEAL_TIMEOUT:-60}" &
fi
# Under sway, use --app instead of --kiosk. --kiosk forces fullscreen, and
# sway draws fullscreen windows above the keyboard layer and ignores its
# exclusive zone. A non-fullscreen --kiosk window shows tabs and the address
# bar. An --app window has no browser UI and fills the output. It shrinks
# while the keyboard is up, so the focused field stays visible above it.
chromium-browser "$@" --app="$KIOSK_URL"
rc=$?
swaymsg exit >/dev/null 2>&1
exit $rc
