#!/bin/sh
# tsx-mqtt: MQTT bridge between the panel kiosk and Home Assistant.
#
# It publishes HA MQTT discovery (retained) for one device with:
#   light  "LED bar"      RGB (tsx-ledbar. HA 0..255 <-> bar 0..100 per channel.
#                         Only while a LED bar with its application is attached
#                         (tsx-panelctl has ledbar). The light appears when the
#                         bar is plugged in and goes when the bar is removed:
#                         the script publishes the discovery topic, or clears it
#                         with an empty retained payload. Without a bar it
#                         publishes no LED bar state and ignores LED bar
#                         commands). With the bar firmware TSX-LEDBAR it also
#                         has the effects of the bar: Breathe, Blink and
#                         Rainbow (tsx-panelctl has ledbar-fx), and Chase,
#                         Fill and Spectrum (has ledbar-leds). The list is
#                         the one of the ESPHome light without Pulse, a
#                         software effect of the shim
#   light  "Key LEDs"     brightness 0..255 (tsx-keypad led N|off. Only where the
#                         keys have LEDs: tsx-panelctl has keyleds)
#   switch "Screen"       ON = lit, OFF = blanked (tsx-blank)
#   number "Backlight"    1..100 % of the slider, as the ESPHome entity: a set
#                         goes to tsx-panelctl send brightness-pct (the
#                         tsx-idled override), the state is tsx-panelctl get
#                         backlight-pct (also the waiting override of a blank
#                         screen)
#   number "Blank timeout"  seconds without input before the screen goes dark,
#                         0 = never (panel.conf BLANK_TIMEOUT via tsx-config)
#   binary_sensor "Touched recently"  last real input < 30 s ago (tsx-idled's
#                         /run/tsx/last-input)
#   event  "Key NAME"     per front key: short / long / hold. The keys are the
#                         `button` lines of /etc/tsx/buttons-board.conf and
#                         /etc/tsx/buttons.conf
#   device triggers       per key: button_short_press / button_long_press
#   sensor "Illuminance"  lux of the light sensor (tsx-als. Only with
#                         /etc/tsx/als.conf or /run/tsx/als.state)
#   switch "Auto brightness"  tsx-als auto on|off
#   sensor "eMMC life used A/B", "eMMC end of life"  (diagnostic. Only with
#                         /run/tsx/emmc.state, which tsx-emmc-state writes)
#   number "Volume"       0..100 % of the ALSA "Master" softvol (only when the
#                         sound card exists. /etc/asound.conf)
#   update "Update"       status of tsx-autoupdate (the installed and the
#                         latest release, the pending packages, restart
#                         required). Install runs "tsx-autoupdate now" in the
#                         background through tsx-panelctl (update-install)
#   binary_sensor "Restart required"  ON while installed packages wait for a
#                         restart (restart_required of the update state, else
#                         tsx-panelctl get restart-required)
#   button "Restart"      restarts the panel (tsx-panelctl send reboot)
#   select "Update mode"  auto or manual (tsx-panelctl get update-mode, send
#                         update-mode V). panel.conf UPDATE_MODE via tsx-config
#   switch "Automatic restart"  ON = the panel restarts by itself after an
#                         update that needs it (tsx-panelctl get auto-restart,
#                         send auto-restart on|off). panel.conf
#                         UPDATE_AUTO_RESTART via tsx-config
#   switch "Dark mode"    ON = the kiosk browser uses the dark color scheme
#                         (tsx-panelctl get dark-mode, send dark-mode on|off).
#                         panel.conf KIOSK_DARK via tsx-config. A change
#                         restarts the kiosk browser. Only where the panel
#                         runs the kiosk browser (tsx-panelctl has dark-mode)
#   sensor "Last boot"    the time of the last boot (device class timestamp,
#                         diagnostic). It changes at a reboot only.
# Sensor rate: Illuminance and Distance send a state only after a change beyond
# a deadband, at most once every THR_MIN_INTERVAL seconds, and again after
# THR_HEARTBEAT seconds when they did not change (see "Sensor rate" in
# docs/esphome.md). The numbers are the same as in the ESPHome shim.
# A value that Home Assistant sets (update mode, automatic restart, dark mode) shows at
# once and stays for 10 seconds, until the state of tsx-autoupdate has it.
# State and commands are under $BASE (default tsx/<hostname>). Availability
# uses LWT.
#
# Config /etc/tsx/mqtt.conf (empty BROKER = exit quietly). It needs
# mosquitto-clients.
# Key presses come from the "last" line of /run/tsx/buttons.state
# (tsx-buttons). Two identical presses within the same second are one event.
#
# This program is part of the Home Assistant layer (tsx-ha). It does not touch
# the hardware. Every command goes to the base system through tsx-panelctl
# (`tsx-panelctl send ...`), and so do the volume and the LED bar check
# (`tsx-panelctl get volume`, `tsx-panelctl has ledbar`). It reads the state
# files under /run/tsx, which are the event interface of the base system.
#
# Env overrides for tests: TSX_MQTT_CONF, TSX_RUN_DIR, TSX_IDLED_STATE,
# TSX_BUTTONS_CONF, TSX_BUTTONS_BOARD_CONF, TSX_KIOSK_CONF, TSX_PANELCTL_BIN, TSX_MQTT_DRY=1 (print
# instead of publish, read commands from stdin, one pass).
# In a dry run, the input line "tick" runs one pass of the main loop
# (publish_states with no force), TSX_PROC_UPTIME names another /proc/uptime
# and TSX_MQTT_NOW_FILE a file with the epoch seconds that replace the clock.
# TSX_MQTT_PUB_TIMEOUT=seconds limits each mosquitto_pub connect+publish
# (default 5), so an unreachable broker cannot hang the script. See pub()
# and the stop trap below.
set -u
CONF=${TSX_MQTT_CONF:-/etc/tsx/mqtt.conf}
R=${TSX_RUN_DIR:-/run/tsx}
IDLED=${TSX_IDLED_STATE:-/run/tsx-idled.state}
BCONF=${TSX_BUTTONS_CONF:-/etc/tsx/buttons.conf}
BBCONF=${TSX_BUTTONS_BOARD_CONF:-/etc/tsx/buttons-board.conf}   # the board layer of the keys
KCONF=${TSX_KIOSK_CONF:-/etc/kiosk.conf}
ACONF=${TSX_ALS_CONF:-/etc/tsx/als.conf}
. "${TSX_BOARD_CONF:-/usr/local/lib/tsx/board.sh}"
# presence_kind: the one rule that maps PRESENCE of hw.conf to no, tof or pir.
# It is in tsx-base: /usr/local/lib/tsx on the panel, base/ in a checkout.
PKIND=${TSX_PRESENCE_KIND_SH:-/usr/local/lib/tsx/presence-kind.sh}
[ -r "$PKIND" ] || PKIND=$(dirname "$0")/../../../../base/usr/local/lib/tsx/presence-kind.sh
if [ -r "$PKIND" ]; then
	. "$PKIND"
else
	# A rootfs without the helper file keeps the rule of presence-kind.sh, the
	# authority: pir, tof and yes, and everything else is no (no warning)
	presence_kind() { [ "${1:-}" = -q ] && shift; case "${1:-}" in pir) echo pir;; tof|yes) echo tof;; *) echo no;; esac; }
fi
HWCONF=${TSX_HW_CONF:-$R/hw.conf}
PCTL=${TSX_PANELCTL_BIN:-tsx-panelctl}   # the hardware interface of the base system
DRY=${TSX_MQTT_DRY:-0}
PUBTO=${TSX_MQTT_PUB_TIMEOUT:-5}
LASTPUBOK=1   # 0 after a publish fails or times out. The stop trap then skips the LWT offline publish

BROKER= PORT=1883 USER= PASSWORD= CAFILE= DISCOVERY_PREFIX=homeassistant NODE_ID= BASE_TOPIC= DEVICE_NAME=
[ -r "$CONF" ] && . "$CONF"
# panel.conf overrides (MQTT_HOST/PORT/USER/PASSWORD through `tsx-config apply`).
# They have the same precedence as /etc/kiosk.conf + /run/tsx/kiosk.conf in
# kiosk-session -- the header of tsx-config
[ -r "$R/mqtt.conf" ] && . "$R/mqtt.conf"
if [ -z "$BROKER" ] && [ "$DRY" != 1 ]; then
	echo "tsx-mqtt: BROKER not set in $CONF, nothing to do"; exit 0
fi
command -v mosquitto_pub >/dev/null || [ "$DRY" = 1 ] || { echo "tsx-mqtt: mosquitto_pub missing (apk add mosquitto-clients)"; exit 1; }

# Sensor rate. The same numbers as ha/voice/shim/tsx_panel/throttle.py.
THR_MIN_INTERVAL=60     # seconds: at most one state for a throttled sensor in this time
THR_HEARTBEAT=900       # seconds: the same state again when the sensor did not change
THR_ILLUMINANCE_ABS=5   # lux
THR_ILLUMINANCE_REL=0.10   # 10 % of the last state that went out. The larger of the two counts.
THR_DISTANCE=50         # millimeters
BOOT_JITTER=30          # seconds: Last boot changes only when the new value differs by this much
UPTIME_FILE=${TSX_PROC_UPTIME:-/proc/uptime}

HOST=$(hostname)
NODE=$(printf '%s' "${NODE_ID:-$HOST}" | tr -c 'A-Za-z0-9_-' '_')
BASE=${BASE_TOPIC:-tsx/$NODE}
DP=$DISCOVERY_PREFIX
DNAME=${DEVICE_NAME:-TSX $HOST}
M=$R/mqtt
mkdir -p "$M" && chmod 700 "$M"
log() { echo "$(date '+%F %T') tsx-mqtt: $*"; }
# an unknown PRESENCE in hw.conf counts as no: say it once
presence_kind "$(sed -n 's/^PRESENCE=//p' "$HWCONF" 2>/dev/null | tail -n 1)" 2>&1 >/dev/null | while IFS= read -r w; do log "$w"; done

# Put the mosquitto client options in files (XDG_CONFIG_HOME), not on the command line.
export XDG_CONFIG_HOME=$M
{
	echo "-h $BROKER"; echo "-p $PORT"
	[ -n "$USER" ] && echo "-u $USER"
	[ -n "$PASSWORD" ] && echo "-P $PASSWORD"
	[ -n "$CAFILE" ] && echo "--cafile $CAFILE"
} > "$M/mosquitto_pub"
cp "$M/mosquitto_pub" "$M/mosquitto_sub"
chmod 600 "$M/mosquitto_pub" "$M/mosquitto_sub"

pub() {  # pub [-r] TOPIC PAYLOAD
	r=; [ "$1" = -r ] && { r=-r; shift; }
	# dry run: printf, not echo (echo of ash turns a \n of the JSON into a newline)
	if [ "$DRY" = 1 ]; then printf 'PUB%s %s %s\n' "${r:+ (retained)}" "$1" "$2"; return 0; fi
	# setsid + timeout limit connect+publish to $PUBTO seconds, even with an
	# unreachable broker. setsid puts mosquitto_pub in its own process group
	# (pgid = pid of timeout). The stop trap can then kill both with one
	# signal, and mosquitto_pub does not stay orphaned in mid-connect.
	setsid timeout "$PUBTO" mosquitto_pub -i "$NODE-pub-$$" -q 1 $r -t "$1" -m "$2" &
	pp=$!
	echo "$pp" >> "$M/pub.pids"
	wait "$pp"; rc=$?
	sed -i "/^${pp}\$/d" "$M/pub.pids" 2>/dev/null
	if [ $rc -eq 0 ]; then LASTPUBOK=1; else LASTPUBOK=0; log "publish $1 failed"; fi
	return $rc
}

# ---- helpers ---------------------------------------------------------------
# hardware only some panels have: an entity is announced only when it is
# there, and its discovery topic is cleared otherwise (so Home Assistant
# drops an entity an older build announced)
has_ledbar() { "$PCTL" has ledbar >/dev/null 2>&1; }
has_sound() { "$PCTL" has sound >/dev/null 2>&1; }
has_keyleds() { "$PCTL" has keyleds >/dev/null 2>&1; }
has_als() { [ -r "$ACONF" ] || [ -r "$R/als.state" ]; }
# The kind of the presence sensor: PRESENCE of hw.conf (no, tof or pir)
pres_kind() { presence_kind -q "$(sed -n 's/^PRESENCE=//p' "$HWCONF" 2>/dev/null | tail -n 1)"; }
has_presence() { [ -r "$R/presence.state" ] && [ "$(pres_kind)" != no ]; }
# the distance: a tof sensor only. A pir sensor sees motion and no distance.
has_distance() { has_presence && [ "$(pres_kind)" = tof ]; }
has_usbpower() { [ -r "$R/usb-power.state" ]; }
has_poe() { [ -r "$R/poe.state" ]; }
has_emmc() { [ -r "$R/emmc.state" ]; }
has_nfc() { "$PCTL" has nfc >/dev/null 2>&1; }
# thr_check NAME VALUE ABS REL: the rate limit of a sensor. VALUE is a number or "none".
# It prints what to send and succeeds, or it prints nothing and fails. The state
# of the sensor is in the file $M/thr.NAME ("VALUE UPTIME-SECONDS" of the last
# state that went out). The clock is the uptime, so a step of the wall clock does
# not matter. Rules, as in throttle.py: the first value goes out at once. A value
# goes out when THR_MIN_INTERVAL passed and it differs from the last state by more
# than the larger of ABS and REL times the last state. The last state goes out
# again after THR_HEARTBEAT.
thr_check() {
	tn=$1; tv=$2
	tl= tt=
	[ -r "$M/thr.$tn" ] && read -r tl tt < "$M/thr.$tn"
	tnow=$(cut -d' ' -f1 "$UPTIME_FILE" 2>/dev/null); tnow=${tnow%%.*}
	case $tnow in ''|*[!0-9]*) tnow=0;; esac
	tr=$(awk -v v="$tv" -v lv="$tl" -v lt="$tt" -v now="$tnow" -v a="$3" -v r="$4" -v mi="$THR_MIN_INTERVAL" -v hb="$THR_HEARTBEAT" 'BEGIN {
		if (lt == "") { print "new"; exit }
		age = now - lt
		if (age < 0) { print "new"; exit }
		if (age >= mi) {
			if ((v == "none") != (lv == "none")) { print "new"; exit }
			if (v != "none") {
				d = v - lv; if (d < 0) d = -d
				th = lv < 0 ? -lv : lv; th = th * r; if (th < a) th = a
				if (d > th) { print "new"; exit }
			}
		}
		if (age >= hb) { print "again"; exit }
		print "hold" }')
	case $tr in
	new) echo "$tv $tnow" > "$M/thr.$tn"; echo "$tv";;
	again) echo "$tl $tnow" > "$M/thr.$tn"; echo "$tl";;
	*) return 1;;
	esac
}
# thr_reset NAME VALUE: the value went out with a forced publish. Count it as sent.
thr_reset() {
	tnow=$(cut -d' ' -f1 "$UPTIME_FILE" 2>/dev/null); tnow=${tnow%%.*}
	case $tnow in ''|*[!0-9]*) tnow=0;; esac
	echo "$2 $tnow" > "$M/thr.$1"
}

# last_boot_state: the time of the last boot, ISO 8601 in UTC. It is the clock minus
# the uptime. The kept value stays while the new one differs by less than
# BOOT_JITTER seconds, so the text does not change by a second between two reports.
last_boot_state() {
	lb_up=$(cut -d' ' -f1 "$UPTIME_FILE" 2>/dev/null); lb_up=${lb_up%%.*}
	case $lb_up in ''|*[!0-9]*) return 0;; esac
	if [ -n "${TSX_MQTT_NOW_FILE:-}" ]; then read -r lb_now < "$TSX_MQTT_NOW_FILE" || lb_now=0; else lb_now=$(date +%s); fi
	lb_raw=$(( lb_now - lb_up ))
	lb_k=; [ -r "$M/boot.kept" ] && read -r lb_k < "$M/boot.kept"
	case $lb_k in *[!0-9]*) lb_k=;; esac
	if [ -n "$lb_k" ]; then
		lb_d=$(( lb_raw - lb_k )); [ "$lb_d" -ge 0 ] || lb_d=$(( -lb_d ))
		[ "$lb_d" -ge "$BOOT_JITTER" ] && lb_k=
	fi
	if [ -z "$lb_k" ]; then lb_k=$lb_raw; echo "$lb_k" > "$M/boot.kept"; fi
	date -u -d "@$lb_k" '+%Y-%m-%dT%H:%M:%S+00:00'
}

has_dark() { "$PCTL" has dark-mode >/dev/null 2>&1; }

keys() {  # names of the "button NAME KEY" lines of the board layer and buttons.conf, each name once
	cat "$BBCONF" "$BCONF" 2>/dev/null | sed -n 's/^[[:space:]]*button[[:space:]]\{1,\}\([A-Za-z0-9_-]\{1,\}\)[[:space:]].*/\1/p' | awk '!seen[$0]++'
}

field() {  # field FILE KEY -> rest of the first line "KEY ..."
	[ -r "$1" ] && sed -n "s/^$2 //p" "$1" | head -1
}

# ---- discovery ---------------------------------------------------------------
# The model name of Home Assistant: tsx_board_ha_model of the board file if
# it has one, else TSX_HA_MODEL.
MODEL=; type tsx_board_ha_model >/dev/null 2>&1 && MODEL=$(tsx_board_ha_model)
DEV="\"dev\":{\"ids\":[\"tsx_$NODE\"],\"name\":\"$DNAME\",\"mf\":\"Crestron\",\"mdl\":\"${MODEL:-$TSX_HA_MODEL} (mainline Linux)\"}"
AV="\"avty_t\":\"$BASE/availability\""

# The LED bar light: announced while a bar is attached (has_ledbar), cleared
# otherwise. P_BAR is yes or no: what Home Assistant has now. P_FXL is the list
# of effects that the light announces (JSON, empty for a bar without effects).
P_BAR= P_FXL=
ledbar_discovery() {
	P_FXL= fxj=
	if has_ledbar; then
		P_BAR=yes
		if "$PCTL" has ledbar-fx >/dev/null 2>&1; then
			P_FXL='"None","Breathe","Blink","Rainbow"'
			"$PCTL" has ledbar-leds >/dev/null 2>&1 && P_FXL="$P_FXL,\"Chase\",\"Fill\",\"Spectrum\""
			fxj=",\"fx_cmd_t\":\"$BASE/ledbar/effect/set\",\"fx_stat_t\":\"$BASE/ledbar/effect\",\"fx_list\":[$P_FXL]"
		fi
		pub -r "$DP/light/$NODE/ledbar/config" "{\"name\":\"LED bar\",\"uniq_id\":\"${NODE}_ledbar\",\"cmd_t\":\"$BASE/ledbar/set\",\"stat_t\":\"$BASE/ledbar/state\",\"bri_cmd_t\":\"$BASE/ledbar/brightness/set\",\"bri_stat_t\":\"$BASE/ledbar/brightness\",\"bri_scl\":255,\"rgb_cmd_t\":\"$BASE/ledbar/rgb/set\",\"rgb_stat_t\":\"$BASE/ledbar/rgb\",\"on_cmd_type\":\"last\"$fxj,\"icon\":\"mdi:led-strip-variant\",$AV,$DEV}"
	else
		P_BAR=no
		pub -r "$DP/light/$NODE/ledbar/config" ""
	fi
}

discovery() {
	if has_ledbar; then
		P_BAR=yes
		pub -r "$DP/light/$NODE/ledbar/config" "{\"name\":\"LED bar\",\"uniq_id\":\"${NODE}_ledbar\",\"cmd_t\":\"$BASE/ledbar/set\",\"stat_t\":\"$BASE/ledbar/state\",\"bri_cmd_t\":\"$BASE/ledbar/brightness/set\",\"bri_stat_t\":\"$BASE/ledbar/brightness\",\"bri_scl\":255,\"rgb_cmd_t\":\"$BASE/ledbar/rgb/set\",\"rgb_stat_t\":\"$BASE/ledbar/rgb\",\"on_cmd_type\":\"last\",\"icon\":\"mdi:led-strip-variant\",$AV,$DEV}"
	else
		P_BAR=no
		pub -r "$DP/light/$NODE/ledbar/config" ""
	fi
}

discovery() {
	ledbar_discovery
	if has_keyleds; then pub -r "$DP/light/$NODE/key_leds/config" "{\"name\":\"Key LEDs\",\"uniq_id\":\"${NODE}_key_leds\",\"cmd_t\":\"$BASE/key_leds/set\",\"stat_t\":\"$BASE/key_leds/state\",\"bri_cmd_t\":\"$BASE/key_leds/brightness/set\",\"bri_stat_t\":\"$BASE/key_leds/brightness\",\"bri_scl\":255,\"on_cmd_type\":\"brightness\",\"icon\":\"mdi:gesture-tap-button\",$AV,$DEV}"
	else pub -r "$DP/light/$NODE/key_leds/config" ""; fi
	pub -r "$DP/switch/$NODE/screen/config" "{\"name\":\"Screen\",\"uniq_id\":\"${NODE}_screen\",\"cmd_t\":\"$BASE/screen/set\",\"stat_t\":\"$BASE/screen/state\",\"icon\":\"mdi:monitor\",$AV,$DEV}"
	pub -r "$DP/number/$NODE/backlight/config" "{\"name\":\"Backlight\",\"uniq_id\":\"${NODE}_backlight\",\"cmd_t\":\"$BASE/backlight/set\",\"stat_t\":\"$BASE/backlight/state\",\"min\":1,\"max\":100,\"step\":1,\"unit_of_meas\":\"%\",\"mode\":\"slider\",\"icon\":\"mdi:brightness-6\",$AV,$DEV}"
	pub -r "$DP/number/$NODE/blank_timeout/config" "{\"name\":\"Blank timeout\",\"uniq_id\":\"${NODE}_blank_timeout\",\"cmd_t\":\"$BASE/blank_timeout/set\",\"stat_t\":\"$BASE/blank_timeout/state\",\"min\":0,\"max\":86400,\"step\":10,\"unit_of_meas\":\"s\",\"mode\":\"box\",\"icon\":\"mdi:timer-outline\",$AV,$DEV}"
	pub -r "$DP/binary_sensor/$NODE/touched_recently/config" "{\"name\":\"Touched recently\",\"uniq_id\":\"${NODE}_touched_recently\",\"stat_t\":\"$BASE/touched_recently/state\",\"dev_cla\":\"motion\",\"icon\":\"mdi:gesture-tap\",$AV,$DEV}"
	if has_als; then
		pub -r "$DP/sensor/$NODE/illuminance/config" "{\"name\":\"Illuminance\",\"uniq_id\":\"${NODE}_illuminance\",\"stat_t\":\"$BASE/als/lux\",\"dev_cla\":\"illuminance\",\"unit_of_meas\":\"lx\",\"stat_cla\":\"measurement\",$AV,$DEV}"
		pub -r "$DP/switch/$NODE/als_auto/config" "{\"name\":\"Auto brightness\",\"uniq_id\":\"${NODE}_als_auto\",\"cmd_t\":\"$BASE/als_auto/set\",\"stat_t\":\"$BASE/als_auto/state\",\"icon\":\"mdi:brightness-auto\",$AV,$DEV}"
	fi
	if has_sound; then
		pub -r "$DP/number/$NODE/volume/config" "{\"name\":\"Volume\",\"uniq_id\":\"${NODE}_volume\",\"cmd_t\":\"$BASE/volume/set\",\"stat_t\":\"$BASE/volume/state\",\"min\":0,\"max\":100,\"step\":1,\"unit_of_meas\":\"%\",\"mode\":\"slider\",\"icon\":\"mdi:volume-high\",$AV,$DEV}"
	fi
	if has_presence; then
		pub -r "$DP/binary_sensor/$NODE/presence/config" "{\"name\":\"Presence\",\"uniq_id\":\"${NODE}_presence\",\"stat_t\":\"$BASE/presence/state\",\"dev_cla\":\"occupancy\",\"icon\":\"mdi:account-eye\",$AV,$DEV}"
	fi
	if has_distance; then
		pub -r "$DP/sensor/$NODE/distance/config" "{\"name\":\"Distance\",\"uniq_id\":\"${NODE}_distance\",\"stat_t\":\"$BASE/presence/distance\",\"val_tpl\":\"{{ none if value == 'none' else value | int }}\",\"dev_cla\":\"distance\",\"unit_of_meas\":\"mm\",\"stat_cla\":\"measurement\",\"icon\":\"mdi:ruler\",$AV,$DEV}"
	elif has_presence; then
		# a pir sensor: clear a distance sensor that an older build announced
		pub -r "$DP/sensor/$NODE/distance/config" ""
	fi
	if has_usbpower; then
		pub -r "$DP/switch/$NODE/usb_power/config" "{\"name\":\"USB power\",\"uniq_id\":\"${NODE}_usb_power\",\"cmd_t\":\"$BASE/usb_power/set\",\"stat_t\":\"$BASE/usb_power/state\",\"icon\":\"mdi:usb-port\",$AV,$DEV}"
	fi
	if has_poe; then
		pub -r "$DP/sensor/$NODE/poe_class/config" "{\"name\":\"PoE class\",\"uniq_id\":\"${NODE}_poe_class\",\"stat_t\":\"$BASE/poe/class\",\"ent_cat\":\"diagnostic\",\"icon\":\"mdi:ethernet-cable\",$AV,$DEV}"
	fi
	if has_emmc; then
		for w in a b; do
			W=$(printf '%s' $w | tr a-z A-Z)
			pub -r "$DP/sensor/$NODE/emmc_life_$w/config" "{\"name\":\"eMMC life used $W\",\"uniq_id\":\"${NODE}_emmc_life_$w\",\"stat_t\":\"$BASE/emmc/life_$w\",\"val_tpl\":\"{{ none if value == 'none' else value | int }}\",\"unit_of_meas\":\"%\",\"stat_cla\":\"measurement\",\"ent_cat\":\"diagnostic\",\"icon\":\"mdi:harddisk\",$AV,$DEV}"
		done
		pub -r "$DP/sensor/$NODE/emmc_eol/config" "{\"name\":\"eMMC end of life\",\"uniq_id\":\"${NODE}_emmc_eol\",\"stat_t\":\"$BASE/emmc/eol\",\"ent_cat\":\"diagnostic\",\"icon\":\"mdi:harddisk-remove\",$AV,$DEV}"
	fi
	if has_nfc; then
		pub -r "$DP/tag/$NODE/nfc/config" "{\"topic\":\"$BASE/nfc/tag_id\",\"value_template\":\"{{ value }}\",$DEV}"
		pub -r "$DP/event/$NODE/nfc_tag/config" "{\"name\":\"NFC tag\",\"uniq_id\":\"${NODE}_nfc_tag\",\"stat_t\":\"$BASE/nfc/tag\",\"evt_typ\":[\"scanned\"],\"icon\":\"mdi:nfc-variant\",$AV,$DEV}"
	fi
	pub -r "$DP/update/$NODE/update/config" "{\"name\":\"Update\",\"uniq_id\":\"${NODE}_update\",\"cmd_t\":\"$BASE/update/set\",\"stat_t\":\"$BASE/update/state\",\"icon\":\"mdi:package-up\",$AV,$DEV}"
	pub -r "$DP/binary_sensor/$NODE/restart_required/config" "{\"name\":\"Restart required\",\"uniq_id\":\"${NODE}_restart_required\",\"stat_t\":\"$BASE/restart_required/state\",\"icon\":\"mdi:restart-alert\",$AV,$DEV}"
	pub -r "$DP/button/$NODE/restart/config" "{\"name\":\"Restart\",\"uniq_id\":\"${NODE}_restart\",\"cmd_t\":\"$BASE/restart/set\",\"pl_prs\":\"PRESS\",\"icon\":\"mdi:restart\",$AV,$DEV}"
	pub -r "$DP/select/$NODE/update_mode/config" "{\"name\":\"Update mode\",\"uniq_id\":\"${NODE}_update_mode\",\"cmd_t\":\"$BASE/update_mode/set\",\"stat_t\":\"$BASE/update_mode/state\",\"options\":[\"auto\",\"manual\"],\"icon\":\"mdi:update\",$AV,$DEV}"
	pub -r "$DP/switch/$NODE/auto_restart/config" "{\"name\":\"Automatic restart\",\"uniq_id\":\"${NODE}_auto_restart\",\"cmd_t\":\"$BASE/auto_restart/set\",\"stat_t\":\"$BASE/auto_restart/state\",\"icon\":\"mdi:restart\",$AV,$DEV}"
	HAS_DARK=0
	pub -r "$DP/sensor/$NODE/last_boot/config" "{\"name\":\"Last boot\",\"uniq_id\":\"${NODE}_last_boot\",\"stat_t\":\"$BASE/last_boot/state\",\"dev_cla\":\"timestamp\",\"ent_cat\":\"diagnostic\",\"icon\":\"mdi:restart\",$AV,$DEV}"
	if has_dark; then
		HAS_DARK=1
		pub -r "$DP/switch/$NODE/dark_mode/config" "{\"name\":\"Dark mode\",\"uniq_id\":\"${NODE}_dark_mode\",\"cmd_t\":\"$BASE/dark_mode/set\",\"stat_t\":\"$BASE/dark_mode/state\",\"icon\":\"mdi:theme-light-dark\",$AV,$DEV}"
	else
		pub -r "$DP/switch/$NODE/dark_mode/config" ""
	fi
	for k in $(keys); do
		pub -r "$DP/event/$NODE/key_$k/config" "{\"name\":\"Key $k\",\"uniq_id\":\"${NODE}_key_$k\",\"stat_t\":\"$BASE/key/$k\",\"evt_typ\":[\"short\",\"long\",\"hold\"],\"dev_cla\":\"button\",$AV,$DEV}"
		pub -r "$DP/device_automation/$NODE/key_${k}_short/config" "{\"atype\":\"trigger\",\"t\":\"$BASE/trigger/$k/short\",\"type\":\"button_short_press\",\"stype\":\"$k\",\"pl\":\"short\",$DEV}"
		pub -r "$DP/device_automation/$NODE/key_${k}_long/config" "{\"atype\":\"trigger\",\"t\":\"$BASE/trigger/$k/long\",\"type\":\"button_long_press\",\"stype\":\"$k\",\"pl\":\"long\",$DEV}"
	done
}

# ---- state -----------------------------------------------------------------
# LED bar: panel keeps "want R G B" (0..100). HA sees rgb (max channel 255) + brightness.
# While the bar is off, HA sees "last R G B", the last color that was not black, so
# the brightness and the color are not lost. A turn on without a value restores them.
# While an effect of the bar firmware runs, HA sees the color of the effect (the effect
# does not change "want"), and the name of the effect as a fourth word.

# ledbar_fx: the effect that runs on the bar (ledbar.state "fx NAME N... [WORD]"),
# as "NAME R G B" with R G B 0..100 as the bar shows them, or nothing when no
# effect runs. Rainbow and spectrum have no color of their own: the bar shows
# white at their level, so they give "NAME L L L".
ledbar_fx() {
	set -- $(field "$R/ledbar.state" fx)
	fx_n=${1:-}; [ -n "$fx_n" ] || return 0
	shift
	fx_nums=
	for fx_x in "$@"; do case $fx_x in ''|*[!0-9]*) ;; *) fx_nums="$fx_nums $fx_x";; esac; done
	set -- $fx_nums
	case $fx_n in
	fade|breathe|blink|chase) [ $# -ge 3 ] && echo "$fx_n $1 $2 $3";;
	fill) [ $# -ge 4 ] && echo "$fx_n $(( ($1 * $4 + 50) / 100 )) $(( ($2 * $4 + 50) / 100 )) $(( ($3 * $4 + 50) / 100 ))";;
	rainbow|spectrum) fx_l=100; [ $# -ge 2 ] && fx_l=$2; echo "$fx_n $fx_l $fx_l $fx_l";;
	esac
	return 0
}

ledbar_state() {
	fxl=$(ledbar_fx); fxn=None; hue=
	w=$(field "$R/ledbar.state" want); [ -n "$w" ] || w="0 0 0"
	if [ -n "$fxl" ]; then
		set -- $fxl; w="$2 $3 $4"
		case $1 in
		breathe) fxn=Breathe;; blink) fxn=Blink;; chase) fxn=Chase;; fill) fxn=Fill;;
		rainbow) fxn=Rainbow hue=1;; spectrum) fxn=Spectrum hue=1;;
		esac
	fi
	set -- $w
	mx=$1; [ "$2" -gt "$mx" ] && mx=$2; [ "$3" -gt "$mx" ] && mx=$3
	if [ "$mx" -gt 0 ]; then
		rgb="$(( ($1 * 255 + mx / 2) / mx )),$(( ($2 * 255 + mx / 2) / mx )),$(( ($3 * 255 + mx / 2) / mx ))"
		# rainbow and spectrum keep the color of Home Assistant (the bar shows white)
		[ -z "$hue" ] || { rgb=$(cat "$M/rgb" 2>/dev/null); [ -n "$rgb" ] || rgb=255,255,255; }
		echo "ON $(( (mx * 255 + 50) / 100 )) $rgb $fxn"
		return
	fi
	w=$(field "$R/ledbar.state" last)
	case $w in ''|*[!0-9\ ]*) w="0 0 0";; esac
	set -- $w
	[ $# -eq 3 ] || set -- 0 0 0
	mx=$1; [ "$2" -gt "$mx" ] && mx=$2; [ "$3" -gt "$mx" ] && mx=$3
	if [ "$mx" -gt 0 ]; then
		echo "OFF $(( (mx * 255 + 50) / 100 )) $(( ($1 * 255 + mx / 2) / mx )),$(( ($2 * 255 + mx / 2) / mx )),$(( ($3 * 255 + mx / 2) / mx )) None"
	else
		echo "OFF 0 0,0,0 None"
	fi
}
key_leds_state() {  # the level while the screen is awake. An older tsx-buttons: the level now
	l=$(field "$R/buttons.state" led_awake); [ -n "$l" ] || l=$(field "$R/buttons.state" led); set -- ${l:-0 unknown}
	[ "${1:-0}" -gt 0 ] 2>/dev/null && echo "ON $1" || echo "OFF 0"
}
screen_state() {
	s=; [ -r "$IDLED" ] && read -r s lvl < "$IDLED"
	if [ "$s" = blank ]; then echo "OFF"; else echo "ON ${lvl:-}"; fi
}

blank_timeout_state() {  # seconds: tsx-config's runtime file, else kiosk.conf
	v=; [ -r "$R/blank-timeout" ] && read -r v _ < "$R/blank-timeout"
	case $v in ''|*[!0-9]*) v=$([ -r "$KCONF" ] && sed -n 's/^BLANK_TIMEOUT=\([0-9][0-9]*\).*/\1/p' "$KCONF" | tail -1);; esac
	echo "${v:-300}"
}

touched_state() {  # ON while tsx-idled saw real input in the last 30 s
	l=; [ -r "$R/last-input" ] && read -r l _ < "$R/last-input"
	case $l in ''|*[!0-9]*) echo OFF; return;; esac
	[ $(( $(date +%s) - l )) -lt 30 ] && echo ON || echo OFF
}

als_state() {  # "LUX ON|OFF" from tsx-als (lux with a reporting deadband)
	l=$(field "$R/als.state" report); a=$(field "$R/als.state" auto)
	[ -n "$l" ] && echo "$l $( [ "$a" = on ] && echo ON || echo OFF)"
}

presence_state() {  # "ON|OFF DISTANCE|none"
	p=$(field "$R/presence.state" present); d=$(field "$R/presence.state" distance)
	[ -n "$p" ] && echo "$( [ "$p" = on ] && echo ON || echo OFF) ${d:-none}"
}

usb_state() { p=$(field "$R/usb-power.state" power); [ -n "$p" ] && { [ "$p" = on ] && echo ON || echo OFF; }; }

poe_state() {
	c=$(field "$R/poe.state" class)
	case $c in plus) echo "PoE+ (802.3at)";; standard) echo "PoE (802.3af)";; *) [ -n "$c" ] && echo unknown;; esac
}

emmc_life() {  # emmc_life a|b -> percent (upper bound of the JEDEC band), or none
	c=$(field "$R/emmc.state" "life_$1")
	case $c in 0x0[1-9]) echo $(( ${c#0x0} * 10 ));; 0x0[aA]) echo 100;; 0x0[bB]) echo 110;; *) echo none;; esac
}
emmc_state() {  # "LIFE_A LIFE_B EOL"
	e=$(field "$R/emmc.state" eol)
	case $e in 0x01) e=normal;; 0x02) e=warning;; 0x03) e=urgent;; *) e=unknown;; esac
	echo "$(emmc_life a) $(emmc_life b) $e"
}

# backlight_key: BLK gets what a new backlight percent can come with, read
# with shell built-ins (no process): the override that waits for the wake
# ($R/brightness) and the backlight of the panel app. The level of a lit
# screen is in the screen state.
backlight_key() {
	bk1=; [ -r "$R/brightness" ] && read -r bk1 _ < "$R/brightness"
	bk2=
	if [ -r "$R/panel-app/screen.state" ]; then
		while read -r bk_k bk_v; do [ "$bk_k" = backlight ] && { bk2=$bk_v; break; }; done < "$R/panel-app/screen.state"
	fi
	BLK=$bk1/$bk2
}

backlight_pct_state() {  # 1..100, the percent of the slider, or nothing
	v=$("$PCTL" get backlight-pct 2>/dev/null) || v=
	case $v in ''|*[!0-9]*) return 0;; esac
	[ "$v" -ge 1 ] && [ "$v" -le 100 ] && echo "$v"
	return 0
}

volume_state() {  # "NN" percent of the speaker volume
	"$PCTL" get volume 2>/dev/null || true
}

update_state() {  # raw HA-ready JSON from tsx-autoupdate (same $R), or a safe default
	if [ -r "$R/update-ha-state.json" ]; then cat "$R/update-ha-state.json"
	else echo '{"installed_version":"unknown","latest_version":"unknown","title":"TSX packages","release_summary":"tsx-autoupdate has not run yet","in_progress":false,"restart_required":false,"mode":"auto","auto_restart":true}'
	fi
}

# update_json_field KEY: the value of one key at the end of the update JSON
# (restart_required, mode, auto_restart). A text value stops at a quote. The
# last match counts, so a word in the release summary does not.
update_json_field() {
	update_state | sed -n 's/.*"'"$1"'": *"\{0,1\}\([A-Za-z0-9_-]\{1,\}\).*/\1/p' | head -n 1
}

restart_required_state() {  # ON or OFF
	v=$(update_json_field restart_required)
	case $v in true) echo ON; return;; false) echo OFF; return;; esac
	[ "$("$PCTL" get restart-required 2>/dev/null)" = yes ] && echo ON || echo OFF
}

update_mode_state() {  # auto or manual
	v=$("$PCTL" get update-mode 2>/dev/null | head -n 1)
	case $v in auto|manual) echo "$v"; return;; esac
	v=$(update_json_field mode)
	case $v in auto|manual) echo "$v";; *) echo auto;; esac
}

dark_mode_state() {  # ON or OFF
	case $("$PCTL" get dark-mode 2>/dev/null | head -n 1) in on) echo ON;; *) echo OFF;; esac
}

auto_restart_state() {  # ON or OFF
	v=$("$PCTL" get auto-restart 2>/dev/null | head -n 1)
	case $v in on) echo ON; return;; off) echo OFF; return;; esac
	v=$(update_json_field auto_restart)
	case $v in false) echo OFF;; *) echo ON;; esac
}

# A value that Home Assistant sets: update_hold_set NAME VALUE keeps it, and
# update_hold NAME CURRENT prints it instead of CURRENT for 10 seconds while
# CURRENT is another value (tsx-autoupdate has not written the new value yet).
# The files are in $M, because handle runs in a subshell.
update_hold_set() { echo "$2 $(date +%s)" > "$M/hold.$1"; }
update_hold() {
	hv= ht=
	[ -r "$M/hold.$1" ] && read -r hv ht < "$M/hold.$1"
	case $ht in ''|*[!0-9]*) rm -f "$M/hold.$1"; echo "$2"; return;; esac
	if [ "$hv" != "$2" ] && [ $(( $(date +%s) - ht )) -lt 10 ]; then echo "$hv"
	else rm -f "$M/hold.$1"; echo "$2"; fi
}

P_LED= P_KL= P_SCR= P_BL= P_BLK= P_ALS= P_VOL= P_UPD= P_BT= P_TR= P_PRES= P_USB= P_POE= P_EMMC= P_RR= P_UM= P_AR= P_DK= P_ALSA= P_LB= HAS_DARK=0
publish_states() {  # $1 = force
	f=${1:-}
	if [ "$P_BAR" = yes ]; then
		v=$(ledbar_state); if [ "$v" != "$P_LED" ] || [ -n "${1:-}" ]; then
			set -- $v; pub -r "$BASE/ledbar/state" "$1"; pub -r "$BASE/ledbar/brightness" "$2"; pub -r "$BASE/ledbar/rgb" "$3"
			[ -z "$P_FXL" ] || pub -r "$BASE/ledbar/effect" "$4"
			P_LED=$v; fi
	fi
	v=$(key_leds_state); if [ "$v" != "$P_KL" ] || [ -n "${1:-}" ]; then
		set -- $v; pub -r "$BASE/key_leds/state" "$1"; pub -r "$BASE/key_leds/brightness" "$2"; P_KL=$v; fi
	# The backlight in percent (tsx-panelctl get backlight-pct): asked only when
	# the screen state, the waiting override or the panel app backlight changes.
	v=$(screen_state); backlight_key
	if [ "$v" != "$P_SCR" ] || [ "$BLK" != "$P_BLK" ] || [ -n "$f" ]; then
		if [ "$v" != "$P_SCR" ] || [ -n "$f" ]; then set -- $v; pub -r "$BASE/screen/state" "$1"; P_SCR=$v; fi
		P_BLK=$BLK
		v=$(backlight_pct_state)
		if [ -n "$v" ] && { [ "$v" != "$P_BL" ] || [ -n "$f" ]; }; then pub -r "$BASE/backlight/state" "$v"; P_BL=$v; fi
	fi
	v=$(blank_timeout_state); if [ "$v" != "$P_BT" ] || [ -n "${1:-}" ]; then
		pub -r "$BASE/blank_timeout/state" "$v"; P_BT=$v; fi
	v=$(touched_state); if [ "$v" != "$P_TR" ] || [ -n "${1:-}" ]; then
		pub -r "$BASE/touched_recently/state" "$v"; P_TR=$v; fi
	v=$(als_state); if [ -n "$v" ]; then
		set -- $v; al_lux=$1; al_auto=$2
		# the light sensor: the lux go through the rate limit, the switch goes out when it changes
		if [ -n "$f" ]; then thr_reset illuminance "$al_lux"; pub -r "$BASE/als/lux" "$al_lux"; P_ALS=$al_lux
		elif al_out=$(thr_check illuminance "$al_lux" "$THR_ILLUMINANCE_ABS" "$THR_ILLUMINANCE_REL"); then pub -r "$BASE/als/lux" "$al_out"; P_ALS=$al_out; fi
		if [ "$al_auto" != "$P_ALSA" ] || [ -n "$f" ]; then pub -r "$BASE/als_auto/state" "$al_auto"; P_ALSA=$al_auto; fi
	fi
	v=$(last_boot_state); if [ -n "$v" ] && { [ "$v" != "$P_LB" ] || [ -n "$f" ]; }; then
		pub -r "$BASE/last_boot/state" "$v"; P_LB=$v; fi
	v=$(volume_state); if [ -n "$v" ] && { [ "$v" != "$P_VOL" ] || [ -n "${1:-}" ]; }; then
		pub -r "$BASE/volume/state" "$v"; P_VOL=$v; fi
	if has_presence; then
		# presence goes out at once. The distance goes through the rate limit.
		v=$(presence_state); if [ -n "$v" ]; then
			set -- $v; pr_on=$1; pr_d=$2
			if [ "$pr_on" != "$P_PRES" ] || [ -n "$f" ]; then pub -r "$BASE/presence/state" "$pr_on"; P_PRES=$pr_on; fi
			if has_distance; then
				if [ -n "$f" ]; then thr_reset distance "$pr_d"; pub -r "$BASE/presence/distance" "$pr_d"; P_PRESD=$pr_d
				elif pr_out=$(thr_check distance "$pr_d" "$THR_DISTANCE" 0); then pub -r "$BASE/presence/distance" "$pr_out"; P_PRESD=$pr_out; fi
			fi
		fi
	fi
	if has_usbpower; then
		v=$(usb_state); if [ -n "$v" ] && { [ "$v" != "$P_USB" ] || [ -n "$f" ]; }; then
			pub -r "$BASE/usb_power/state" "$v"; P_USB=$v; fi
	fi
	if has_poe; then
		v=$(poe_state); if [ -n "$v" ] && { [ "$v" != "$P_POE" ] || [ -n "$f" ]; }; then
			pub -r "$BASE/poe/class" "$v"; P_POE=$v; fi
	fi
	if has_emmc; then
		v=$(emmc_state); if [ "$v" != "$P_EMMC" ] || [ -n "$f" ]; then
			set -- $v; pub -r "$BASE/emmc/life_a" "$1"; pub -r "$BASE/emmc/life_b" "$2"; pub -r "$BASE/emmc/eol" "$3"; P_EMMC=$v; fi
	fi
	v=$(update_state); if [ "$v" != "$P_UPD" ] || [ -n "$f" ]; then
		pub -r "$BASE/update/state" "$v"; P_UPD=$v; fi
	v=$(restart_required_state); if [ "$v" != "$P_RR" ] || [ -n "$f" ]; then
		pub -r "$BASE/restart_required/state" "$v"; P_RR=$v; fi
	v=$(update_hold update_mode "$(update_mode_state)"); if [ "$v" != "$P_UM" ] || [ -n "$f" ]; then
		pub -r "$BASE/update_mode/state" "$v"; P_UM=$v; fi
	v=$(update_hold auto_restart "$(auto_restart_state)"); if [ "$v" != "$P_AR" ] || [ -n "$f" ]; then
		pub -r "$BASE/auto_restart/state" "$v"; P_AR=$v; fi
	if [ "$HAS_DARK" = 1 ]; then
		v=$(update_hold dark_mode "$(dark_mode_state)"); if [ "$v" != "$P_DK" ] || [ -n "$f" ]; then
			pub -r "$BASE/dark_mode/state" "$v"; P_DK=$v; fi
	fi
}

# The bar comes or goes: tsx-ledbard writes /run/tsx/ledbar.usb. It also writes
# /run/tsx/ledbar.fw, which says what the bar firmware can do (effects). When
# one of the two files changes, ask has_ledbar and the effect checks again. The
# light is then announced and its state published, or the discovery topic and the
# retained state are cleared. ledbar_stamp is what tells a change.
P_USBF=
ledbar_stamp() { head -n 1 "$R/ledbar.usb" 2>/dev/null; cat "$R/ledbar.fw" 2>/dev/null; }
check_ledbar() {
	v=$(ledbar_stamp)
	[ "$v" != "$P_USBF" ] || return 0
	P_USBF=$v
	old=$P_BAR$P_FXL
	ledbar_discovery
	[ "$P_BAR$P_FXL" != "$old" ] || return 0
	if [ "$P_BAR" = yes ]; then
		case $old in yes*) log "LED bar firmware changed: effects updated";; *) log "LED bar attached: light announced";; esac
		P_LED=; publish_states
	else
		log "LED bar gone: light cleared"
		pub -r "$BASE/ledbar/state" ""; pub -r "$BASE/ledbar/brightness" ""; pub -r "$BASE/ledbar/rgb" ""
		pub -r "$BASE/ledbar/effect" ""
		P_LED=
	fi
}

# ---- commands --------------------------------------------------------------
# HA rgb "r,g,b" 0..255 + brightness 0..255 -> bar 0..100 per channel
ledbar_set() {  # r g b bri
	"$PCTL" send ledbar set $(( ($1 * $4 * 100 + 32512) / 65025 )) $(( ($2 * $4 * 100 + 32512) / 65025 )) $(( ($3 * $4 * 100 + 32512) / 65025 ))
}
# An effect of the bar firmware in the color r g b (HA 0..255) at the brightness
# bri (0..255). The numbers are the ones of the ESPHome light (backend.py): one
# breath 4000 ms, blink 500 ms on and 500 off, one hue cycle 10000 ms, one run
# of the chase 1500 ms. Fill takes the color at full level, and the brightness
# is its height.
ledbar_fx_send() {  # NAME r g b bri
	fxlv=$(( ($5 * 100 + 127) / 255 ))
	fr=$(( ($2 * $5 * 100 + 32512) / 65025 )) fg=$(( ($3 * $5 * 100 + 32512) / 65025 )) fb=$(( ($4 * $5 * 100 + 32512) / 65025 ))
	case $1 in
	Breathe) "$PCTL" send ledbar fx breathe $fr $fg $fb 4000;;
	Blink) "$PCTL" send ledbar fx blink $fr $fg $fb 500 500;;
	Rainbow) "$PCTL" send ledbar fx rainbow 10000 $fxlv;;
	Chase) "$PCTL" send ledbar fx chase $fr $fg $fb 1500;;
	Fill) "$PCTL" send ledbar fx fill $(( ($2 * 100 + 127) / 255 )) $(( ($3 * 100 + 127) / 255 )) $(( ($4 * 100 + 127) / 255 )) $fxlv;;
	Spectrum) "$PCTL" send ledbar fx spectrum 10000 $fxlv;;
	esac
}
led_rgb() {  # the last rgb from HA, else the color of the bar (or its last color), else white
	c=$(cat "$M/rgb" 2>/dev/null)
	[ -n "$c" ] || { cur=$(ledbar_state); set -- $cur; c=$3; [ "$c" != 0,0,0 ] || c=255,255,255; }
	echo "$c"
}
split_rgb() { c=$1; r=${c%%,*}; c=${c#*,}; g=${c%%,*}; b=${c#*,}; }
led_bri() { b=$(cat "$M/bri" 2>/dev/null); echo "${b:-255}"; }

# A turn on from Home Assistant with a color and a brightness comes as separate
# messages: rgb/set, brightness/set, then set ON. HA sends the color at full
# level and the brightness apart. If each message ran its own command, the bar
# would show the color at full level first, and the scaled color after that.
# So rgb/set and brightness/set only store their value (led_queue). One command
# with the final color runs when no other message came for LED_WAIT seconds
# (led_apply). OFF and an effect cancel it (led_cancel). The files led.rgb and
# led.bri say which messages came, led.seq numbers the waits, and "pending" makes
# the ON that follows send nothing.
LED_WAIT=${TSX_MQTT_LED_WAIT:-0.2}
led_seq() { s=$(cat "$M/led.seq" 2>/dev/null); echo "${s:-0}"; }
led_queue() {  # rgb|bri
	: > "$M/led.$1"; : > "$M/pending"
	[ "$DRY" = 1 ] && return 0   # the dry run applies when the input has a pause (see the main part)
	led_n=$(( $(led_seq) + 1 )); echo "$led_n" > "$M/led.seq"
	# Not in the pipe of the handler: it must not hold up the next message.
	( sleep "$LED_WAIT"; [ "$(led_seq)" = "$led_n" ] && led_apply ) >/dev/null 2>&1 &
}
led_cancel() {
	rm -f "$M/led.rgb" "$M/led.bri"
	echo $(( $(led_seq) + 1 )) > "$M/led.seq"
}
led_apply() {
	[ -e "$M/led.rgb" ] || [ -e "$M/led.bri" ] || return 0
	led_hb=; [ -e "$M/led.bri" ] && led_hb=1
	rm -f "$M/led.rgb" "$M/led.bri"
	split_rgb "$(led_rgb)"
	bri=$(led_bri)
	if [ -z "$led_hb" ]; then
		# only a color came: it keeps the brightness of the bar
		cur=$(ledbar_state); set -- $cur
		[ "$1" = ON ] && bri=$2
		[ "$bri" -gt 0 ] || bri=255
	fi
	ledbar_set "$r" "$g" "$b" "$bri"
	: > "$M/poke"
}

handle() {  # topic payload
	t=${1#"$BASE"/}; p=$2
	# no bar attached, or LEDBAR=no: no LED bar command. This runs in a
	# subshell of the main loop, so it asks again.
	case $t in ledbar/*) has_ledbar || { log "ignored $t: no LED bar attached"; return; };; esac
	case $t in
	ledbar/set)
		case $p in
		OFF) rm -f "$M/pending"; led_cancel; "$PCTL" send ledbar off;;
		ON)  if [ -e "$M/pending" ]; then rm -f "$M/pending"
		     else
			cur=$(ledbar_state); [ "${cur%% *}" = ON ] || "$PCTL" send ledbar on
		     fi;;
		esac;;
	ledbar/brightness/set)
		case $p in *[!0-9]*|'') return;; esac
		echo "$p" > "$M/bri"; led_queue bri;;
	ledbar/rgb/set)
		split_rgb "$p"
		case "$r$g$b" in *[!0-9]*|'') return;; esac
		echo "$r,$g,$b" > "$M/rgb"; led_queue rgb;;
	ledbar/effect/set)
		# The color and the brightness are the last ones of Home Assistant (the
		# same turn on sent them first), else the ones of the bar now.
		case $p in
		None) led_apply; [ -z "$(ledbar_fx)" ] || "$PCTL" send ledbar fx off;;
		Breathe|Blink|Rainbow|Chase|Fill|Spectrum)
			case $p in
			Chase|Fill|Spectrum) "$PCTL" has ledbar-leds >/dev/null 2>&1 || { log "ignored effect $p: the LED bar firmware has no zone effects"; return; };;
			*) "$PCTL" has ledbar-fx >/dev/null 2>&1 || { log "ignored effect $p: the LED bar firmware has no effects"; return; };;
			esac
			led_cancel   # the effect has the color: no command with the plain color first
			split_rgb "$(led_rgb)"
			cur=$(ledbar_state); set -- $cur
			bri=$(led_bri); { [ "$1" = ON ] && [ ! -e "$M/pending" ]; } && bri=$2
			[ "$bri" -gt 0 ] || bri=255
			ledbar_fx_send "$p" "$r" "$g" "$b" "$bri"; : > "$M/pending";;
		*) return;;
		esac;;
	usb_power/set)
		case $p in ON) "$PCTL" send usbpower on;; OFF) "$PCTL" send usbpower off;; esac;;
	key_leds/set)
		case $p in OFF) "$PCTL" send keypad led off;; ON) "$PCTL" send keypad led auto;; esac;;
	key_leds/brightness/set)
		case $p in *[!0-9]*|'') return;; esac
		[ "${#p}" -le 3 ] || return
		if [ "$p" -le 0 ]; then "$PCTL" send keypad led off
		else [ "$p" -le 255 ] || p=255; "$PCTL" send keypad led "$p"; fi;;
	volume/set)
		p=${p%%.*}; case $p in *[!0-9]*|'') return;; esac
		[ "$p" -le 100 ] || p=100
		"$PCTL" send volume "$p";;
	als_auto/set)
		case $p in ON) "$PCTL" send als auto on;; OFF) "$PCTL" send als auto off;; esac;;
	screen/set)
		case $p in ON) "$PCTL" send blank off;; OFF) "$PCTL" send blank on;; esac;;
	backlight/set)
		# percent of the slider (1 to 100), as the ESPHome entity
		p=${p%%.*}; case $p in *[!0-9]*|'') return;; esac
		[ "${#p}" -le 5 ] || return
		[ "$p" -ge 1 ] || p=1; [ "$p" -le 100 ] || p=100
		"$PCTL" send brightness-pct "$p";;      # the base system maps it to the level of the tsx-idled override
	blank_timeout/set)
		p=${p%%.*}; case $p in *[!0-9]*|'') return;; esac
		[ "${#p}" -le 5 ] && [ "$p" -le 86400 ] || return
		"$PCTL" send blank-timeout "$p";;
	update/set)
		"$PCTL" send update-install;;
	restart/set)
		[ "$p" = PRESS ] && "$PCTL" send reboot;;
	update_mode/set)
		case $p in auto|manual) ;; *) return;; esac
		"$PCTL" send update-mode "$p"
		update_hold_set update_mode "$p"; pub -r "$BASE/update_mode/state" "$p";;
	auto_restart/set)
		case $p in
		ON) "$PCTL" send auto-restart on;;
		OFF) "$PCTL" send auto-restart off;;
		*) return;;
		esac
		update_hold_set auto_restart "$p"; pub -r "$BASE/auto_restart/state" "$p";;
	dark_mode/set)
		case $p in
		ON) "$PCTL" send dark-mode on;;
		OFF) "$PCTL" send dark-mode off;;
		*) return;;
		esac
		[ "$HAS_DARK" = 1 ] || has_dark || return 0
		update_hold_set dark_mode "$p"; pub -r "$BASE/dark_mode/state" "$p";;
	*) return;;
	esac
	: > "$M/poke"
}

# ---- key events --------------------------------------------------------------
P_KEY=
check_keys() {
	v=$(field "$R/buttons.state" last)
	[ "$v" = "$P_KEY" ] && return
	old=$P_KEY; P_KEY=$v
	[ -n "$old" ] || return 0            # first read after start: no event
	set -- $v; [ $# -ge 2 ] || return 0
	case $1 in none) return 0;; esac
	pub "$BASE/key/$1" "{\"event_type\":\"$2\"}"
	case $2 in short|long) pub "$BASE/trigger/$1/$2" "$2";; esac
}

# ---- NFC tags ----------------------------------------------------------------
# tsx-nfcd keeps "count N" and "last UID" in nfc.state; a new count is one scan.
# The first read after start is not a scan. Two topics: the tag id for Home
# Assistant's tag scanner, and an event entity with the same id.
P_TAGC=
check_tag() {
	has_nfc || return 0
	c=$(field "$R/nfc.state" count)
	[ -n "$c" ] && [ "$c" != "$P_TAGC" ] || return 0
	old=$P_TAGC; P_TAGC=$c
	[ -n "$old" ] || return 0
	uid=$(field "$R/nfc.state" last)
	case $uid in ''|-|*[!0-9A-Fa-f:]*) return 0;; esac
	pub "$BASE/nfc/tag_id" "$uid"
	pub "$BASE/nfc/tag" "{\"event_type\":\"scanned\",\"tag_id\":\"$uid\"}"
}

# ---- main ------------------------------------------------------------------
if [ "$DRY" = 1 ]; then
	discovery; publish_states force
	# A color or a brightness waits for the messages that come with it. Any
	# other message, and the end of the input, ends the wait.
	while read -r topic payload; do
		# a line "tick" is one pass of the main loop (publish what changed). A test changes the state files between two ticks.
		if [ "$topic" = tick ]; then publish_states; continue; fi
		handle "$topic" "$payload"
		case $topic in */ledbar/rgb/set|*/ledbar/brightness/set) ;; *) led_apply;; esac
	done
	led_apply
	P_KEY=${TSX_MQTT_PREV_KEY:-}; check_keys
	P_TAGC=${TSX_MQTT_PREV_TAG:-}; check_tag
	exit 0
fi

rm -f "$M/pending" "$M/poke" "$M/republish" "$M/pub.pids" "$M/led.rgb" "$M/led.bri"
mkfifo "$M/sub.fifo" 2>/dev/null || { rm -f "$M/sub.fifo"; mkfifo "$M/sub.fifo"; }
mosquitto_sub -i "$NODE-sub" -q 1 -v -t "$BASE/+/set" -t "$BASE/+/+/set" -t "$DP/status" \
	--will-topic "$BASE/availability" --will-payload offline --will-retain > "$M/sub.fifo" &
SUB=$!
HANDLER=   # set below. A signal that lands before that must not hit set -u

stop() {
	kill $SUB 2>/dev/null
	[ -n "$HANDLER" ] && kill $HANDLER 2>/dev/null
	# Kill any publisher that is still stuck in connect (the whole setsid group: timeout + mosquitto_pub)
	if [ -s "$M/pub.pids" ]; then
		while read -r pp; do [ -n "$pp" ] && kill -TERM -- "-$pp" 2>/dev/null; done < "$M/pub.pids"
		# That publish is dead, not finished. Its own pub() never got back to
		# set LASTPUBOK (this code runs from inside its wait, through the trap).
		LASTPUBOK=0
	fi
	[ "$LASTPUBOK" = 0 ] || pub -r "$BASE/availability" offline
	rm -f "$M/sub.fifo" "$M/pub.pids"
	exit 0
}
trap stop INT TERM

( while read -r topic payload; do
	if [ "$topic" = "$DP/status" ]; then [ "$payload" = online ] && : > "$M/republish"; continue; fi
	handle "$topic" "$payload" 2>&1 | sed 's/^/cmd: /'
  done < "$M/sub.fifo" ) &
HANDLER=$!

sleep 1
kill -0 $SUB 2>/dev/null || { log "cannot connect to $BROKER:$PORT"; exit 1; }
P_USBF=$(ledbar_stamp)   # before discovery: a change in between is not missed
discovery
pub -r "$BASE/availability" online
publish_states force
P_KEY=$(field "$R/buttons.state" last)
P_TAGC=$(field "$R/nfc.state" count)
log "connected to $BROKER:$PORT as $BASE ($(keys | wc -l) keys)"

i=0
while kill -0 $SUB 2>/dev/null; do
	check_keys
	check_tag
	check_ledbar
	i=$((i + 1))
	if [ -e "$M/republish" ]; then rm -f "$M/republish"; sleep 1; discovery; pub -r "$BASE/availability" online; publish_states force
	elif [ -e "$M/poke" ] || [ $i -ge 8 ]; then rm -f "$M/poke"; i=0; publish_states
	fi
	sleep 0.25
done
log "subscriber ended (broker gone?). Restarting"
kill $HANDLER 2>/dev/null
exit 1
