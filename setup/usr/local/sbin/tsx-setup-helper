#!/bin/sh
# tsx-setup-helper: the ONLY privileged surface for tsx-setupd (the
# unprivileged on-panel and LAN setup page, see the "Setup page" docs of the board repository).
# It runs as root and reads fixed, whitelisted commands from a FIFO. The
# group "tsx-setup" can write to the FIFO. That is the own, unprivileged
# user of tsx-setupd. It is deliberately NOT "kiosk". The setup page is a
# different and smaller trust boundary than the browser of the kiosk, which
# is always unsandboxed and which tsx-panelctl must already assume is hostile.
# The helper runs the commands with tsx-config or chpasswd. tsx-setupd
# itself never reads or writes panel.conf (mode 600, owned by root -- see
# see the header of tsx-config). It never runs a shell that is built
# from what a form submits. This script hands every value to tsx-config or
# chpasswd only as a separate argv element or over stdin. It never puts a
# value into a command string.
#
# Protocol: one line per request on the REQ fifo, "CMD REST" (read -r cmd
# rest: REST is everything after the first space, spaces included, and the
# script never splits it again). One line per reply on the RESP fifo,
# "ok[ TEXT]" or "err MESSAGE". The commands below are the fixed, whitelisted
# set. The script refuses anything else. It logs the refused line, with the
# name cleaned and capped the same way as tsx-panelctl does for a rejected
# line.
#
# A request can start with a tag: "#TAG CMD REST", TAG is 1 to 32 letters or
# digits. The reply then starts with the same tag: "#TAG ok[ TEXT]" or
# "#TAG err MESSAGE". tsx-setupd tags each request and reads only the reply
# with its tag. So a late reply to an earlier request (a caller that timed
# out, or a tsx-setupd that stopped) never counts as the reply to a new one.
#
#   show                 tsx-config show (it already masks the secrets)
#   rev                  the revision of panel.conf: the sha256 of a salt and
#                          the content of the file. Each change of the file
#                          gives a new revision, also a change of a secret
#                          that show masks. The salt is random and is in
#                          $TSX_RUN_DIR/setup-helper.salt (mode 600, root).
#                          /run is a tmpfs, so each boot makes a new salt. A
#                          restart of this script keeps it. So in one boot,
#                          only a change of the file gives a new revision.
#                          The reply never gives the salt. So the revision
#                          does not let a client test a guess of a secret. A
#                          missing file has a revision too. tsx-setupd sends
#                          the revision to the page and refuses a save from a
#                          page with an old revision.
#   set KEY VALUE         tsx-config set KEY VALUE. VALUE can be empty. It
#                          can contain anything, including shell
#                          metacharacters. The per-key regex of tsx-config
#                          accepts or refuses it, as for any other caller.
#                          This script does NOT check KEY and VALUE again.
#                          tsx-setupd already calls the unprivileged
#                          `tsx-config validate` first, which needs no root.
#   unset KEY             tsx-config unset KEY
#   apply                 tsx-config apply
#   setup                 tsx-config setup (reopen the window)
#   kiosk-restart          rc-service kiosk restart, only if it is running
#                          (a save loads the new URL now)
#   brightness-learn-reset tsx-panelctl send brightness-learn-reset (forget
#                          the brightness points that the panel learned)
#   clear-setup-open       rm -f $TSX_RUN_DIR/setup-open (a save closes the
#                          reopened window again, as if it expired)
#   rootpw PASSWORD       chpasswd (PASSWORD over its stdin, never argv).
#                          Then it copies the new /etc/shadow hash into
#                          ROOT_PASSWORD_HASH, the way tsx-config apply
#                          already does for that key.
#
# Env overrides for tests: TSX_RUN_DIR, TSX_SETUP_HELPER_REQ,
# TSX_SETUP_HELPER_RESP, TSX_CONF (panel.conf, the same variable and default
# as tsx-config), TSX_CONFIG_BIN, TSX_PANELCTL_BIN, TSX_CHPASSWD_BIN, TSX_SHADOW_FILE,
# TSX_RCSERVICE_BIN, TSX_SETUP_HELPER_ONESHOT=1 (handle exactly one request,
# then exit. Tests only), TSX_APPLY_ALLOW_NONROOT (passed through to
# tsx-config, tests only).
set -u
R=${TSX_RUN_DIR:-/run/tsx}
REQ=${TSX_SETUP_HELPER_REQ:-$R/setup-helper}
RESP=${TSX_SETUP_HELPER_RESP:-$R/setup-helper.resp}
CONFIG=${TSX_CONFIG_BIN:-tsx-config}
PANELCTL=${TSX_PANELCTL_BIN:-tsx-panelctl}
CHPASSWD=${TSX_CHPASSWD_BIN:-chpasswd}
SHADOW=${TSX_SHADOW_FILE:-/etc/shadow}
RCSERVICE=${TSX_RCSERVICE_BIN:-rc-service}
ONESHOT=${TSX_SETUP_HELPER_ONESHOT:-0}
CONF=${TSX_CONF:-/data/tsx/panel.conf}
# The salt of "rev" (see above). salt_init below reads or makes it.
SALT_FILE=$R/setup-helper.salt
SALT=
TAG=

log() { echo "$(date '+%F %T') tsx-setup-helper: $*"; }

# Read the salt of this boot, or make it (16 random bytes, in hex). The file
# is written with umask 077 and then moved into place, so it is never
# readable by another user. If the file cannot be written, the salt stays in
# this process only: then a restart of this script gives a new revision.
salt_init() {
	SALT=$(cat "$SALT_FILE" 2>/dev/null)
	case "$SALT" in
	*[!0-9a-f]*|'') ;;
	*) if [ "${#SALT}" = 32 ]; then chmod 600 "$SALT_FILE"; return 0; fi;;
	esac
	SALT=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
	if [ "${#SALT}" != 32 ]; then SALT=; log "warning: no random salt: rev is refused"; return 1; fi
	tmp="$SALT_FILE.tmp.$$"
	if ! (umask 077; printf '%s\n' "$SALT" > "$tmp") || ! mv -f "$tmp" "$SALT_FILE"; then
		rm -f "$tmp"
		log "warning: cannot write $SALT_FILE: the revision changes at the next start of this script"
	fi
}
# Use this only to log a hostile or malformed COMMAND NAME. Never apply it to
# a reply payload. The own output of tsx-config legitimately contains the \1
# line separator that "show" below uses, and this filter would strip it.
safe() { printf '%s' "$1" | tr -d '\000-\010\013-\037\177' | cut -c1-200; }

# Always send one reply per request. A caller that is blocked on RESP must
# never hang because a branch below forgot to answer. The script writes to
# fd 4, its OWN permanent read+write handle on RESP (opened below). So every
# write here completes at once. A FIFO write blocks only when NO process has
# the FIFO open for reading, and this script always does. A tsx-setupd that
# crashed or timed out mid-transaction can therefore never hang this loop
# for the next, unrelated request. The worst case is one stale reply in the
# pipe, which the NEXT transaction of tsx-setupd discards (it drains RESP
# before every request it sends, see the client side). The script never
# sanitizes the reply content. It is always the own trusted output of this
# script (stdout and stderr of tsx-config, or a fixed message). It goes back
# over a FIFO that only tsx-setupd (on this same machine) reads. tsx-config
# show masks the secrets itself, before this script sees them.
reply_ok() { printf '%sok%s\n' "${TAG:+$TAG }" "${1:+ $1}" >&4; }
reply_err() { printf '%serr %s\n' "${TAG:+$TAG }" "$1" >&4; }

handle() {
	cmd=$1; rest=$2
	case "$cmd" in
	show)
		[ -z "$rest" ] || { reply_err "show takes no arguments"; return; }
		# One RESP line: the newlines of tsx-config show become \1 (tsx-config
		# itself never produces it). tsx-setupd decodes them back.
		out=$("$CONFIG" show 2>&1) && reply_ok "$(printf '%s' "$out" | tr '\n' '\1')" \
			|| reply_err "tsx-config show failed"
		;;
	rev)
		[ -z "$rest" ] || { reply_err "rev takes no arguments"; return; }
		[ -n "$SALT" ] || { reply_err "rev: no salt"; return; }
		h=$({ printf '%s\n' "$SALT"; cat "$CONF" 2>/dev/null; } | sha256sum) \
			|| { reply_err "rev failed"; return; }
		reply_ok "${h%% *}"
		;;
	set)
		key=${rest%% *}
		case "$rest" in *" "*) val=${rest#* };; *) val=;; esac
		[ -n "$key" ] || { reply_err "set: missing key"; return; }
		log "set $key"
		if out=$("$CONFIG" set "$key" "$val" 2>&1); then reply_ok
		else reply_err "$out"; fi
		;;
	unset)
		key=$rest
		case "$key" in *" "*|"") reply_err "unset: bad key"; return;; esac
		log "unset $key"
		if out=$("$CONFIG" unset "$key" 2>&1); then reply_ok
		else reply_err "$out"; fi
		;;
	apply)
		[ -z "$rest" ] || { reply_err "apply takes no arguments"; return; }
		log "apply"
		if out=$("$CONFIG" apply 2>&1); then reply_ok
		else reply_err "$out"; fi
		;;
	setup)
		[ -z "$rest" ] || { reply_err "setup takes no arguments"; return; }
		log "setup"
		if out=$("$CONFIG" setup 2>&1); then reply_ok
		else reply_err "$out"; fi
		;;
	kiosk-restart)
		[ -z "$rest" ] || { reply_err "kiosk-restart takes no arguments"; return; }
		log "kiosk-restart"
		if command -v "$RCSERVICE" >/dev/null 2>&1 && "$RCSERVICE" kiosk status >/dev/null 2>&1; then
			if "$RCSERVICE" kiosk restart >/dev/null 2>&1; then reply_ok
			else reply_err "kiosk restart failed"; fi
		else
			reply_ok "kiosk not running"
		fi
		;;
	brightness-learn-reset)
		[ -z "$rest" ] || { reply_err "brightness-learn-reset takes no arguments"; return; }
		log "brightness-learn-reset"
		if out=$("$PANELCTL" send brightness-learn-reset 2>&1); then reply_ok
		else reply_err "$out"; fi
		;;
	clear-setup-open)
		[ -z "$rest" ] || { reply_err "clear-setup-open takes no arguments"; return; }
		rm -f "$R/setup-open"
		reply_ok
		;;
	rootpw)
		# Never log the password, and never put it in $out on failure. The
		# stderr of chpasswd does not echo its stdin back, but be defensive:
		# report a fixed message, not the output of chpasswd.
		pw=$rest
		if [ -z "$pw" ] || [ "${#pw}" -lt 8 ]; then reply_err "root password must be at least 8 characters"; return; fi
		log "rootpw"
		if ! printf 'root:%s\n' "$pw" | "$CHPASSWD" >/dev/null 2>&1; then
			reply_err "chpasswd failed"; return
		fi
		hash=$(awk -F: '$1=="root"{print $2}' "$SHADOW" 2>/dev/null)
		if [ -n "$hash" ]; then
			"$CONFIG" set ROOT_PASSWORD_HASH "$hash" >/dev/null 2>&1 \
				|| log "warning: root password changed, but could not mirror the hash into panel.conf"
		fi
		reply_ok
		;;
	'') [ -z "$TAG" ] || reply_err "empty request";;
	*) reject="$(safe "$cmd $rest")"; log "rejected: $reject"; reply_err "unknown command";;
	esac
}

mkdir -p "$R"
salt_init
for p in "$REQ" "$RESP"; do
	if [ ! -p "$p" ]; then rm -f "$p"; mkfifo "$p" || { log "mkfifo $p failed"; exit 1; }; fi
	chown root:tsx-setup "$p" 2>/dev/null || true
	chmod 660 "$p"
done

# Open both with <> (read+write). On REQ, a short-lived writer (tsx-setupd
# opens, writes one line, closes) never makes the read see EOF (same reason
# as in tsx-panelctl). On RESP, the replies of this script never block on
# the presence of a reader (see reply_ok and reply_err above).
exec 3<>"$REQ" 4<>"$RESP"
log "listening on $REQ"
while IFS=' ' read -r cmd rest <&3; do
	TAG=
	case "$cmd" in
	'#'*)
		TAG=$cmd
		cmd=${rest%% *}
		case "$rest" in *" "*) rest=${rest#* };; *) rest=;; esac
		case "$TAG" in
		'#'|'#'*[!0-9A-Za-z]*|'#'?????????????????????????????????*)
			TAG=; reply_err "bad tag"; [ "$ONESHOT" = 1 ] && break; continue;;
		esac
		;;
	esac
	handle "$cmd" "$rest"
	[ "$ONESHOT" = 1 ] && break
done
log "REQ closed, exiting"
