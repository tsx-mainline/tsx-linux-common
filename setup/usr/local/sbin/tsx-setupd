<script>
(function(){
  "use strict";
  var $ = function(id){ return document.getElementById(id); };
  var state = null;    // the state that filled the form
  var loaded = false;  // the form has its values (once only)
  var initial = null;  // name -> value of each field after the load
  var saved = false;

  function api(method, path, body){
    return fetch(path, {
      method: method,
      headers: body ? {"Content-Type":"application/json"} : {},
      body: body ? JSON.stringify(body) : undefined,
      credentials: "same-origin"
    }).then(function(r){ return r.json().then(function(j){ return {status:r.status, body:j}; }); });
  }

  function fmtRemaining(s){
    s = Math.max(0, s|0);
    var m = Math.floor(s/60), sec = s%60;
    return m + ":" + (sec<10?"0":"")+sec;
  }

  function showCode(code, remaining){
    $("code-banner").style.display = "block";
    $("code-value").textContent = code;
    $("code-remaining").textContent = "expires in " + fmtRemaining(remaining);
  }

  function populateTz(list, current){
    var sel = $("f-tz");
    sel.innerHTML = "";
    var blank = document.createElement("option");
    blank.value = ""; blank.textContent = "(no change)";
    sel.appendChild(blank);
    (list||[]).forEach(function(z){
      var o = document.createElement("option");
      o.value = z; o.textContent = z;
      if (z === current) o.selected = true;
      sel.appendChild(o);
    });
  }

  // Set every field from panel.conf, also an empty field and an unchecked
  // checkbox. The page calls this once, at load time.
  function applyFields(fields){
    fields = fields || {};
    $("f-url").value = fields.KIOSK_URL || "";
    $("f-name").value = fields.PANEL_NAME || "";
    $("f-orient").value = fields.ORIENTATION || "landscape";
    $("f-blank").value = fields.BLANK_TIMEOUT || "";
    $("f-pwake").value = fields.PRESENCE_WAKE || "";
    $("f-pdist").value = fields.PRESENCE_DISTANCE_MM || "";
    $("f-phold").value = fields.PRESENCE_HOLD_S || "";
    $("f-autobri").value = fields.AUTO_BRIGHTNESS || "";
    $("f-alsscale").value = fields.ALS_SCALE || "";
    $("f-kernel").value = fields.KERNEL_FLAVOR || "";
    if (fields.SSH_AUTHORIZED_KEY__set) $("f-sshkey").placeholder = "(a key is already set; leave blank to keep it)";
    /*SLOT:apply*/
    populateTz(fields.tz_list, fields.TZ_NAME);
  }

  // The value of each field that a save can send: name -> text. A disabled
  // field (a setting that this panel cannot use) is not in it. A checkbox
  // is "on" or "off". A radio group gives the value of its checked button.
  function fieldValues(){
    var out = {};
    $("form").querySelectorAll("[name]").forEach(function(el){
      if (el.disabled) return;
      if (el.type === "radio") { if (el.checked) out[el.name] = el.value; return; }
      if (el.type === "checkbox") { out[el.name] = el.checked ? "on" : "off"; return; }
      out[el.name] = el.type === "password" ? el.value : el.value.trim();
    });
    return out;
  }

  // The fields that the user changed after the load. A save sends only
  // these. A field that the user did not change keeps the value of
  // panel.conf, also a value that changed elsewhere.
  function changedFields(){
    var now = fieldValues(), out = {};
    Object.keys(now).forEach(function(k){
      if (!initial || now[k] !== initial[k]) out[k] = now[k];
    });
    return out;
  }

  function showStale(text){
    if (text) $("stale-text").textContent = text;
    $("stale").style.display = "block";
  }

  function applyUnavailable(u){
    if (u.AUTO_BRIGHTNESS) {
      $("f-autobri").disabled = true; $("f-alsscale").disabled = true; $("learn-reset").disabled = true;
      $("als-hint").textContent = "Not available on this panel: " + u.AUTO_BRIGHTNESS + ".";
    }
    if (u.PRESENCE_WAKE) {
      ["f-pwake", "f-pdist", "f-phold"].forEach(function(id){ $(id).disabled = true; });
      $("presence-wrap").style.display = "none";
    }
    /*SLOT:unavailable*/
  }

  function loadState(){
    api("GET", "/setup/api/state").then(function(r){
      var s = r.body || {};
      if (s.need_pairing) {
        $("gate").style.display = "block";
        $("form").style.display = "none";
        return;
      }
      if (loaded) return;
      state = s;
      $("gate").style.display = "none";
      $("form").style.display = "block";
      if (s.loopback) {
        showCode(s.pairing_code, s.pairing_code_remaining);
      }
      var f = s.fields || {};
      f.tz_list = s.tz_list;
      applyFields(f);
      applyUnavailable(s.unavailable || {});
      initial = fieldValues();
      loaded = true;
    }).catch(function(){});
  }

  // The refresh every 20 s: the pairing code and the revision of
  // panel.conf. It never changes a field.
  function refreshStatus(){
    api("GET", "/setup/api/status").then(function(r){
      var s = r.body || {};
      if (s.pairing_code) showCode(s.pairing_code, s.pairing_code_remaining);
      if (!saved && s.revision && state && s.revision !== state.revision) showStale();
    }).catch(function(){});
  }

  $("reload-btn").addEventListener("click", function(){ location.reload(); });

  $("pair-go").addEventListener("click", function(){
    var code = $("pair-code").value.trim();
    $("pair-status").textContent = "";
    api("POST", "/setup/api/pair", {code: code}).then(function(r){
      if (r.status === 200) { location.reload(); return; }
      $("pair-status").className = "status bad";
      $("pair-status").textContent = (r.body && r.body.error) || "wrong code";
    });
  });

  function setUrlStatus(cls, text){
    var el = $("url-status");
    el.className = "status " + cls;
    el.textContent = text;
  }

  $("learn-reset").addEventListener("click", function(){
    var b = $("learn-reset"), st = $("learn-status");
    b.disabled = true;
    api("POST", "/setup/api/brightness-learn-reset", {}).then(function(r){
      b.disabled = false;
      st.className = r.status === 200 ? "status ok" : "status bad";
      st.textContent = r.status === 200 ? "The learned brightness is removed." : "Not done. Try again.";
    }).catch(function(){
      b.disabled = false; st.className = "status bad"; st.textContent = "network error; try again";
    });
  });

  /*SLOT:init*/

  $("form").addEventListener("submit", function(ev){
    ev.preventDefault();
    var btn = $("submit-btn");
    btn.disabled = true;
    document.querySelectorAll(".status.bad").forEach(function(e){ e.textContent=""; e.className="status"; });
    var payload = changedFields();
    /*SLOT:payload*/
    api("POST", "/setup/api/submit", {revision: state && state.revision, fields: payload}).then(function(r){
      btn.disabled = false;
      if (r.status === 200) {
        saved = true;
        $("form").style.display = "none";
        $("stale").style.display = "none";
        $("done").style.display = "block";
        if (r.body && r.body.changed && !r.body.changed.length) $("done-note").textContent = "No setting changed.";
        return;
      }
      if (r.body && r.body.stale) {
        showStale(r.body.errors && r.body.errors._revision);
        $("stale").scrollIntoView({behavior:"smooth", block:"center"});
      }
      var errs = (r.body && r.body.errors) || {};
      var first = null;
      Object.keys(errs).forEach(function(k){
        var input = document.querySelector('[name="'+k+'"]');
        var msg = errs[k];
        if (input) {
          var wrap = input.closest(".card") || input.parentElement;
          var el = wrap.querySelector(".status") || (function(){
            var d = document.createElement("div"); d.className="status"; wrap.appendChild(d); return d;
          })();
          el.className = "status bad"; el.textContent = msg;
          if (!first) first = input;
        } else {
          $("submit-status").className = "status bad";
          $("submit-status").textContent = ($("submit-status").textContent + " " + msg).trim();
        }
      });
      if (Object.keys(errs).length) {
        $("submit-status").className = "status bad";
        $("submit-status").textContent = ("Not saved. " + $("submit-status").textContent).trim()
          + (first ? " Check the field marked in red." : "");
      }
      if (first) {
        var d = first.closest("details"); if (d) d.open = true;
        first.scrollIntoView({behavior:"smooth", block:"center"});
      }
    }).catch(function(){
      btn.disabled = false;
      $("submit-status").className = "status bad";
      $("submit-status").textContent = "network error saving; try again";
    });
  });

  loadState();
  setInterval(function(){
    if (!loaded) { loadState(); return; }   // no state yet, or the page waits for the pairing
    if (!saved) refreshStatus();
  }, 20000);
})();
</script>
</body></html>
"""


def build_page(template, plugins):
    """Put the words, the HTML and the script of the plugins into the slots of
    the template. A slot that no plugin fills stays empty."""
    def words(name):
        for p in plugins:
            v = getattr(p, "TEXT", {}).get(name)
            if v:
                return v
        return _TEXT_DEFAULTS[name]

    out = template
    for key, name in (("@@URL_LABEL@@", "url_label"), ("@@URL_PLACEHOLDER@@", "url_placeholder"),
                      ("@@SUBMIT_LABEL@@", "submit_label"), ("@@DONE_TEXT@@", "done_text")):
        out = out.replace(key, words(name))
    for slot in ("url_buttons", "after_url", "panel", "details"):
        out = out.replace("<!--SLOT:%s-->" % slot, "".join(getattr(p, "HTML", {}).get(slot, "") for p in plugins))
    for slot in ("apply", "unavailable", "payload", "init"):
        out = out.replace("/*SLOT:%s*/" % slot, "".join(getattr(p, "JS", {}).get(slot, "") for p in plugins))
    return out


PAGE = build_page(PAGE_MAIN, PLUGINS)


# ---- listening address: loopback-only unless a LAN window is open --------
#
# The HTTP handler already refuses a non-loopback request once !lan_allowed()
# (a defensive second layer). But the process should not even ACCEPT a LAN
# connection outside that window. With no listening socket on a
# LAN-reachable address, the network has nothing to probe, fingerprint or
# exploit while the panel is configured and no one has opened Setup on the
# glass. ServerManager rebinds between "0.0.0.0" (LAN allowed, this also
# serves loopback) and "127.0.0.1" (LAN not allowed) as lan_allowed()
# changes. It polls POLL_S seconds apart. A submit or an external change of
# setup-open takes effect on the next poll, at most POLL_S seconds later.
#
# A rebind briefly closes the old socket before the new one is listening.
# The two addresses overlap ("0.0.0.0" includes "127.0.0.1"), so the process
# cannot bind both on the same port at once. A request that lands in that
# gap, including one from the kiosk itself over loopback, gets a connection
# reset or refusal instead of an answer. This is the same class of transient
# failure as tsx-setupd not having started yet (kiosk-session already waits
# and retries for that, docs/rootfs.md "Setup page"). It is not a new one. A
# client must retry and not treat one reset as final.
POLL_S = 1.0


class ServerManager:
    def __init__(self):
        self.lock = threading.Lock()
        self.server = None
        self.host = None

    def _desired_host(self):
        return "0.0.0.0" if lan_allowed() else "127.0.0.1"

    def ensure(self):
        with self.lock:
            want = self._desired_host()
            if want == self.host and self.server is not None:
                return
            if self.server is not None:
                # Release the old socket FIRST. Binding "0.0.0.0:PORT" while
                # "127.0.0.1:PORT" is still held (or the reverse) is the same
                # address for the kernel, and it fails with EADDRINUSE.
                # shutdown() stops the accept loop. Call it from here, not
                # from inside its own serve_forever thread (BaseServer
                # requires this). server_close() then frees the port.
                self.server.shutdown()
                self.server.server_close()
                self.server = None
            self.server = ThreadingHTTPServer((want, PORT), Handler)
            self.host = want
            threading.Thread(target=self.server.serve_forever, daemon=True, name="tsx-setupd-http").start()
            sys.stderr.write("tsx-setupd: listening on %s:%d (lan=%s window=%ds)\n"
                              % (want, PORT, "on" if LAN_ON else "off", WINDOW))

    def watch_forever(self):
        was_open = setup_open_fresh()
        while True:
            try:
                self.ensure()
            except OSError as e:
                sys.stderr.write("tsx-setupd: bind failed: %s (retrying)\n" % e)
            # A reopened window (tsx-config setup or overlay "Setup") can
            # simply run out on a configured panel. Then take the kiosk back
            # to Home Assistant. kiosk-session picks the URL only at start,
            # so without this the page stayed up until the next restart.
            now_open = setup_open_fresh()
            if was_open and not now_open and is_configured():
                sys.stderr.write("tsx-setupd: setup window expired: back to Home Assistant\n")
                clear_setup_open()
                restart_kiosk()
            was_open = now_open
            time.sleep(POLL_S)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    mgr = ServerManager()
    mgr.ensure()
    try:
        mgr.watch_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
