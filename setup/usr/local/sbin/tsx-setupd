<script>
(function(){
  "use strict";
  var $ = function(id){ return document.getElementById(id); };
  var state = null;    // the state that filled the form
  var loaded = false;  // the form has its values (once only)
  var initial = null;  // name -> value of each field after the load
  var saved = false;

  var csrf = "";      // the CSRF token of this session (the state API, else the cookie tsxcsrf)
  function csrfToken(){
    if (csrf) return csrf;
    try {
      var m = String(document.cookie || "").match(/(?:^|; )tsxcsrf=([^;]*)/);
      return m ? decodeURIComponent(m[1]) : "";
    } catch (e) { return ""; }
  }
  function api(method, path, body){
    var h = {};
    if (method !== "GET") { h["Content-Type"] = "application/json"; h["X-TSX-CSRF"] = csrfToken(); }
    return fetch(path, {
      method: method,
      headers: h,
      body: method !== "GET" ? JSON.stringify(body || {}) : undefined,
      credentials: "same-origin"
    }).then(function(r){ return r.json().then(function(j){ return {status:r.status, body:j}; }); });
  }

  function fmtRemaining(s){
    s = Math.max(0, s|0);
    var m = Math.floor(s/60), sec = s%60;
    return m + ":" + (sec<10?"0":"")+sec;
  }

  function showCode(code, remaining){
    $("code-banner").style.display = "block";
    $("code-value").textContent = code;
    $("code-remaining").textContent = "expires in " + fmtRemaining(remaining);
  }

  function populateTz(list, current){
    var sel = $("f-tz");
    sel.innerHTML = "";
    var blank = document.createElement("option");
    blank.value = ""; blank.textContent = "(no change)";
    sel.appendChild(blank);
    (list||[]).forEach(function(z){
      var o = document.createElement("option");
      o.value = z; o.textContent = z;
      if (z === current) o.selected = true;
      sel.appendChild(o);
    });
  }

  // Set every field from panel.conf, also an empty field and an unchecked
  // checkbox. The page calls this once, at load time.
  function applyFields(fields){
    fields = fields || {};
    $("f-url").value = fields.KIOSK_URL || "";
    $("f-name").value = fields.PANEL_NAME || "";
    $("f-orient").value = fields.ORIENTATION || "landscape";
    $("f-dark").value = fields.KIOSK_DARK || "off";
    $("f-pwake").value = fields.PRESENCE_WAKE || "";
    $("f-pdist").value = fields.PRESENCE_DISTANCE_MM || "";
    $("f-phold").value = fields.PRESENCE_HOLD_S || "";
    $("f-autobri").value = fields.AUTO_BRIGHTNESS || "";
    $("f-alsscale").value = fields.ALS_SCALE || "";
    $("f-kernel").value = fields.KERNEL_FLAVOR || "";
    if (fields.SSH_AUTHORIZED_KEY__set) $("f-sshkey").placeholder = "(a key is already set; leave blank to keep it)";
    /*SLOT:apply*/
    populateTz(fields.tz_list, fields.TZ_NAME);
  }

  // The value of each field that a save can send: name -> text. A disabled
  // field (a setting that this panel cannot use) is not in it. A checkbox
  // is "on" or "off". A radio group gives the value of its checked button.
  function fieldValues(){
    var out = {};
    $("form").querySelectorAll("[name]").forEach(function(el){
      if (el.disabled) return;
      if (el.type === "radio") { if (el.checked) out[el.name] = el.value; return; }
      if (el.type === "checkbox") { out[el.name] = el.checked ? "on" : "off"; return; }
      out[el.name] = el.type === "password" ? el.value : el.value.trim();
    });
    return out;
  }

  // The fields that the user changed after the load. A save sends only
  // these. A field that the user did not change keeps the value of
  // panel.conf, also a value that changed elsewhere.
  function changedFields(){
    var now = fieldValues(), out = {};
    Object.keys(now).forEach(function(k){
      if (!initial || now[k] !== initial[k]) out[k] = now[k];
    });
    return out;
  }

  function showStale(text){
    if (text) $("stale-text").textContent = text;
    $("stale").style.display = "block";
  }

  function applyUnavailable(u){
    if (u.AUTO_BRIGHTNESS) {
      $("f-autobri").disabled = true; $("f-alsscale").disabled = true; $("learn-reset").disabled = true;
      $("als-hint").textContent = "Not available on this panel: " + u.AUTO_BRIGHTNESS + ".";
    }
    if (u.PRESENCE_WAKE) {
      ["f-pwake", "f-pdist", "f-phold"].forEach(function(id){ $(id).disabled = true; });
      $("presence-wrap").style.display = "none";
    }
    /*SLOT:unavailable*/
  }

  // A panel with no kiosk loads no page. Hide the settings that only a
  // service of the kiosk reads, and do not send them (a disabled field is
  // not sent). Without a time zone, the first save sends the time zone of
  // this browser, so that it makes panel.conf.
  function applyKiosk(on, s){
    $("url-card").style.display = on ? "block" : "none";
    $("f-url").disabled = !on;
    $("f-dark").disabled = !on;
    $("dark-wrap").style.display = on ? "block" : "none";
    if (!on && !s.configured && !$("f-tz").value) {
      var zone = "";
      try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) {}
      var names = (s.tz_list || []);
      $("f-tz").value = names.indexOf(zone) >= 0 ? zone : (names.indexOf("UTC") >= 0 ? "UTC" : "");
    }
    /*SLOT:kiosk*/
  }

  // The gate of a LAN client without a session: the login with Home
  // Assistant, the pairing code, or neither.
  function showGate(s){
    $("gate").style.display = "block";
    $("form").style.display = "none";
    $("login-box").style.display = s.login ? "block" : "none";
    $("ha-host").textContent = s.ha_host || "";
    $("pair-box").style.display = s.pairing === false ? "none" : "block";
    $("gate-none").style.display = !s.login && s.pairing === false ? "block" : "none";
  }

  function showSession(s){
    var sess = s.session || {};
    if (sess.kind === "ha") $("session-who").textContent = "Logged in as " + (sess.user || "?") + " (Home Assistant)";
    else if (sess.kind === "pair") $("session-who").textContent = "Paired with the code of the screen";
    else $("session-who").textContent = "On the panel";
    $("logout-btn").style.display = sess.kind === "ha" || sess.kind === "pair" ? "" : "none";
    $("session-bar").style.display = "block";
  }

  function loadState(){
    api("GET", "/setup/api/state").then(function(r){
      var s = r.body || {};
      if (s.need_pairing) {
        showGate(s);
        return;
      }
      if (loaded) return;
      state = s;
      if (s.csrf) csrf = s.csrf;
      $("gate").style.display = "none";
      $("form").style.display = "block";
      showSession(s);
      loadPanel();
      if (s.loopback) {
        showCode(s.pairing_code, s.pairing_code_remaining);
      }
      var f = s.fields || {};
      f.tz_list = s.tz_list;
      applyFields(f);
      applyUnavailable(s.unavailable || {});
      applyKiosk(s.kiosk !== false, s);
      initial = fieldValues();
      loaded = true;
    }).catch(function(){});
  }

  // The refresh every 20 s: the pairing code and the revision of
  // panel.conf. It never changes a field.
  function refreshStatus(){
    api("GET", "/setup/api/status").then(function(r){
      var s = r.body || {};
      if (s.pairing_code) showCode(s.pairing_code, s.pairing_code_remaining);
      if (!saved && s.revision && state && s.revision !== state.revision) showStale();
    }).catch(function(){});
  }

  $("reload-btn").addEventListener("click", function(){ location.reload(); });

  $("pair-go").addEventListener("click", function(){
    var code = $("pair-code").value.trim();
    $("pair-status").textContent = "";
    api("POST", "/setup/api/pair", {code: code}).then(function(r){
      if (r.status === 200) { location.reload(); return; }
      $("pair-status").className = "status bad";
      $("pair-status").textContent = (r.body && r.body.error) || "wrong code";
    });
  });

  function setUrlStatus(cls, text){
    var el = $("url-status");
    el.className = "status " + cls;
    el.textContent = text;
  }

  $("learn-reset").addEventListener("click", function(){
    var b = $("learn-reset"), st = $("learn-status");
    b.disabled = true;
    api("POST", "/setup/api/brightness-learn-reset", {}).then(function(r){
      b.disabled = false;
      st.className = r.status === 200 ? "status ok" : "status bad";
      st.textContent = r.status === 200 ? "The learned brightness is removed." : "Not done. Try again.";
    }).catch(function(){
      b.disabled = false; st.className = "status bad"; st.textContent = "network error; try again";
    });
  });

  /*SLOT:init*/

  // ---- the Panel section: live controls ----
  var panel = null;      // the last answer of /setup/api/panel
  var panelBusy = 0;     // a change is on its way: the refresh waits
  function panelStatus(cls, text){ var el = $("panel-status"); el.className = "status " + cls; el.textContent = text; }
  function showCtl(name, on){ var el = $("ctl-" + name); if (el) el.style.display = on ? "block" : "none"; }
  function fillPanel(p){
    var c = (p && p.controls) || {};
    ["screen", "backlight", "volume", "dim_timeout", "dim_level", "blank_timeout", "update_mode", "auto_restart", "ledbar", "key_leds", "lights"].forEach(function(n){ showCtl(n, !!c[n]); });
    if (c.screen) $("p-screen-state").textContent = c.screen.on ? "The screen is on." : "The screen is off.";
    if (c.backlight) { $("p-backlight").value = c.backlight.value; $("p-backlight-v").textContent = c.backlight.value; }
    if (c.volume) {
      $("p-volume").value = c.volume.value; $("p-volume-v").textContent = c.volume.value;
      var player = typeof c.volume.muted === "boolean";
      $("p-mute-row").style.display = player ? "flex" : "none";
      $("p-volume-player").style.display = player ? "block" : "none";
      if (player) $("p-mute").checked = c.volume.muted;
    }
    ["dim_timeout", "dim_level", "blank_timeout"].forEach(function(n){
      var el = $("p-" + n);
      if (c[n] && document.activeElement !== el) el.value = c[n].value;
    });
    if (c.update_mode && document.activeElement !== $("p-update_mode")) $("p-update_mode").value = c.update_mode.value;
    if (c.auto_restart) $("p-auto_restart").checked = c.auto_restart.on;
    ["ledbar", "lights"].forEach(function(n){
      if (!c[n]) return;
      $("p-" + n + "-on").checked = c[n].on;
      $("p-" + n + "-bri").value = c[n].brightness;
      $("p-" + n + "-color").value = c[n].color;
    });
    if (c.key_leds) { $("p-key_leds-on").checked = c.key_leds.on; $("p-key_leds-level").value = c.key_leds.level; }
    $("panel-wrap").style.display = Object.keys(c).length ? "block" : "none";
  }
  function loadPanel(){
    if (panelBusy) return;
    api("GET", "/setup/api/panel").then(function(r){
      if (r.status !== 200) return;
      panel = r.body; fillPanel(panel);
    }).catch(function(){});
  }
  function setPanel(control, value){
    panelBusy++;
    panelStatus("", "...");
    return api("POST", "/setup/api/panel", {control: control, value: value}).then(function(r){
      panelBusy--;
      if (r.status !== 200) { panelStatus("bad", (r.body && r.body.error) || "Not done. Try again."); return; }
      panelStatus("ok", "Done.");
      // A time is a setting of panel.conf: keep the form if nothing else changed it.
      if (r.body && r.body.revision && state && r.body.revision_before === state.revision) state.revision = r.body.revision;
      setTimeout(loadPanel, 800);
    }).catch(function(){ panelBusy--; panelStatus("bad", "network error; try again"); });
  }
  function lightValue(n){
    return {on: $("p-" + n + "-on").checked, brightness: parseInt($("p-" + n + "-bri").value, 10) || 100,
            color: $("p-" + n + "-color").value};
  }
  $("p-screen-on").addEventListener("click", function(){ setPanel("screen", true); });
  $("p-screen-off").addEventListener("click", function(){ setPanel("screen", false); });
  ["backlight", "volume"].forEach(function(n){
    $("p-" + n).addEventListener("input", function(){ $("p-" + n + "-v").textContent = $("p-" + n).value; });
    $("p-" + n).addEventListener("change", function(){ setPanel(n, parseInt($("p-" + n).value, 10)); });
  });
  $("p-mute").addEventListener("change", function(){ setPanel("mute", $("p-mute").checked); });
  ["dim_timeout", "dim_level", "blank_timeout"].forEach(function(n){
    $("p-" + n + "-set").addEventListener("click", function(){
      var v = parseInt($("p-" + n).value, 10);
      if (isNaN(v)) { panelStatus("bad", "Enter a number."); return; }
      setPanel(n, v);
    });
  });
  $("p-update_mode").addEventListener("change", function(){ setPanel("update_mode", $("p-update_mode").value); });
  $("p-auto_restart").addEventListener("change", function(){ setPanel("auto_restart", $("p-auto_restart").checked); });
  ["ledbar", "lights"].forEach(function(n){
    ["on", "bri", "color"].forEach(function(part){
      $("p-" + n + "-" + part).addEventListener("change", function(){ setPanel(n, lightValue(n)); });
    });
  });
  ["on", "level"].forEach(function(part){
    $("p-key_leds-" + part).addEventListener("change", function(){
      setPanel("key_leds", {on: $("p-key_leds-on").checked, level: parseInt($("p-key_leds-level").value, 10) || 255});
    });
  });
  setInterval(function(){ if (loaded && !saved) loadPanel(); }, 5000);

  // ---- the session: logout, the list, revoke ----
  $("logout-btn").addEventListener("click", function(){
    api("POST", "/setup/api/logout", {}).then(function(){ location.reload(); }).catch(function(){ location.reload(); });
  });
  function loadSessions(){
    api("GET", "/setup/api/sessions").then(function(r){
      var list = $("sessions-list");
      list.innerHTML = "";
      ((r.body && r.body.sessions) || []).forEach(function(x){
        var d = document.createElement("div");
        d.className = "sess";
        var who = x.kind === "ha" ? x.user + " (Home Assistant)" : "the pairing code";
        d.textContent = who + ", " + x.ip + ", " + Math.round(x.age / 60) + " min old" + (x.current ? " (this browser)" : "") + " ";
        var b = document.createElement("button");
        b.type = "button"; b.className = "secondary"; b.textContent = "Log out";
        b.addEventListener("click", function(){
          api("POST", "/setup/api/sessions/revoke", {id: x.id}).then(function(){ if (x.current) location.reload(); else loadSessions(); });
        });
        d.appendChild(b);
        list.appendChild(d);
      });
    }).catch(function(){});
  }
  $("sessions-wrap").addEventListener("toggle", function(){ if ($("sessions-wrap").open) loadSessions(); });
  $("logout-all").addEventListener("click", function(){
    api("POST", "/setup/api/sessions/revoke", {all: true}).then(function(r){
      $("sessions-status").className = "status ok";
      $("sessions-status").textContent = "All sessions are ended: " + ((r.body && r.body.revoked) || 0) + ".";
      if (state && state.session && state.session.kind !== "local") location.reload(); else loadSessions();
    });
  });
  $("done-back").addEventListener("click", function(){ location.reload(); });

  $("form").addEventListener("submit", function(ev){
    ev.preventDefault();
    var btn = $("submit-btn");
    btn.disabled = true;
    document.querySelectorAll(".status.bad").forEach(function(e){ e.textContent=""; e.className="status"; });
    var payload = changedFields();
    // no kiosk and not configured: the first save always sends the time zone
    if (state && state.kiosk === false && !state.configured && $("f-tz").value) payload.TZ_NAME = $("f-tz").value;
    /*SLOT:payload*/
    api("POST", "/setup/api/submit", {revision: state && state.revision, fields: payload}).then(function(r){
      btn.disabled = false;
      if (r.status === 200) {
        saved = true;
        $("form").style.display = "none";
        $("stale").style.display = "none";
        $("done").style.display = "block";
        if (r.body && r.body.kiosk_restarted === false) $("done-text").textContent = "Saved. The settings are in use now.";
        if (r.body && r.body.changed && !r.body.changed.length) $("done-note").textContent = "No setting changed.";
        return;
      }
      if (r.body && r.body.stale) {
        showStale(r.body.errors && r.body.errors._revision);
        $("stale").scrollIntoView({behavior:"smooth", block:"center"});
      }
      var errs = (r.body && r.body.errors) || {};
      var first = null;
      Object.keys(errs).forEach(function(k){
        var input = document.querySelector('[name="'+k+'"]');
        var msg = errs[k];
        if (input) {
          var wrap = input.closest(".card") || input.parentElement;
          var el = wrap.querySelector(".status") || (function(){
            var d = document.createElement("div"); d.className="status"; wrap.appendChild(d); return d;
          })();
          el.className = "status bad"; el.textContent = msg;
          if (!first) first = input;
        } else {
          $("submit-status").className = "status bad";
          $("submit-status").textContent = ($("submit-status").textContent + " " + msg).trim();
        }
      });
      if (Object.keys(errs).length) {
        $("submit-status").className = "status bad";
        $("submit-status").textContent = ("Not saved. " + $("submit-status").textContent).trim()
          + (first ? " Check the field marked in red." : "");
      }
      if (first) {
        var d = first.closest("details"); if (d) d.open = true;
        first.scrollIntoView({behavior:"smooth", block:"center"});
      }
    }).catch(function(){
      btn.disabled = false;
      $("submit-status").className = "status bad";
      $("submit-status").textContent = "network error saving; try again";
    });
  });

  loadState();
  setInterval(function(){
    if (!loaded) { loadState(); return; }   // no state yet, or the page waits for the pairing
    if (!saved) refreshStatus();
  }, 20000);
})();
</script>
</body></html>
"""


def build_page(template, plugins, kiosk=True):
    """Put the words, the HTML and the script of the plugins into the slots of
    the template. A slot that no plugin fills stays empty. kiosk=False gives
    the words of a panel with no kiosk."""
    def words(name):
        if not kiosk and name in _TEXT_NO_KIOSK:
            return _TEXT_NO_KIOSK[name]
        for p in plugins:
            v = getattr(p, "TEXT", {}).get(name)
            if v:
                return v
        return _TEXT_DEFAULTS[name]

    out = template
    for key, name in (("@@URL_LABEL@@", "url_label"), ("@@URL_PLACEHOLDER@@", "url_placeholder"),
                      ("@@SUBMIT_LABEL@@", "submit_label"), ("@@DONE_TEXT@@", "done_text")):
        out = out.replace(key, words(name))
    for slot in ("url_buttons", "after_url", "panel", "details"):
        out = out.replace("<!--SLOT:%s-->" % slot, "".join(getattr(p, "HTML", {}).get(slot, "") for p in plugins))
    for slot in ("apply", "unavailable", "kiosk", "payload", "init"):
        out = out.replace("/*SLOT:%s*/" % slot, "".join(getattr(p, "JS", {}).get(slot, "") for p in plugins))
    return out


PAGE = build_page(PAGE_MAIN, PLUGINS)
PAGE_NO_KIOSK = build_page(PAGE_MAIN, PLUGINS, kiosk=False)


# ---- screen.json: the pairing code for a native screen -----------------------
# A panel with no kiosk has no browser that shows the setup page, so the
# native app of the screen cannot read the code from the page. While the LAN
# window is open, this process writes the code, the address and the time that
# is left to STATE_DIR/screen.json (the docstring at the top has the format).

REFRESH_S = 2.0
_screen = {"at": float("-inf"), "on": False, "err": False}


def local_addresses():
    """The IPv4 addresses of this panel that are not loopback (stdlib only).
    The kernel lists them in /proc/net/fib_trie as the entries "/32 host
    LOCAL". The fallback asks the kernel for the source address of a route to
    a documentation address (a UDP connect sends no packet). A list may be
    empty."""
    found = []
    try:
        last = None
        with open("/proc/net/fib_trie") as f:
            for line in f:
                m = re.search(r"\|-- (\d+\.\d+\.\d+\.\d+)\s*$", line)
                if m:
                    last = m.group(1)
                elif "/32 host LOCAL" in line and last and last not in found:
                    found.append(last)
    except OSError:
        pass
    if not found:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            try:
                s.connect(("192.0.2.1", 9))
                found.append(s.getsockname()[0])
            finally:
                s.close()
        except OSError:
            pass
    return [a for a in found if not a.startswith("127.") and a != "0.0.0.0"]


def screen_path():
    return os.path.join(STATE_DIR, "screen.json")


# The group that may read screen.json (the panel app). None: only this user.
SCREEN_GROUP = os.environ.get("TSX_SETUP_SCREEN_GROUP", "tsx-setup-screen")


def screen_gid():
    """The gid of SCREEN_GROUP when this process is a member, else None."""
    try:
        import grp
        gid = grp.getgrnam(SCREEN_GROUP).gr_gid
    except (KeyError, ImportError):
        return None
    return gid if gid in os.getgroups() or gid == os.getgid() else None


def write_screen():
    """Write screen.json: a temporary file with mode 600 (640 for the group
    of the screen), then a rename."""
    code, code_at = PAIRING.current_code()
    obj = {"code": code, "port": PORT, "path": "/setup", "addresses": local_addresses(),
           "remaining": max(0, int(WINDOW - (time.monotonic() - code_at))), "uptime": _uptime_seconds()}
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = os.path.join(STATE_DIR, ".screen.json.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        gid = screen_gid()
        if gid is None:
            os.fchmod(fd, 0o600)
        else:
            os.fchown(fd, -1, gid)
            os.fchmod(fd, 0o640)
        os.write(fd, (json.dumps(obj) + "\n").encode())
    finally:
        os.close(fd)
    os.rename(tmp, screen_path())


def screen_remove():
    _screen["on"] = False
    _screen["at"] = float("-inf")
    try:
        os.unlink(screen_path())
    except OSError:
        pass


def screen_update():
    """Called once a second. Write screen.json while the pairing code works
    (pairing_open), at least every REFRESH_S. Remove it when the window
    closes. The login with Home Assistant needs no code on the screen."""
    try:
        if not pairing_open():
            if _screen["on"]:
                screen_remove()
            return
        now = time.monotonic()
        if _screen["on"] and now - _screen["at"] < REFRESH_S:
            return
        write_screen()
        _screen["on"] = True
        _screen["at"] = now
        _screen["err"] = False
    except OSError as e:
        if not _screen["err"]:
            sys.stderr.write("tsx-setupd: cannot write %s: %s\n" % (screen_path(), e))
        _screen["err"] = True


# ---- listening address: loopback-only unless the LAN can log in --------
#
# The HTTP handler already refuses a non-loopback request once !lan_allowed()
# (a defensive second layer). But the process should not even ACCEPT a LAN
# connection when no LAN login is possible: no pairing window and no login
# with Home Assistant (no Home Assistant URL, or TSX_SETUP_HA_LOGIN=off).
# With no listening socket on a LAN-reachable address, the network has
# nothing to probe, fingerprint or exploit then. With the login with Home
# Assistant, the page is always on: every request needs a session. ServerManager rebinds between "0.0.0.0" (LAN allowed, this also
# serves loopback) and "127.0.0.1" (LAN not allowed) as lan_allowed()
# changes. It polls POLL_S seconds apart. A submit or an external change of
# setup-open takes effect on the next poll, at most POLL_S seconds later.
#
# A rebind briefly closes the old socket before the new one is listening.
# The two addresses overlap ("0.0.0.0" includes "127.0.0.1"), so the process
# cannot bind both on the same port at once. A request that lands in that
# gap, including one from the kiosk itself over loopback, gets a connection
# reset or refusal instead of an answer. This is the same class of transient
# failure as tsx-setupd not having started yet (kiosk-session already waits
# and retries for that, see the "Setup page" docs of the board repository).
# It is not a new one. A client must retry and not treat one reset as final.
POLL_S = 1.0


class ServerManager:
    def __init__(self):
        self.lock = threading.Lock()
        self.server = None
        self.host = None

    def _desired_host(self):
        return "0.0.0.0" if lan_allowed() else "127.0.0.1"

    def ensure(self):
        with self.lock:
            want = self._desired_host()
            if want == self.host and self.server is not None:
                return
            if self.server is not None:
                # Release the old socket FIRST. Binding "0.0.0.0:PORT" while
                # "127.0.0.1:PORT" is still held (or the reverse) is the same
                # address for the kernel, and it fails with EADDRINUSE.
                # shutdown() stops the accept loop. Call it from here, not
                # from inside its own serve_forever thread (BaseServer
                # requires this). server_close() then frees the port.
                self.server.shutdown()
                self.server.server_close()
                self.server = None
            self.server = ThreadingHTTPServer((want, PORT), Handler)
            self.host = want
            threading.Thread(target=self.server.serve_forever, daemon=True, name="tsx-setupd-http").start()
            sys.stderr.write("tsx-setupd: listening on %s:%d (lan=%s window=%ds ha-login=%s)\n"
                              % (want, PORT, "on" if LAN_ON else "off", WINDOW,
                                 "on" if HA_LOGIN and ha_url() else ("no URL" if HA_LOGIN else "off")))

    def watch_forever(self):
        was_open = setup_open_fresh()
        while True:
            try:
                self.ensure()
            except OSError as e:
                sys.stderr.write("tsx-setupd: bind failed: %s (retrying)\n" % e)
            screen_update()
            # A reopened window (tsx-config setup or overlay "Setup") can
            # simply run out on a configured panel. Then take the kiosk back
            # to Home Assistant. kiosk-session picks the URL only at start,
            # so without this the page stayed up until the next restart.
            now_open = setup_open_fresh()
            if was_open and not now_open and is_configured():
                clear_setup_open()
                if kiosk_enabled():
                    sys.stderr.write("tsx-setupd: setup window expired: back to Home Assistant\n")
                    restart_kiosk()
                else:
                    sys.stderr.write("tsx-setupd: setup window expired\n")
            was_open = now_open
            time.sleep(POLL_S)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    # SIGTERM (rc-service stop) ends the process through SystemExit, so that
    # the finally block removes screen.json.
    signal.signal(signal.SIGTERM, lambda _sig, _frame: sys.exit(0))
    mgr = ServerManager()
    screen_remove()    # a file from an earlier run is stale
    try:
        mgr.ensure()
        mgr.watch_forever()
    except KeyboardInterrupt:
        pass
    finally:
        screen_remove()
    return 0


if __name__ == "__main__":
    sys.exit(main())
