        <select id="f-pwake" name="PRESENCE_WAKE">
          <option value="">(default: on)</option>
          <option value="on">On</option>
          <option value="off">Off</option>
        </select>
        <label for="f-pdist">Near distance (millimeters, 100 to 4000)</label>
        <input id="f-pdist" name="PRESENCE_DISTANCE_MM" type="number" min="100" max="4000" placeholder="(default of the unit)">
        <label for="f-phold">Away after (seconds without a target, 1 to 3600)</label>
        <input id="f-phold" name="PRESENCE_HOLD_S" type="number" min="1" max="3600" placeholder="(default: 30)">
        </div>
        <label for="f-autobri">Backlight follows the ambient light</label>
        <select id="f-autobri" name="AUTO_BRIGHTNESS">
          <option value="">(default: on)</option>
          <option value="on">On</option>
          <option value="off">Off</option>
        </select>
        <label for="f-alsscale">Light sensor scale (0.01 to 1000)</label>
        <input id="f-alsscale" name="ALS_SCALE" type="text" inputmode="decimal" placeholder="(default: 1)" maxlength="8">
        <label>Learned brightness</label>
        <button type="button" class="secondary" id="learn-reset">Forget the learned brightness</button>
        <div class="status" id="learn-status"></div>
        <div class="hint">When the backlight follows the ambient light, the panel remembers the brightness that you set by hand and holds for a few seconds. This button removes what it learned.</div>
        <div class="hint" id="als-hint">The light sensor sits behind the front window, which passes only part of the light. Lux is the sensor lux times this scale.</div>
      </div>
    </details>

    <!--SLOT:details-->

    <h2>Access</h2>
    <div class="card">
      <label for="f-rootpw">Root password</label>
      <input id="f-rootpw" name="ROOT_PASSWORD" type="password" autocomplete="new-password" minlength="8">
      <div class="hint">8 characters or more. Leave blank to keep the present password. A panel that has none asks for one at the first login on its screen.</div>
      <label for="f-sshkey">SSH public key (optional)</label>
      <textarea id="f-sshkey" name="SSH_AUTHORIZED_KEY" rows="2" placeholder="ssh-ed25519 AAAA... you@host"></textarea>
    </div>

