  min-height:52px; font-size:1.05rem; padding:10px 20px; border-radius:10px; border:none;
  background:var(--accent); color:var(--accent-fg); font-weight:600; cursor:pointer;
}
button.secondary { background:#232a33; color:var(--fg); }
button:disabled { opacity:.5; }
.row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
.status { font-size:.9rem; margin-top:6px; }
.status.ok { color:var(--ok); } .status.bad { color:var(--bad); } .status.warn { color:var(--warn); }
.choice { display:flex; align-items:flex-start; gap:10px; padding:10px 0; }
.choice input { width:22px; height:22px; margin-top:3px; flex-shrink:0; }
.choice div b { display:block; }
.choice div span { color:var(--muted); font-size:.88rem; }
.code-banner { background:var(--panel); border:1px solid var(--accent); border-radius:14px;
  padding:14px 18px; margin-bottom:16px; display:none; }
.code-banner .code { font-size:1.8rem; letter-spacing:.15em; font-weight:700; color:var(--accent); }
details summary { cursor:pointer; color:var(--muted); padding:8px 0; }
#gate, #form, #done, #stale { display:none; }
#stale { border-color:var(--warn); }
.toggle { display:flex; align-items:center; gap:12px; }
.toggle input { width:44px; height:26px; }
a.btn { display:inline-block; text-align:center; text-decoration:none; box-sizing:border-box; min-height:52px;
  line-height:32px; font-size:1.05rem; padding:10px 20px; border-radius:10px; background:var(--accent);
  color:var(--accent-fg); font-weight:600; }
#session-bar, #panel-wrap { display:none; }
#session-bar .row { justify-content:space-between; }
.ctl { margin:14px 0; }
.ctl:first-child { margin-top:0; }
.ctl label { margin:0 0 6px; }
.ctl input[type=range] { width:100%; min-height:40px; }
.ctl input[type=color] { width:64px; min-height:44px; border:1px solid var(--line); border-radius:10px; background:#0e1319; }
.ctl .row input[type=number] { flex:1; min-width:120px; }
.sess { padding:8px 0; border-top:1px solid var(--line); font-size:.9rem; }
@media (max-height:640px) { .wrap { padding-top:10px; } h2 { margin-top:18px; padding-top:12px; } }
</style></head>
