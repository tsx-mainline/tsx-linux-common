#!/usr/bin/env python3
"""tsx-bench-compare: compare the result files of tsx-bench (host side).

usage: tsx-bench-compare [--md FILE] [--html FILE] [--title TEXT] [--no-text]
                         RESULT.json [RESULT.json ...]

The tool reads the JSON files that `tsx-bench` wrote (schema tsx-bench/1) and
prints a Markdown report on stdout. Every row has a relative score: the best
panel in the row gets 100. For a value where more is better, the score is
100 * value / best. For a time or a latency, it is 100 * best / value. A group
score is the geometric mean of the row scores of the group. The overall score
is the geometric mean of the group scores.

Groups in the overall score: CPU, Memory, Sustained load, Storage, Browser JS,
Browser rendering. Network and temperature are shown and not scored, because
they depend on the room and on the network, not on the panel.

--md FILE    also write the report to FILE
--html FILE  write one self-contained HTML page (no script, no network)
--title TEXT title of the report (default "Panel benchmark")

Python 3, standard library only.
"""
import argparse
import html
import json
import math
import sys

SCHEMA = "tsx-bench/1"


def get(d, *path):
    """Walk a path of keys and list indexes. Return None when a step is missing."""
    for p in path:
        if isinstance(d, dict) and p in d:
            d = d[p]
        elif isinstance(d, list) and isinstance(p, int) and 0 <= p < len(d):
            d = d[p]
        else:
            return None
    return d


def num(x):
    return x if isinstance(x, (int, float)) and not isinstance(x, bool) else None


class Metric:
    def __init__(self, group, name, unit, better, fn, scored=True):
        self.group, self.name, self.unit, self.better, self.fn = group, name, unit, better, fn
        self.scored = scored

    def value(self, r):
        try:
            return num(self.fn(r))
        except (KeyError, IndexError, TypeError, ValueError):
            return None


HIGH, LOW = "high", "low"


def metrics():
    m = []
    cpu_names = [("sha256", "SHA-256"), ("crc32", "CRC-32"), ("nbody", "n-body (float)"), ("matmul", "matrix multiply (float)")]
    for key, label in cpu_names:
        unit = {"sha256": "MiB/s", "crc32": "MiB/s", "nbody": "Ksteps/s", "matmul": "MFLOPS"}[key]
        m.append(Metric("CPU", "1 thread, best core: " + label, unit, HIGH,
                        lambda r, k=key: get(r, "cpu", "tests", k, "best_single")))
    for key, label in cpu_names:
        unit = {"sha256": "MiB/s", "crc32": "MiB/s", "nbody": "Ksteps/s", "matmul": "MFLOPS"}[key]
        m.append(Metric("CPU", "all cores: " + label, unit, HIGH,
                        lambda r, k=key: get(r, "cpu", "tests", k, "multi", "rate")))
    m.append(Metric("CPU", "busybox sha256sum, 24 MiB", "s", LOW, lambda r: get(r, "crosscheck", "sha256sum", "seconds")))
    m.append(Metric("CPU", "busybox gzip -3", "s", LOW, lambda r: get(r, "crosscheck", "gzip3", "seconds")))
    m.append(Metric("CPU", "busybox gunzip", "s", LOW, lambda r: get(r, "crosscheck", "gunzip", "seconds")))

    for t, label in [("read", "read"), ("write", "write"), ("copy", "copy"), ("triad", "triad")]:
        m.append(Metric("Memory", "1 thread " + label, "MB/s", HIGH, lambda r, t=t: get(r, "mem", "best_single", t)))
    for t, label in [("read", "read"), ("write", "write"), ("copy", "copy"), ("triad", "triad")]:
        m.append(Metric("Memory", "all cores " + label, "MB/s", HIGH, lambda r, t=t: get(r, "mem", "multi", t)))

    def lat(r, kib):
        for e in get(r, "mem", "latency") or []:
            if e.get("kib") == kib:
                return e.get("ns")
        return None
    m.append(Metric("Memory", "latency 1 MiB (cache)", "ns", LOW, lambda r: lat(r, 1024)))
    m.append(Metric("Memory", "latency 64 MiB (RAM)", "ns", LOW, lambda r: lat(r, 65536)))

    m.append(Metric("Sustained load", "rate, first 10 s", "chunks/s", HIGH, lambda r: get(r, "sustained", "summary", "rate_first10")))
    m.append(Metric("Sustained load", "rate, last 10 s", "chunks/s", HIGH, lambda r: get(r, "sustained", "summary", "rate_last10")))
    m.append(Metric("Sustained load", "last 10 s / first 10 s", "ratio", HIGH, lambda r: get(r, "sustained", "summary", "ratio_last_first")))
    m.append(Metric("Sustained load", "hottest sensor", "deg C", LOW,
                    lambda r: (get(r, "sustained", "summary", "temp_max_mC") or 0) / 1000.0 or None, scored=False))

    m.append(Metric("Storage", "sequential read (page cache path)", "MB/s", HIGH, lambda r: get(r, "storage", "seq_read", "mbps")))
    m.append(Metric("Storage", "sequential read (O_DIRECT, 1 MiB)", "MB/s", HIGH, lambda r: get(r, "storage", "seq_read_direct", "mbps")))
    m.append(Metric("Storage", "random 4 KiB read", "IOPS", HIGH, lambda r: get(r, "storage", "rand_read_4k", "iops")))
    m.append(Metric("Storage", "random 4 KiB read, p99", "ms", LOW, lambda r: get(r, "storage", "rand_read_4k", "p99_ms")))

    for k in ["int", "float", "array", "json", "typed"]:
        m.append(Metric("Browser JS", "JS " + k, "ms", LOW, lambda r, k=k: get(r, "browser", "page", "js", k + "_ms")))

    def fps(*path):
        return lambda r: get(r, "browser", "page", *path, "fps")
    for label, path in [
        ("canvas 2D, 300 shapes", ("canvas2d", "n300")),
        ("canvas 2D, 1500 shapes", ("canvas2d", "n1500")),
        ("canvas 2D, 6000 shapes", ("canvas2d", "n6000")),
        ("CSS transform, 200 boxes", ("css_transform", "n200")),
        ("CSS transform, 800 boxes", ("css_transform", "n800")),
        ("CSS layout, 150 boxes", ("css_layout",)),
        ("list scroll, 1500 rows", ("scroll",)),
        ("WebGL shader, 8 loops", ("webgl", "fill", "loops8")),
        ("WebGL shader, 32 loops", ("webgl", "fill", "loops32")),
        ("WebGL shader, 128 loops", ("webgl", "fill", "loops128")),
        ("WebGL, 1500 draw calls", ("webgl", "draw_calls")),
    ]:
        m.append(Metric("Browser rendering", label, "fps", HIGH, fps(*path)))

    m.append(Metric("Network", "upload to the build host", "Mbit/s", HIGH, lambda r: get(r, "net", "upload_mbit"), scored=False))
    m.append(Metric("Network", "download from the build host", "Mbit/s", HIGH, lambda r: get(r, "net", "download_mbit"), scored=False))
    return m


GROUP_ORDER = ["CPU", "Memory", "Sustained load", "Storage", "Browser JS", "Browser rendering", "Network"]
SCORED_GROUPS = [g for g in GROUP_ORDER if g != "Network"]


def load(paths):
    runs = []
    for p in paths:
        try:
            with open(p, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError) as e:
            sys.exit("tsx-bench-compare: cannot read %s: %s" % (p, e))
        if not isinstance(d, dict) or d.get("schema") != SCHEMA:
            sys.exit("tsx-bench-compare: %s is not a %s file" % (p, SCHEMA))
        d["_path"] = p
        runs.append(d)
    # column names: the label, plus the variant when it is not "normal"
    seen = {}
    for r in runs:
        name = str(r.get("label", "panel"))
        if r.get("variant") and r["variant"] != "normal":
            name += " (" + str(r["variant"]) + ")"
        seen[name] = seen.get(name, 0) + 1
        r["_name"] = name if seen[name] == 1 else "%s #%d" % (name, seen[name])
    return runs


def rel(values, better):
    """Relative scores, best = 100. values may hold None."""
    have = [v for v in values if v is not None and v > 0]
    if not have:
        return [None] * len(values)
    best = max(have) if better == HIGH else min(have)
    out = []
    for v in values:
        if v is None or v <= 0:
            out.append(None)
        elif better == HIGH:
            out.append(100.0 * v / best)
        else:
            out.append(100.0 * best / v)
    return out


def geomean(xs):
    xs = [x for x in xs if x is not None and x > 0]
    if not xs:
        return None
    return math.exp(sum(math.log(x) for x in xs) / len(xs))


def fmt(v, unit=""):
    if v is None:
        return "-"
    a = abs(v)
    if a >= 1000:
        s = "%.0f" % v
    elif a >= 100:
        s = "%.1f" % v
    elif a >= 10:
        s = "%.1f" % v
    else:
        s = "%.2f" % v
    return s


def analyze(runs):
    ms = metrics()
    rows = []
    for m in ms:
        vals = [m.value(r) for r in runs]
        if all(v is None for v in vals):
            continue
        rows.append({"m": m, "vals": vals, "rel": rel(vals, m.better) if m.scored else [None] * len(vals)})
    groups = {}
    for g in GROUP_ORDER:
        grows = [x for x in rows if x["m"].group == g and x["m"].scored]
        if not grows:
            continue
        groups[g] = [geomean([x["rel"][i] for x in grows]) for i in range(len(runs))]
    # re-base the group scores so that the best panel has 100
    def rebase(vals):
        b = max([v for v in vals if v is not None] or [0])
        return [100.0 * v / b if v is not None and b else None for v in vals]
    groups = {g: rebase(v) for g, v in groups.items()}
    scored = [g for g in groups if g in SCORED_GROUPS]
    # the overall score uses the groups that a panel has. A panel with a missing
    # group is marked, and a second score uses only the groups of every panel.
    overall = rebase([geomean([groups[g][i] for g in scored]) for i in range(len(runs))])
    missing = [[g for g in scored if groups[g][i] is None] for i in range(len(runs))]
    common = [g for g in scored if all(groups[g][i] is not None for i in range(len(runs)))]
    overall_common = None
    if any(missing) and common:
        overall_common = rebase([geomean([groups[g][i] for g in common]) for i in range(len(runs))])
    return rows, groups, (overall, overall_common, missing, common)


def info_rows(runs):
    def clusters(r):
        out = []
        for c in get(r, "info", "clusters") or []:
            n = len(c.get("cpus", []))
            f = c.get("max_khz")
            out.append("%d x %s%s" % (n, ("0x" + c["cpu_part"][2:]) if c.get("cpu_part", "").startswith("0x") else (c.get("cpu_part") or "cpu"),
                                      (" @ %.2f GHz" % (f / 1e6)) if f else ""))
        return ", ".join(out) or "-"

    def gov(r):
        gs = []
        for c in get(r, "info", "clusters") or []:
            if c.get("governor") and c["governor"] not in gs:
                gs.append(c["governor"])
        return ", ".join(gs) or "-"

    def gpu(r):
        w = get(r, "browser", "page", "webgl", "renderer")
        d = [x.get("driver") for x in get(r, "info", "drm_drivers") or []]
        s = ", ".join(x for x in d if x)
        return (s + (" / " + w if w else "")) or "-"

    def disp(r):
        d = get(r, "info", "displays", 0)
        return (d or {}).get("mode") or "-"

    def mem(r):
        k = get(r, "info", "mem_total_kb")
        return "%.1f GB" % (k / 1048576.0) if k else "-"

    def storage(r):
        s = r.get("storage") or {}
        return " ".join(str(x) for x in [s.get("type"), s.get("name")] if x) or "-"

    def kiosk(r):
        s = get(r, "state_before") or {}
        if s.get("kiosk_browser_procs") is None:
            return "-"
        return "kiosk running" if s["kiosk_browser_procs"] else "no kiosk"

    def load(r):
        s = get(r, "state_before") or {}
        la = s.get("loadavg") or []
        b = s.get("cpu_busy_pct")
        return "%s, cpu busy %s %%" % (la[0] if la else "-", ("%.0f" % b) if b is not None else "-")

    def temp(r):
        t = get(r, "state_before", "temp_mC")
        t = [x for x in (t or []) if x is not None]
        return "%.0f C" % (max(t) / 1000.0) if t else "-"

    def rendering_hz(r):
        h = get(r, "browser", "page", "refresh_hz")
        sc = get(r, "browser", "page", "env", "device_pixel_ratio")
        return ("%s Hz, scale %s" % (h, sc)) if h else "-"

    return [
        ("Model", lambda r: get(r, "info", "model") or "-"),
        ("Variant", lambda r: r.get("variant", "-")),
        ("Kernel", lambda r: get(r, "info", "kernel") or "-"),
        ("Cores", clusters),
        ("Governor", gov),
        ("RAM", mem),
        ("GPU", gpu),
        ("Display", disp),
        ("Storage", storage),
        ("Browser", rendering_hz),
        ("Kiosk before the run", kiosk),
        ("Load before the run", load),
        ("Hottest sensor before the run", temp),
        ("Run time", lambda r: "%s s%s" % (r.get("duration_s", "-"), " (quick)" if r.get("quick") else "")),
    ]


def md_escape(s):
    return str(s).replace("|", "\\|").replace("\n", " ")


def score_cell(v, vals, star, bold_best):
    if v is None:
        return "-"
    best = max(x for x in vals if x is not None)
    t = "%.0f%s" % (v, "*" if star else "")
    return "**%s**" % t if bold_best and v >= best - 1e-9 else t


def markdown(title, runs, rows, groups, overall):
    names = [r["_name"] for r in runs]
    out = ["# " + title, ""]
    out.append("Score: the best panel of a row has 100. More is better in every score.")
    out.append("")
    out.append("## Panels")
    out.append("")
    out.append("| | " + " | ".join(md_escape(n) for n in names) + " |")
    out.append("|---|" + "---|" * len(names))
    for label, fn in info_rows(runs):
        out.append("| %s | %s |" % (label, " | ".join(md_escape(fn(r)) for r in runs)))
    out.append("")
    out.append("## Scores")
    out.append("")
    out.append("| Group | " + " | ".join(md_escape(n) for n in names) + " |")
    out.append("|---|" + "---:|" * len(names))
    for g in GROUP_ORDER:
        if g in groups:
            vals = groups[g]
            best = max(v for v in vals if v is not None)
            out.append("| %s | %s |" % (g, " | ".join(
                ("**%.0f**" % v if v is not None and v >= best - 1e-9 else ("%.0f" % v if v is not None else "-")) for v in vals)))
    overall, overall_common, missing, common = overall
    out.append("| **Overall** | %s |" % " | ".join(
        score_cell(v, overall, bool(missing[i]), True) for i, v in enumerate(overall)))
    if overall_common:
        out.append("| **Overall, groups of every panel** | %s |" % " | ".join(
            score_cell(v, overall_common, False, True) for v in overall_common))
    out.append("")
    if any(missing):
        out.append("A star (*) marks an overall score that lacks groups: %s." % "; ".join(
            "%s has no %s" % (names[i], ", ".join(m)) for i, m in enumerate(missing) if m))
        out.append("The row \"groups of every panel\" uses only %s." % ", ".join(common))
        out.append("")
    for g in GROUP_ORDER:
        grows = [x for x in rows if x["m"].group == g]
        if not grows:
            continue
        out.append("## " + g)
        out.append("")
        out.append("| Test | Unit | " + " | ".join(md_escape(n) for n in names) + " |")
        out.append("|---|---|" + "---:|" * len(names))
        for x in grows:
            m = x["m"]
            cells = []
            for v, s in zip(x["vals"], x["rel"]):
                if v is None:
                    cells.append("-")
                elif s is None:
                    cells.append(fmt(v))
                elif s >= 99.995:
                    cells.append("**%s (100)**" % fmt(v))
                else:
                    cells.append("%s (%.0f)" % (fmt(v), s))
            out.append("| %s%s | %s | %s |" % (md_escape(m.name), "" if m.better == HIGH else " (less is better)",
                                              m.unit, " | ".join(cells)))
        out.append("")
    # the clusters of a big.LITTLE panel
    cl_lines = []
    for r in runs:
        tests = get(r, "cpu", "tests") or {}
        for k, t in tests.items():
            singles = t.get("single") or []
            if len(singles) > 1:
                cl_lines.append("| %s | %s | %s |" % (md_escape(r["_name"]), k, ", ".join(
                    "c%s %s" % (s.get("cluster"), fmt(s.get("rate"))) for s in singles)))
    if cl_lines:
        out.append("## Single-thread rate of each core cluster")
        out.append("")
        out.append("Cluster c0 is the biggest one.")
        out.append("")
        out.append("| Panel | Test | Clusters |")
        out.append("|---|---|---|")
        out.extend(cl_lines)
        out.append("")
    notes = []
    for r in runs:
        for key in ("browser", "storage", "net", "cpu", "mem", "sustained"):
            sec = r.get(key)
            if isinstance(sec, dict) and (sec.get("error") or sec.get("skipped") or sec.get("reason")):
                notes.append("%s, %s: %s" % (r["_name"], key, sec.get("error") or sec.get("skipped") or sec.get("reason")))
        if get(r, "sustained", "aborted_thermal"):
            notes.append("%s: the sustained load stopped at the thermal limit." % r["_name"])
        if get(r, "browser", "restore", "same_url") is False:
            notes.append("%s: the kiosk page was not confirmed after the browser test." % r["_name"])
        if r.get("quick"):
            notes.append("%s is a quick run and does not compare with a full run." % r["_name"])
    if notes:
        out.append("## Notes")
        out.append("")
        out.extend("- " + md_escape(n) for n in notes)
        out.append("")
    return "\n".join(out)


