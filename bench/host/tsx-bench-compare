def get(d, *path):
    """Walk a path of keys and list indexes. Return None when a step is missing."""
    for p in path:
        if isinstance(d, dict) and p in d:
            d = d[p]
        elif isinstance(d, list) and isinstance(p, int) and 0 <= p < len(d):
            d = d[p]
        else:
            return None
    return d


def num(x):
    return x if isinstance(x, (int, float)) and not isinstance(x, bool) else None


def get_path(d, path):
    """Walk a path like "mem.latency[kib=1024].ns". A step NAME[KEY=N] takes the
    entry of the list NAME whose KEY is N."""
    for seg in path.split("."):
        m = re.match(r"^(\w+)\[(\w+)=(\d+)\]$", seg)
        if m:
            lst = get(d, m.group(1))
            if not isinstance(lst, list):
                return None
            d = None
            for e in lst:
                if isinstance(e, dict) and e.get(m.group(2)) == int(m.group(3)):
                    d = e
                    break
        else:
            d = get(d, seg)
        if d is None:
            return None
    return d


class Metric:
    def __init__(self, group, name, unit, better, fn, kind=None, score_unit=None):
        self.group, self.name, self.unit, self.better, self.fn = group, name, unit, better, fn
        self.kind = kind
        self.score_unit = score_unit
        self.scored = kind is not None

    def value(self, r):
        try:
            return num(self.fn(r))
        except (KeyError, IndexError, TypeError, ValueError):
            return None

    def score(self, v):
        """The score of a value, a rate in the unit of the row, or None."""
        if v is None or v <= 0 or not self.scored:
            return None
        return {"R": v, "I1": 1.0 / v, "I1000": 1000.0 / v}[self.kind]


def metrics():
    m = []
    for group, name, unit, kind, path, score_unit in SCORE_TABLE:
        m.append(Metric(group, name, unit, LOW if kind != "R" else HIGH, lambda r, p=path: get_path(r, p), kind, score_unit))
        if path == "sustained.summary.rate_last10":
            m.append(Metric("Sustained load", "last 10 s / first 10 s (not scored)", "ratio", HIGH,
                            lambda r: get(r, "sustained", "summary", "ratio_last_first")))
            m.append(Metric("Sustained load", "hottest sensor (not scored)", "deg C", LOW,
                            lambda r: (get(r, "sustained", "summary", "temp_max_mC") or 0) / 1000.0 or None))
    m.append(Metric("Network", "upload to the build host", "Mbit/s", HIGH, lambda r: get(r, "net", "upload_mbit")))
    m.append(Metric("Network", "download from the build host", "Mbit/s", HIGH, lambda r: get(r, "net", "download_mbit")))
    return m


def row_lines():
    return ["%s|%s|%s|%s|%s" % (g, n, k, p, su) for g, n, u, k, p, su in SCORE_TABLE]


def load(paths):
    runs = []
    for p in paths:
        try:
            with open(p, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError) as e:
            sys.exit("tsx-bench-compare: cannot read %s: %s" % (p, e))
        if not isinstance(d, dict) or d.get("schema") != SCHEMA:
            sys.exit("tsx-bench-compare: %s is not a %s file" % (p, SCHEMA))
        d["_path"] = p
        runs.append(d)
    # column names: the label, plus the variant when it is not "normal"
    seen = {}
    for r in runs:
        name = str(r.get("label", "panel"))
        if r.get("variant") and r["variant"] != "normal":
            name += " (" + str(r["variant"]) + ")"
        seen[name] = seen.get(name, 0) + 1
        r["_name"] = name if seen[name] == 1 else "%s #%d" % (name, seen[name])
    return runs



def geomean(xs):
    xs = [x for x in xs if x is not None and x > 0]
    if not xs:
        return None
    return math.exp(sum(math.log(x) for x in xs) / len(xs))


def fmt(v, unit=""):
    if v is None:
        return "-"
    a = abs(v)
    if a >= 1000:
        s = "%.0f" % v
    elif a >= 100:
        s = "%.1f" % v
    elif a >= 10:
        s = "%.1f" % v
    else:
        s = "%.2f" % v
    return s




def info_rows(runs):
    def clusters(r):
        out = []
        for c in get(r, "info", "clusters") or []:
            n = len(c.get("cpus", []))
            f = c.get("max_khz")
            out.append("%d x %s%s" % (n, ("0x" + c["cpu_part"][2:]) if c.get("cpu_part", "").startswith("0x") else (c.get("cpu_part") or "cpu"),
                                      (" @ %.2f GHz" % (f / 1e6)) if f else ""))
        return ", ".join(out) or "-"

    def gov(r):
        gs = []
        for c in get(r, "info", "clusters") or []:
            if c.get("governor") and c["governor"] not in gs:
                gs.append(c["governor"])
        return ", ".join(gs) or "-"

    def gpu(r):
        w = get(r, "browser", "page", "webgl", "renderer")
        d = [x.get("driver") for x in get(r, "info", "drm_drivers") or []]
        s = ", ".join(x for x in d if x)
        return (s + (" / " + w if w else "")) or "-"

    def disp(r):
        d = get(r, "info", "displays", 0)
        return (d or {}).get("mode") or "-"

    def mem(r):
        k = get(r, "info", "mem_total_kb")
        return "%.1f GB" % (k / 1048576.0) if k else "-"

    def storage(r):
        s = r.get("storage") or {}
        return " ".join(str(x) for x in [s.get("type"), s.get("name")] if x) or "-"

    def kiosk(r):
        s = get(r, "state_before") or {}
        if s.get("kiosk_browser_procs") is None:
            return "-"
        return "kiosk running" if s["kiosk_browser_procs"] else "no kiosk"

    def load(r):
        s = get(r, "state_before") or {}
        la = s.get("loadavg") or []
        b = s.get("cpu_busy_pct")
        return "%s, cpu busy %s %%" % (la[0] if la else "-", ("%.0f" % b) if b is not None else "-")

    def temp(r):
        t = get(r, "state_before", "temp_mC")
        t = [x for x in (t or []) if x is not None]
        return "%.0f C" % (max(t) / 1000.0) if t else "-"

    def rendering_hz(r):
        h = get(r, "browser", "page", "refresh_hz")
        sc = get(r, "browser", "page", "env", "device_pixel_ratio")
        return ("%s Hz, scale %s" % (h, sc)) if h else "-"

    return [
        ("Model", lambda r: get(r, "info", "model") or "-"),
        ("Variant", lambda r: r.get("variant", "-")),
        ("Kernel", lambda r: get(r, "info", "kernel") or "-"),
        ("Cores", clusters),
        ("Governor", gov),
        ("RAM", mem),
        ("GPU", gpu),
        ("Display", disp),
        ("Storage", storage),
        ("Browser", rendering_hz),
        ("Kiosk before the run", kiosk),
        ("Load before the run", load),
        ("Hottest sensor before the run", temp),
        ("Run time", lambda r: "%s s%s" % (r.get("duration_s", "-"), " (quick)" if r.get("quick") else "")),
    ]



def pct_of_best(vals):
    """The percentage of the best value in a list that may hold None."""
    have = [v for v in vals if v is not None]
    best = max(have) if have else 0
    return [100.0 * v / best if v is not None and best else None for v in vals]


def analyze(runs):
    """Return rows, groups, overall.

    rows: one entry per test with the values, the scores and the percentages
    groups: group name -> list of scores, one for each panel
    overall: dict with the overall score, the core score and the missing groups
    """
    rows = []
    for m in metrics():
        vals = [m.value(r) for r in runs]
        if all(v is None for v in vals):
            continue
        scores = [m.score(v) for v in vals]
        rows.append({"m": m, "vals": vals, "score": scores, "pct": pct_of_best(scores)})
    groups = {}
    for g in GROUP_ORDER:
        grows = [x for x in rows if x["m"].group == g and x["m"].scored]
        if not grows:
            continue
        groups[g] = [geomean([x["score"][i] for x in grows]) for i in range(len(runs))]
    scored = [g for g in groups if g in SCORED_GROUPS]
    n = len(runs)
    # The overall score needs all six groups. A panel with a missing group has no
    # overall score and is compared by the core score.
    missing = [[g for g in SCORED_GROUPS if g not in groups or groups[g][i] is None] for i in range(n)]
    overall = [None if missing[i] else geomean([groups[g][i] for g in scored]) for i in range(n)]
    core = [geomean([groups[g][i] for g in CORE_GROUPS if g in groups]) for i in range(n)]
    core_missing = [[g for g in CORE_GROUPS if g not in groups or groups[g][i] is None] for i in range(n)]
    return rows, groups, {"overall": overall, "core": core, "missing": missing, "core_missing": core_missing}


def sc(v, star=False):
    """A score or a value with about four digits."""
    if v is None:
        return "-"
    a = abs(v)
    t = "%.0f" % v if a >= 100 else ("%.1f" % v if a >= 10 else "%.2f" % v)
    return t + ("*" if star else "")


def factor(v, best):
    """The score of the best panel divided by this score."""
    return "%.2fx" % (best / v)


def cmp_text(score, pct):
    """The text of a Comparison cell: the score, the percentage of the best panel
    and the factor of the best panel."""
    return "%s (%.0f %%, %s)" % (sc(score), pct, factor(score, score * 100.0 / pct))


def star_note(names, ov):
    out = []
    if any(ov["missing"]):
        out.append("No overall score for: %s. Compare these panels by the core score, which uses only %s." % (
            "; ".join("%s (no %s)" % (names[i], ", ".join(m)) for i, m in enumerate(ov["missing"]) if m),
            ", ".join(CORE_GROUPS)))
    if any(ov["core_missing"]):
        out.append("A star (*) on a core score marks a panel that lacks core groups: %s." % "; ".join(
            "%s has no %s" % (names[i], ", ".join(m)) for i, m in enumerate(ov["core_missing"]) if m))
    return out


def score_rows(groups, ov):
    """The rows of the headline table: (label, scores, stars, bold)."""
    out = []
    for g in GROUP_ORDER:
        if g in groups:
            out.append((g, groups[g], [False] * len(groups[g]), False))
    out.append(("Overall", ov["overall"], [False] * len(ov["overall"]), True))
    out.append(("Core (CPU, Memory, Sustained load, Storage)", ov["core"], [bool(m) for m in ov["core_missing"]], True))
    return out


INTRO = ("Score version %d. No panel is the reference. The score of a row is a rate in the unit of the row "
         "(a time becomes runs per second, a latency becomes accesses per microsecond). "
         "The score of a group is the geometric mean of its rows. "
         "The overall score is the geometric mean of the six groups, and only a panel that has every group gets one. "
         "The core score uses only CPU, Memory, Sustained load and Storage, and every panel has one. "
         "More is better in every score. The unit of a group and of an overall score is the geometric-mean unit. "
         "The ratio of two scores does not depend on the units of the rows." % SCORE_VERSION)


def md_escape(s):
    return str(s).replace("|", "\\|").replace("\n", " ")


def notes_for(runs):
    notes = []
    for r in runs:
        for key in ("browser", "storage", "net", "cpu", "mem", "sustained"):
            sec = r.get(key)
            if isinstance(sec, dict) and (sec.get("error") or sec.get("skipped") or sec.get("reason")):
                notes.append("%s, %s: %s" % (r["_name"], key, sec.get("error") or sec.get("skipped") or sec.get("reason")))
        if get(r, "sustained", "aborted_thermal"):
            notes.append("%s: the sustained load stopped at the thermal limit." % r["_name"])
        if get(r, "browser", "restore", "same_url") is False:
            notes.append("%s: the kiosk page was not confirmed after the browser test." % r["_name"])
        if r.get("quick"):
            notes.append("%s is a quick run and does not compare with a full run." % r["_name"])
        v = get(r, "scores", "score_version")
        if v is not None and v != SCORE_VERSION:
            notes.append("%s holds scores of version %s. This tool computed version %d from the values."
                         % (r["_name"], v, SCORE_VERSION))
    return notes


def markdown(title, runs, rows, groups, ov):
    names = [r["_name"] for r in runs]
    head = "| | " + " | ".join(md_escape(n) for n in names) + " |"
    out = ["# " + title, "", INTRO, ""]
    out.append("## Panels")
    out.append("")
    out.append(head)
    out.append("|---|" + "---|" * len(names))
    for label, fn in info_rows(runs):
        out.append("| %s | %s |" % (label, " | ".join(md_escape(fn(r)) for r in runs)))
    out.append("")
    out.append("## Scores")
    out.append("")
    out.append("| Group | " + " | ".join(md_escape(n) for n in names) + " |")
    out.append("|---|" + "---:|" * len(names))
    for label, vals, stars, bold in score_rows(groups, ov):
        best = max([v for v in vals if v is not None] or [0])
        cells = []
        for v, st in zip(vals, stars):
            t = sc(v, st)
            cells.append("**%s**" % t if v is not None and v >= best - 1e-9 and len(vals) > 1 else t)
        out.append("| %s | %s |" % ("**%s**" % label if bold else label, " | ".join(cells)))
    out.append("")
    out.extend(star_note(names, ov))
    if any(ov["missing"]) or any(ov["core_missing"]):
        out.append("")
    for g in GROUP_ORDER:
        grows = [x for x in rows if x["m"].group == g]
        if not grows:
            continue
        out.append("## " + g)
        out.append("")
        out.append("| Test | Unit | " + " | ".join(md_escape(n) for n in names) + " |")
        out.append("|---|---|" + "---:|" * len(names))
        for x in grows:
            m = x["m"]
            best = max([s for s in x["score"] if s is not None] or [0])
            cells = []
            for v, s in zip(x["vals"], x["score"]):
                if v is None:
                    cells.append("-")
                elif s is None:
                    cells.append(fmt(v))
                elif s >= best - 1e-9 and len(runs) > 1:
                    cells.append("**%s**" % fmt(v))
                else:
                    cells.append(fmt(v))
            out.append("| %s%s | %s | %s |" % (md_escape(m.name), "" if m.better == HIGH else " (less is better)",
                                              m.unit, " | ".join(cells)))
        out.append("")
    # the clusters of a big.LITTLE panel
    cl_lines = []
    for r in runs:
        tests = get(r, "cpu", "tests") or {}
        for k, t in tests.items():
            singles = t.get("single") or []
            if len(singles) > 1:
                cl_lines.append("| %s | %s | %s |" % (md_escape(r["_name"]), k, ", ".join(
                    "c%s %s" % (s.get("cluster"), fmt(s.get("rate"))) for s in singles)))
    if cl_lines:
        out.append("## Single-thread rate of each core cluster")
        out.append("")
        out.append("Cluster c0 is the biggest one.")
        out.append("")
        out.append("| Panel | Test | Clusters |")
        out.append("|---|---|---|")
        out.extend(cl_lines)
        out.append("")
    # the panels side by side
    out.append("## Comparison")
    out.append("")
    out.append("Each cell shows the score, the percentage of the best panel in the row and the factor "
               "of the best panel (the best score divided by the score of the panel). The best panel of a row is in bold. The score unit of a row is in its second column.")
    out.append("")
    out.append("### Scores")
    out.append("")
    out.append("| Group | " + " | ".join(md_escape(n) for n in names) + " |")
    out.append("|---|" + "---:|" * len(names))
    for label, vals, stars, bold in score_rows(groups, ov):
        pct = pct_of_best(vals)
        cells = []
        for v, p, st in zip(vals, pct, stars):
            if v is None:
                cells.append("-")
                continue
            t = cmp_text(v, p).replace(sc(v), sc(v, st), 1)
            cells.append("**%s**" % t if p >= 99.995 and len(vals) > 1 else t)
        out.append("| %s | %s |" % ("**%s**" % label if bold else label, " | ".join(cells)))
    out.append("")
    for g in GROUP_ORDER:
        grows = [x for x in rows if x["m"].group == g and x["m"].scored]
        if not grows:
            continue
        out.append("### " + g)
        out.append("")
        out.append("| Test | Score unit | " + " | ".join(md_escape(n) for n in names) + " |")
        out.append("|---|---|" + "---:|" * len(names))
        for x in grows:
            cells = []
            for s, p in zip(x["score"], x["pct"]):
                if s is None:
                    cells.append("-")
                else:
                    t = cmp_text(s, p)
                    cells.append("**%s**" % t if p >= 99.995 and len(runs) > 1 else t)
            out.append("| %s | %s | %s |" % (md_escape(x["m"].name), x["m"].score_unit, " | ".join(cells)))
        out.append("")
    notes = notes_for(runs)
    if notes:
        out.append("## Notes")
        out.append("")
        out.extend("- " + md_escape(n) for n in notes)
        out.append("")
    return "\n".join(out)


