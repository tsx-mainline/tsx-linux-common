PALETTE = ["#4e79a7", "#f28e2b", "#59a14f", "#b07aa1", "#e15759", "#76b7b2", "#edc948", "#9c755f"]


def bar_cell(text, score, best):
    """A table cell whose background is a bar of width = score %."""
    w = 0 if score is None else max(0, min(100, score))
    cls = "n s" + (" best" if best else "")
    return '<td class="%s" style="background-image:linear-gradient(var(--bar),var(--bar));background-size:%.0f%% 100%%;' \
           'background-repeat:no-repeat;background-position:left">%s</td>' % (cls, w, html.escape(text))


def svg_chart(runs, series_fn, title, ylabel, ymin=None):
    """A line chart for the sustained samples. series_fn(run) -> list of values."""
    data = [(r["_name"], series_fn(r)) for r in runs]
    data = [(n, s) for n, s in data if s]
    if not data:
        return ""
    w, h, ml, mr, mt, mb = 720, 260, 56, 12, 28, 34
    xmax = max(len(s) for _, s in data)
    ys = [v for _, s in data for v in s if v is not None]
    lo = min(ys) if ymin is None else ymin
    hi = max(ys)
    if hi <= lo:
        hi = lo + 1
    pad = (hi - lo) * 0.05
    hi += pad
    if ymin is None:
        lo -= pad

    def px(i):
        return ml + (w - ml - mr) * (i / max(1, xmax - 1))

    def py(v):
        return mt + (h - mt - mb) * (1 - (v - lo) / (hi - lo))
    out = ['<svg viewBox="0 0 %d %d" role="img" aria-label="%s">' % (w, h, html.escape(title))]
    out.append('<text x="%d" y="16" font-size="13" fill="currentColor">%s</text>' % (ml, html.escape(title)))
    for k in range(5):
        v = lo + (hi - lo) * k / 4
        y = py(v)
        out.append('<line x1="%d" x2="%d" y1="%.1f" y2="%.1f" stroke="#8884" />' % (ml, w - mr, y, y))
        out.append('<text x="%d" y="%.1f" font-size="11" text-anchor="end" fill="currentColor">%.0f</text>' % (ml - 6, y + 4, v))
    out.append('<text x="%d" y="%d" font-size="11" text-anchor="middle" fill="currentColor">seconds</text>' % ((ml + w - mr) // 2, h - 6))
    out.append('<text x="12" y="%d" font-size="11" transform="rotate(-90 12 %d)" text-anchor="middle" fill="currentColor">%s</text>'
               % ((mt + h - mb) // 2, (mt + h - mb) // 2, html.escape(ylabel)))
    for i in range(0, xmax, max(1, xmax // 6)):
        out.append('<text x="%.1f" y="%d" font-size="11" text-anchor="middle" fill="currentColor">%d</text>' % (px(i), h - mb + 14, i + 1))
    for si, (n, s) in enumerate(data):
        pts = " ".join("%.1f,%.1f" % (px(i), py(v)) for i, v in enumerate(s) if v is not None)
        out.append('<polyline fill="none" stroke="%s" stroke-width="2" points="%s"><title>%s</title></polyline>'
                   % (PALETTE[si % len(PALETTE)], pts, html.escape(n)))
    out.append("</svg>")
    leg = '<p class="legend">' + "".join(
        '<span><i style="background:%s"></i>%s</span>' % (PALETTE[i % len(PALETTE)], html.escape(n)) for i, (n, _) in enumerate(data)) + "</p>"
    return "".join(out) + leg


def render_html(title, runs, rows, groups, overall):
    names = [r["_name"] for r in runs]
    h = ['<!doctype html><html lang="en"><head><meta charset="utf-8">',
         '<meta name="viewport" content="width=device-width, initial-scale=1">',
         "<title>%s</title><style>%s</style></head><body><main>" % (html.escape(title), CSS),
         "<h1>%s</h1>" % html.escape(title),
         '<p class="note">Score: the best panel of a row has 100. More is better in every score. '
         "A bar is as long as the score.</p>"]
    h.append("<h2>Scores</h2><div class=\"wrap\"><table><thead><tr><th>Group</th>%s</tr></thead><tbody>"
             % "".join("<th class=\"n\">%s</th>" % html.escape(n) for n in names))

    def score_row(label, vals, bold=False, stars=None):
        best = max([v for v in vals if v is not None] or [0])
        stars = stars or [False] * len(vals)
        cells = "".join(bar_cell("-" if v is None else "%.0f%s" % (v, "*" if st else ""), v, v is not None and v >= best - 1e-9)
                        for v, st in zip(vals, stars))
        return "<tr><td>%s</td>%s</tr>" % ("<b>%s</b>" % html.escape(label) if bold else html.escape(label), cells)
    for g in GROUP_ORDER:
        if g in groups:
            h.append(score_row(g, groups[g]))
    overall, overall_common, missing, common = overall
    h.append(score_row("Overall", overall, True, [bool(m) for m in missing]))
    if overall_common:
        h.append(score_row("Overall, groups of every panel", overall_common, True))
    h.append("</tbody></table></div>")
    if any(missing):
        h.append('<p class="note">A star (*) marks an overall score that lacks groups: %s.%s</p>' % (
            html.escape("; ".join("%s has no %s" % (names[i], ", ".join(m)) for i, m in enumerate(missing) if m)),
            html.escape(" The row for the groups of every panel uses only %s." % ", ".join(common)) if overall_common else ""))

    h.append("<h2>Panels</h2><div class=\"wrap\"><table><thead><tr><th></th>%s</tr></thead><tbody>"
             % "".join("<th>%s</th>" % html.escape(n) for n in names))
    for label, fn in info_rows(runs):
        h.append("<tr><td class=\"mute\">%s</td>%s</tr>" % (html.escape(label), "".join("<td>%s</td>" % html.escape(str(fn(r))) for r in runs)))
    h.append("</tbody></table></div>")

    for g in GROUP_ORDER:
        grows = [x for x in rows if x["m"].group == g]
        if not grows:
            continue
        h.append("<h2>%s</h2><div class=\"wrap\"><table><thead><tr><th>Test</th><th>Unit</th>%s</tr></thead><tbody>"
                 % (html.escape(g), "".join("<th class=\"n\">%s</th>" % html.escape(n) for n in names)))
        for x in grows:
            m = x["m"]
            cells = []
            for v, s in zip(x["vals"], x["rel"]):
                if v is None:
                    cells.append('<td class="n mute">-</td>')
                elif s is None:
                    cells.append('<td class="n">%s</td>' % html.escape(fmt(v)))
                else:
                    cells.append(bar_cell("%s (%.0f)" % (fmt(v), s), s, s >= 99.995))
            h.append("<tr><td>%s%s</td><td class=\"u\">%s</td>%s</tr>"
                     % (html.escape(m.name), "" if m.better == HIGH else ' <span class="mute">(less is better)</span>',
                        html.escape(m.unit), "".join(cells)))
        h.append("</tbody></table></div>")

    def rate_series(r):
        s = get(r, "sustained", "samples")
        if not s:
            return []
        first = [x["rate"] for x in s[:5] if num(x.get("rate"))]
        base = (sum(first) / len(first)) if first else 0
        return [100.0 * x["rate"] / base if base and num(x.get("rate")) is not None else None for x in s]

    def temp_series(r):
        s = get(r, "sustained", "samples")
        out = []
        for x in s or []:
            t = [v for v in x.get("temp_mC", []) if v is not None]
            out.append(max(t) / 1000.0 if t else None)
        return out

    def freq_series(r):
        s = get(r, "sustained", "samples")
        return [(x["khz"][0] / 1000.0) if x.get("khz") and x["khz"][0] and x["khz"][0] > 0 else None for x in s or []]
    ch = svg_chart(runs, rate_series, "Sustained load: work rate (first 5 s = 100)", "percent", 0)
    if ch:
        h.append("<h2>Sustained load over time</h2>" + ch)
        h.append(svg_chart(runs, temp_series, "Hottest sensor", "deg C"))
        h.append(svg_chart(runs, freq_series, "Frequency of the biggest cluster", "MHz", 0))
    notes = []
    for r in runs:
        for key in ("browser", "storage", "net", "cpu", "mem", "sustained"):
            sec = r.get(key)
            if isinstance(sec, dict) and (sec.get("error") or sec.get("skipped") or sec.get("reason")):
                notes.append("%s, %s: %s" % (r["_name"], key, sec.get("error") or sec.get("skipped") or sec.get("reason")))
        if r.get("quick"):
            notes.append("%s is a quick run and does not compare with a full run." % r["_name"])
    if notes:
        h.append("<h2>Notes</h2><ul>%s</ul>" % "".join("<li>%s</li>" % html.escape(n) for n in notes))
    h.append("</main></body></html>")
    return "\n".join(h)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Compare the result files of tsx-bench.", add_help=True)
    ap.add_argument("files", nargs="+", metavar="RESULT.json")
    ap.add_argument("--md", metavar="FILE", help="also write the Markdown report to FILE")
    ap.add_argument("--html", metavar="FILE", help="write a self-contained HTML page to FILE")
    ap.add_argument("--title", default="Panel benchmark")
    ap.add_argument("--no-text", action="store_true", help="do not print the report on stdout")
    a = ap.parse_args(argv)
    runs = load(a.files)
    rows, groups, overall = analyze(runs)
    md = markdown(a.title, runs, rows, groups, overall)
    if not a.no_text:
        print(md)
    if a.md:
        with open(a.md, "w", encoding="utf-8") as f:
            f.write(md + "\n")
    if a.html:
        with open(a.html, "w", encoding="utf-8") as f:
            f.write(render_html(a.title, runs, rows, groups, overall) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
