#!/sbin/openrc-run
# Schedules tsx-autoupdate through the existing crond (see kiosk's own
# KIOSK_RESTART_AT for the same idiom: an idempotent, tagged line in
# /etc/crontabs/root, rewritten on every start). Both modes (auto and manual)
# check on the schedule, so the line is always there. At each start the
# script records the running release (tsx-autoupdate boot), which ends the
# state "restart required". In the background, it runs "tsx-autoupdate check"
# once: /run/tsx is empty after a boot, and the status there (the HA update
# entity via tsx-esphome/tsx-mqtt) would otherwise read "unknown" until the
# first cron tick. Then it runs the post-update health check after a boot
# that followed an update restart (tsx-boot-ok's "background, delayed, never
# delays boot" pattern).
description="Schedule automatic Alpine package updates (tsx-autoupdate)"
HEALTH_DELAY=${HEALTH_DELAY:-90}
CHECK_DELAY=${CHECK_DELAY:-30}

depend() {
	need localmount crond
	after kiosk sshd
}

start_pre() {
	checkpath -d -m 0755 /run/tsx
	checkpath -d -m 0755 /var/lib/tsx/autoupdate
}

start() {
	ebegin "Scheduling tsx-autoupdate"
	sed -i '/# tsx-autoupdate$/d' /etc/crontabs/root 2>/dev/null
	echo "*/15 * * * * /usr/local/sbin/tsx-autoupdate >/dev/null 2>&1 # tsx-autoupdate" >> /etc/crontabs/root
	/usr/local/sbin/tsx-autoupdate boot >/dev/null 2>&1
	( sleep "$CHECK_DELAY"
	  /usr/local/sbin/tsx-autoupdate check
	  [ "$HEALTH_DELAY" -gt "$CHECK_DELAY" ] && sleep $((HEALTH_DELAY - CHECK_DELAY))
	  /usr/local/sbin/tsx-autoupdate healthcheck 2>&1 | logger -t tsx-autoupdate
	) >/dev/null 2>&1 &
	eend 0
}
