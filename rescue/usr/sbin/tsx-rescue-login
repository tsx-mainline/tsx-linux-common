#!/bin/sh
# tsx-rescue-login: choose who can log in to the rescue system. /etc/init.d/rcS
# runs it once, before it starts dropbear. The rescue has no fixed password.
#
#   1. The panel's own login. The script reads panel.conf on the tsxdata
#      file system (LABEL=tsxdata, read only), or /data/tsx/panel.conf on
#      the root file system (LABEL=tsxroot, read only) of a card that has no
#      tsxdata partition. It also takes the keys of root of the normal
#      system: root/.ssh/authorized_keys on tsxdata (tsx-data moved /root
#      there) and on the root file system. It uses ROOT_PASSWORD_HASH
#      and SSH_AUTHORIZED_KEY, the two values that the installer writes
#      (see tsx-rootpw). The hash becomes the password of root
#      in /etc/shadow. The key becomes /root/.ssh/authorized_keys.
#   2. A one-time password. If /data cannot be read, or panel.conf has
#      neither value, the script makes a random password for this boot. It
#      writes the password to $RUN/tsx-rescue-otp (mode 600, in RAM) only.
#      The rescue screen (tsx-rescue-status) shows it on the panel. Nothing
#      sends it to the network, to the kernel log or to a file on disk, so
#      only a person at the panel can log in. Run the script again to get a
#      new one.
#   3. A test build. If the image build put a password hash into /etc/shadow
#      (TSX_DEV_RESCUE_HASH, see the "Test builds" docs of the board repository), the
#      script
#      leaves it as it is. A public image never has one.
#
# The script writes the case to $RUN/tsx-rescue-login: panel, onetime or build.
# Test hooks: TSX_RESCUE_SHADOW TSX_RESCUE_ROOT TSX_RESCUE_RUN TSX_RESCUE_DATA
# (a directory that already holds panel.conf: nothing is mounted) TSX_RESCUE_WAIT
# (seconds to wait for tsxdata, default 10) TSX_RESCUE_ROOTFS_LABEL (default
# tsxroot, empty: no fallback) TSX_RESCUE_CHPASSWD TSX_RESCUE_URANDOM
# TSX_RESCUE_FINDFS TSX_RESCUE_MOUNT TSX_RESCUE_UMOUNT.
set -u
SHADOW=${TSX_RESCUE_SHADOW:-/etc/shadow}
ROOTHOME=${TSX_RESCUE_ROOT:-/root}
RUN=${TSX_RESCUE_RUN:-/run}
WAIT=${TSX_RESCUE_WAIT:-10}
ROOTFS_LABEL=${TSX_RESCUE_ROOTFS_LABEL-tsxroot}
CHPASSWD=${TSX_RESCUE_CHPASSWD:-chpasswd -c sha512}
URANDOM=${TSX_RESCUE_URANDOM:-/dev/urandom}
FINDFS=${TSX_RESCUE_FINDFS:-findfs}
MOUNT=${TSX_RESCUE_MOUNT:-mount}
UMOUNT=${TSX_RESCUE_UMOUNT:-umount}
umask 077

root_field() { awk -F: '$1 == "root" { print $2 }' "$SHADOW" 2>/dev/null; }
set_root_field() {   # set_root_field VALUE
	tmp=$SHADOW.tmp.$$
	awk -F: -v h="$1" 'BEGIN { OFS = ":" } { if ($1 == "root") $2 = h; print }' "$SHADOW" > "$tmp" \
		&& cat "$tmp" > "$SHADOW"; rc=$?
	rm -f "$tmp"; return $rc
}
# conf_get FILE KEY: the last KEY=value line, without surrounding quotes
conf_get() {
	sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null | tail -n 1 \
		| sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}
case_is() { echo "$1" > "$RUN/tsx-rescue-login"; }

# 3. a test build put a hash into the image
case $(root_field) in
\$*) case_is build; exit 0;;
esac
rm -f "$RUN/tsx-rescue-otp"

# 1. the panel's login from /data and the root key of the normal system
hash= keys= conf_found=
# add_key LINE: one authorized_keys line (with options or not)
add_key() {
	printf '%s\n' "$1" | grep -Eq '^(ssh-|ecdsa-|sk-)|[[:space:]](ssh-|ecdsa-|sk-)' || return 0
	keys="$keys$1
"
}
# read_conf FILE: take the hash and the key of a panel.conf
read_conf() {
	[ -r "$1" ] || return 1
	conf_found=1
	h=$(conf_get "$1" ROOT_PASSWORD_HASH)
	case $h in \$[0-9a-z]*\$*) [ -z "$hash" ] && printf '%s' "$h" | grep -Eq '^\$[0-9A-Za-z$./]{10,}$' && hash=$h;; esac
	k=$(conf_get "$1" SSH_AUTHORIZED_KEY)
	case $k in ssh-*|ecdsa-*|sk-*) add_key "$k";; esac
	return 0
}
# read_keys FILE: the lines of an authorized_keys file
read_keys() {
	[ -r "$1" ] || return 0
	while IFS= read -r l || [ -n "$l" ]; do
		case $l in ''|'#'*) continue;; esac
		add_key "$l"
	done < "$1"
}
# from_fs LABEL WAIT CONFDIR: mount the file system LABEL read only (wait up
# to WAIT seconds for it). Read CONFDIR/panel.conf (only while no panel.conf
# was found) and root/.ssh/authorized_keys on it.
from_fs() {
	dev= n=0
	while :; do
		dev=$($FINDFS "LABEL=$1" 2>/dev/null) && [ -n "$dev" ] && break
		dev=; [ "$n" -ge "$2" ] && break
		n=$((n + 1)); sleep 1
	done
	[ -n "$dev" ] || return 1
	mkdir -p "$RUN/tsx-data"
	# noload: read the file system without a journal replay, so ro works on a dirty one
	$MOUNT -t ext4 -o ro,noload "$dev" "$RUN/tsx-data" 2>/dev/null || return 1
	[ -n "$conf_found" ] || read_conf "$RUN/tsx-data/$3/panel.conf"
	read_keys "$RUN/tsx-data/root/.ssh/authorized_keys"
	$UMOUNT "$RUN/tsx-data" 2>/dev/null
	return 0
}
if [ -n "${TSX_RESCUE_DATA:-}" ]; then
	read_conf "$TSX_RESCUE_DATA/panel.conf"
else
	# tsxdata: panel.conf in tsx/, the moved /root in root/
	from_fs tsxdata "$WAIT" tsx
	# the root file system: /data/tsx/panel.conf of a card with no tsxdata
	# partition, and /root/.ssh/authorized_keys of the normal system
	[ -z "$ROOTFS_LABEL" ] || from_fs "$ROOTFS_LABEL" 0 data/tsx
fi

if [ -n "$hash" ] || [ -n "$keys" ]; then
	if [ -n "$hash" ]; then set_root_field "$hash"; else set_root_field '*'; fi
	if [ -n "$keys" ]; then
		mkdir -p "$ROOTHOME/.ssh"; chmod 700 "$ROOTHOME/.ssh"
		printf '%s' "$keys" | while IFS= read -r k; do
			[ -n "$k" ] || continue
			grep -qxF "$k" "$ROOTHOME/.ssh/authorized_keys" 2>/dev/null || printf '%s\n' "$k" >> "$ROOTHOME/.ssh/authorized_keys"
		done
		chmod 600 "$ROOTHOME/.ssh/authorized_keys"
	fi
	case_is panel
	exit 0
fi

# 2. a one-time password, shown on the panel screen only
otp=$(tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' < "$URANDOM" | head -c 10)
if [ "${#otp}" -lt 10 ] || ! { printf 'root:%s\n' "$otp" | $CHPASSWD >/dev/null 2>&1; }; then
	# no password at all is better than a weak one
	set_root_field '*'; case_is none; exit 1
fi
printf '%s\n' "$otp" > "$RUN/tsx-rescue-otp"; chmod 600 "$RUN/tsx-rescue-otp"
case_is onetime
